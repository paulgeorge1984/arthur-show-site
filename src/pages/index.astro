---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const siteURL = 'https://arthur-show.com';

// サイトのビルドが実行された現在の時刻を取得
const currentBuildTime = new Date(); 

// コレクションから記事を取得し、フィルタリングする
const allMessages = (await getCollection('daily-messages', ({ data }) => {
	// data.date（フロントマターの日時）が currentBuildTime 以下（過去または同時刻）の記事だけを公開
	return data.date <= currentBuildTime;
})).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featuredMessages = allMessages.slice(0, 3);
const archiveMessages = allMessages.slice(3);
const monthFormatter = new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', timeZone: 'Asia/Tokyo' });
const tokyoDateParts = new Intl.DateTimeFormat('en-CA', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: 'Asia/Tokyo',
});
const getTokyoMonthKey = (date: Date) => tokyoDateParts.format(date).slice(0, 7);
const normalizeSearchText = (value = '') => value
	.replace(/<style>{`[\s\S]*?`}<\/style>/g, ' ')
	.replace(/\{\/\*[\s\S]*?\*\/\}/g, ' ')
	.replace(/<[^>]+>/g, ' ')
	.replace(/[{}()[\];"'`<>]/g, ' ')
	.replace(/\s+/g, ' ')
	.trim()
	.toLowerCase();
const cleanInlineText = (value = '') => value
	.replace(/<br\s*\/?>/g, ' ')
	.replace(/<[^>]+>/g, ' ')
	.replace(/&nbsp;/g, ' ')
	.replace(/&amp;/g, '&')
	.replace(/&quot;/g, '"')
	.replace(/&#39;/g, "'")
	.replace(/\s+/g, ' ')
	.trim();
const normalizeScriptureRef = (ref = '') => ref
	.replace(/^イザヤ(?=[\s　0-9０-９])/, 'イザヤ書')
	.replace(/^ヘブル(?=[\s　0-9０-９])/, 'ヘブル人への手紙')
	.replace(/^ヨハネの第一の手紙/, 'ヨハネの手紙 第一')
	.replace(/^ヨハネ(?=[\s　0-9０-９])/, 'ヨハネの福音書')
	.replace(/^ルカ(?=[\s　0-9０-９])/, 'ルカの福音書')
	.replace(/^マタイ(?=[\s　0-9０-９])/, 'マタイの福音書')
	.replace(/^マルコ(?=[\s　0-9０-９])/, 'マルコの福音書')
	.replace(/^ローマ(?=[\s　0-9０-９])/, 'ローマ人への手紙')
	.replace(/^ピリピ(?=[\s　0-9０-９])/, 'ピリピ人への手紙')
	.replace(/^ガラテヤ(?=[\s　0-9０-９])/, 'ガラテヤ人への手紙')
	.replace(/^第一コリント人への手紙|^第一コリント|^第1コリント|^コリント人への手紙第一/, 'コリント人への手紙 第一')
	.replace(/^第二コリント人への手紙|^第二コリント|^第2コリント|^コリント人への手紙第二/, 'コリント人への手紙 第二')
	.replace(/^第一テサロニケ人への手紙|^第一テサロニケ/, 'テサロニケ人への手紙 第一')
	.replace(/\s+/g, ' ')
	.trim();
const getScriptureBook = (ref = '') => ref
	.replace(/[0-9０-９].*$/, '')
	.replace(/[　\s]+$/, '')
	.trim();
const bibleBooks = [
	'創世記', '出エジプト記', 'レビ記', '民数記', '申命記', 'ヨシュア記', '士師記', 'ルツ記',
	'サムエル記 第一', 'サムエル記 第二', '列王記 第一', '列王記 第二', '歴代誌 第一', '歴代誌 第二',
	'エズラ記', 'ネヘミヤ記', 'エステル記', 'ヨブ記', '詩篇', '箴言', '伝道者の書', '雅歌',
	'イザヤ書', 'エレミヤ書', '哀歌', 'エゼキエル書', 'ダニエル書', 'ホセア書', 'ヨエル書', 'アモス書',
	'オバデヤ書', 'ヨナ書', 'ミカ書', 'ナホム書', 'ハバクク書', 'ゼパニヤ書', 'ハガイ書', 'ゼカリヤ書', 'マラキ書',
	'マタイの福音書', 'マルコの福音書', 'ルカの福音書', 'ヨハネの福音書', '使徒の働き',
	'ローマ人への手紙', 'コリント人への手紙 第一', 'コリント人への手紙 第二', 'ガラテヤ人への手紙',
	'エペソ人への手紙', 'ピリピ人への手紙', 'コロサイ人への手紙', 'テサロニケ人への手紙 第一',
	'テサロニケ人への手紙 第二', 'テモテへの手紙 第一', 'テモテへの手紙 第二', 'テトスへの手紙',
	'ピレモンへの手紙', 'ヘブル人への手紙', 'ヤコブの手紙', 'ペテロの手紙 第一', 'ペテロの手紙 第二',
	'ヨハネの手紙 第一', 'ヨハネの手紙 第二', 'ヨハネの手紙 第三', 'ユダの手紙', 'ヨハネの黙示録',
];
const bibleBookOrder = new Map(bibleBooks.map((book, index) => [book, index]));
const months = Array.from(new Set(allMessages.map((post) => getTokyoMonthKey(post.data.date)))).map((key) => {
	const [year, month] = key.split('-').map(Number);
	const date = new Date(year, month - 1, 1);
	return {
		key,
		label: monthFormatter.format(date),
		count: allMessages.filter((post) => getTokyoMonthKey(post.data.date) === key).length,
	};
});
const seenArchiveMonths = new Set<string>();
const archiveRows = archiveMessages.map((post) => {
	const monthKey = getTokyoMonthKey(post.data.date);
	const showMonthAnchor = !seenArchiveMonths.has(monthKey);
	seenArchiveMonths.add(monthKey);
	return {
		post,
		monthKey,
		showMonthAnchor,
		searchText: normalizeSearchText([
			post.data.title,
			post.data.description,
			(post.data.tags || []).join(' '),
			post.body,
		].join(' ')),
	};
});

const formatDate = (date: Date) => date.toLocaleDateString('ja-JP', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: 'Asia/Tokyo',
});
const messageLotteryItems = allMessages.map((post) => ({
	title: post.data.title,
	date: formatDate(post.data.date),
	url: `/messages/${post.slug}`,
	thumb: `https://i.ytimg.com/vi/${post.data.youtubeId}/hq720.jpg`,
	description: post.data.description,
}));
const homeStructuredData = [
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		"@id": `${siteURL}/#collection`,
		url: `${siteURL}/`,
		name: "アーサーホーランド公式動画アーカイブ",
		alternateName: [
			"アーサー・ホーランド公式動画アーカイブ",
			"Arthur Hollands official video archive",
			"THE ARTHUR HOLLANDS SHOW",
		],
		inLanguage: "ja-JP",
		description:
			"アーサーホーランド（アーサー・ホーランド / Arthur Hollands）の公式動画アーカイブ。最新メッセージ、THE DAILY、WALK ACROSS、You are Lovedの言葉をまとめています。",
		about: { "@id": `${siteURL}/#arthur-hollands` },
		isPartOf: { "@id": `${siteURL}/#website` },
	},
	{
		"@context": "https://schema.org",
		"@type": "ItemList",
		name: "アーサーホーランド最新メッセージ",
		itemListElement: featuredMessages.map((post, index) => ({
			"@type": "ListItem",
			position: index + 1,
			url: `${siteURL}/messages/${post.slug}/`,
			name: post.data.title,
		})),
	},
];
const rawScriptureRows = allMessages.flatMap((post) => {
	const rows = Array.from(post.body.matchAll(/<p\s+class=["']verse-text["'][^>]*>([\s\S]*?)<\/p>\s*<span\s+class=["']verse-ref["'][^>]*>([\s\S]*?)<\/span>/g))
		.map((match) => {
			const text = cleanInlineText(match[1]);
			const ref = normalizeScriptureRef(cleanInlineText(match[2]));
			return {
				ref,
				text,
				book: getScriptureBook(ref),
				post,
			};
		})
		.filter((row) => row.ref && row.text);

	if (rows.length) return rows;

	const refs = Array.from(post.body.matchAll(/<span\s+class=["']msg-verse-ref["'][^>]*>([\s\S]*?)<\/span>/g))
		.map((match) => normalizeScriptureRef(cleanInlineText(match[1])))
		.filter(Boolean);
	return Array.from(new Set(refs)).map((ref) => ({
		ref,
		text: post.data.description,
		book: getScriptureBook(ref),
		post,
	}));
});
const scriptureRows = rawScriptureRows.map((row, index) => ({
	...row,
	isRecent: index < 12,
}));
const scriptureBooks = Array.from(new Set(scriptureRows.map((row) => row.book).filter(Boolean)))
	.sort((a, b) => {
		const orderA = bibleBookOrder.get(a) ?? 999;
		const orderB = bibleBookOrder.get(b) ?? 999;
		return orderA === orderB ? a.localeCompare(b, 'ja') : orderA - orderB;
	});
const oldTestamentBooks = scriptureBooks.filter((book) => (bibleBookOrder.get(book) ?? 999) < 39);
const newTestamentBooks = scriptureBooks.filter((book) => (bibleBookOrder.get(book) ?? 999) >= 39);
---

<Layout
	title="アーサーホーランド公式動画アーカイブ"
	description="アーサーホーランド（アーサー・ホーランド / Arthur Hollands）の公式動画アーカイブ。THE ARTHUR HOLLANDS SHOW、THE DAILY、WALK ACROSSの最新メッセージを探せます。"
	image="/walk-across-goto2026/assets/goto-cross-walk-2026-wide.jpg"
	imageAlt="WALK ACROSS GOTO ISLANDS 2026 | THE ARTHUR HOLLANDS SHOW"
	imageWidth={1280}
	imageHeight={720}
	ogType="website"
	structuredData={homeStructuredData}
>
	<div class="container">
		<a class="awaji-feature goto-feature" href="/walk-across-goto2026/" aria-label="ARTHUR HOLLANDS WALK ACROSS GOTO ISLANDS 2026 特設ページを見る">
			<div class="awaji-visual">
				<img src="/walk-across-goto2026/assets/goto-cross-walk-2026-wide.jpg" alt="WALK ACROSS GOTO ISLANDS 2026 五島列島十字架行進の告知ビジュアル" loading="eager" />
			</div>
			<div class="awaji-copy">
				<p class="awaji-kicker">SPECIAL PAGE</p>
				<h2>WALK ACROSS GOTO ISLANDS 2026</h2>
				<p class="awaji-ja">2026年6月、長崎県・五島列島を舞台に十字架を掲げて歩く祈りの旅。</p>
				<p class="awaji-text">現地映像、ドキュメンタリー、行進記録を順次掲載します。</p>
				<span class="awaji-button">特設ページを見る</span>
			</div>
		</a>

		<a class="awaji-feature" href="/walk-across-awaji2026/" aria-label="ARTHUR HOLLANDS WALK ACROSS AWAJI 2026 アーカイブを見る">
			<div class="awaji-visual">
				<img src="/assets/walk-across-awaji2026-poster.webp" alt="WALK ACROSS AWAJI 2026 淡路島一周十字架行進のチラシ" loading="eager" />
			</div>
			<div class="awaji-copy">
				<p class="awaji-kicker">MEMORIAL ARCHIVE</p>
				<h2>WALK ACROSS AWAJI 2026</h2>
				<p class="awaji-ja">アーサーホーランド淡路島一周十字架行進2026</p>
				<p class="awaji-text">祈り、出会い、洗礼、感謝に満ちた5日間の記録。</p>
				<span class="awaji-button">アーカイブを見る</span>
			</div>
		</a>

		<section class="latest-section" id="messages" aria-labelledby="featured-title">
			<div class="section-bar">
				<div>
					<p class="section-kicker">LATEST MESSAGES</p>
					<h1 id="featured-title">最新メッセージ</h1>
				</div>
				<a class="section-link" href="#archive">一覧から探す</a>
			</div>
			<div class="featured-grid">
				{featuredMessages.map((post, index) => (
					<a href={`/messages/${post.slug}`} class:list={['featured-card', { primary: index === 0 }]}>
						<div class="featured-thumb">
							<img
								src={`https://img.youtube.com/vi/${post.data.youtubeId}/maxresdefault.jpg`}
								alt={post.data.title}
								loading={index === 0 ? 'eager' : 'lazy'}
							/>
							<div class="play-icon">▶</div>
						</div>
						<div class="featured-body">
							<div class="card-date">{formatDate(post.data.date)}</div>
							<h3>{post.data.title}</h3>
						</div>
					</a>
				))}
			</div>
		</section>

		<section class="share-section" id="share" aria-labelledby="share-title">
			<h2 id="share-title">このページをシェアする</h2>
			<div class="share-grid" aria-label="SNS共有ボタン">
				<button class="share-card primary-share" type="button" data-share-native>
					<span>スマホで共有</span>
				</button>
				<a class="share-card line" href="https://line.me/R/msg/text/?THE%20ARTHUR%20HOLLANDS%20SHOW%0Ahttps%3A%2F%2Farthur-show.com%2F" data-share-line target="_blank" rel="noreferrer">
					<span>LINE</span>
				</a>
				<a class="share-card x" href="https://twitter.com/intent/tweet?text=THE%20ARTHUR%20HOLLANDS%20SHOW&url=https%3A%2F%2Farthur-show.com%2F" data-share-x target="_blank" rel="noreferrer">
					<span>X</span>
				</a>
				<a class="share-card facebook" href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Farthur-show.com%2F" data-share-facebook target="_blank" rel="noreferrer">
					<span>Facebook</span>
				</a>
				<button class="share-card instagram" type="button" data-copy-link>
					<span>Instagram</span>
				</button>
				<button class="share-card copy" type="button" data-copy-link>
					<span>リンクコピー</span>
					<small data-copy-status>URLをクリップボードへ</small>
				</button>
			</div>
		</section>

		<section class="lottery-section" id="message-jukebox" aria-labelledby="lottery-title">
			<div class="lottery-copy">
				<p class="jukebox-label">特設コーナー</p>
				<h2 id="lottery-title">BIBLE<br />JUKEBOX</h2>
				<p>あの日の言葉が、今のあなたに届く。</p>
				<div class="jukebox-actions" aria-label="BIBLE JUKEBOX 操作">
					<a class="jukebox-action watch-action" href={messageLotteryItems[0]?.url || '#'} data-lottery-watch>WATCH HERE</a>
					<button class="jukebox-action next-action" type="button" data-lottery-button>NEXT EPISODE</button>
					<button class="jukebox-action previous-action" type="button" data-lottery-prev disabled>PREVIOUS EPISODE</button>
				</div>
			</div>
			<a class="lottery-card" href={messageLotteryItems[0]?.url || '#'} data-lottery-card>
				<span class="lottery-thumb">
					<img src={messageLotteryItems[0]?.thumb} alt="" data-lottery-thumb loading="lazy" />
				</span>
				<span class="lottery-body">
					<span class="card-date" data-lottery-date>{messageLotteryItems[0]?.date}</span>
					<strong data-lottery-title>{messageLotteryItems[0]?.title}</strong>
					<small data-lottery-description>{messageLotteryItems[0]?.description}</small>
				</span>
			</a>
		</section>

		<section class="archive-section" id="archive" aria-labelledby="archive-title">
			<div class="section-bar archive-bar">
				<div>
					<p class="section-kicker">ARCHIVE</p>
					<h2 id="archive-title">メッセージ一覧</h2>
				</div>
				<p class="archive-count">{allMessages.length}件</p>
			</div>
			<div class="archive-tools">
				<div class="archive-tools-head">
					<p>SEARCH</p>
					<strong>メッセージを探す</strong>
					<small>キーワード、月別で絞り込めます。</small>
				</div>
				<label class="search-box">
					<span>検索</span>
					<input type="search" placeholder="キーワードで探す" data-message-search />
				</label>
				<div class="month-nav" aria-label="月別ジャンプ">
					<a href="#archive" data-month-filter="all">すべて</a>
					{months.map(month => (
						<a href={`#month-${month.key}`} data-month-filter={month.key}>{month.label}<small>{month.count}</small></a>
					))}
				</div>
			</div>

			<div class="archive-list" data-archive-list>
				{archiveRows.map(({ post, monthKey, showMonthAnchor, searchText }) => {
					return (
						<a
							href={`/messages/${post.slug}`}
							class="archive-item"
							id={showMonthAnchor ? `month-${monthKey}` : undefined}
							data-month={monthKey}
							data-search={searchText}
						>
							<span class="archive-thumb">
								<img
									class="archive-thumb-bg"
									src={`https://i.ytimg.com/vi/${post.data.youtubeId}/hq720.jpg`}
									alt=""
									aria-hidden="true"
									loading="lazy"
								/>
								<img
									class="archive-thumb-main"
									src={`https://i.ytimg.com/vi/${post.data.youtubeId}/hq720.jpg`}
									alt=""
									loading="lazy"
								/>
							</span>
							<div class="archive-item-body">
								<div class="card-date">{formatDate(post.data.date)}</div>
								<h3>{post.data.title}</h3>
							</div>
						</a>
					);
				})}
			</div>
			<p class="no-results" data-no-results hidden>該当するメッセージがありません。</p>
		</section>
	</div>

	<script type="application/json" data-lottery-items set:html={JSON.stringify(messageLotteryItems)}></script>
	<script is:inline>
		const lotteryItems = JSON.parse(document.querySelector('[data-lottery-items]')?.textContent || '[]');
		const shareTitle = 'THE ARTHUR HOLLANDS SHOW';
		const shareText = 'アーサーホーランド公式YouTubeチャンネルのメッセージアーカイブ。';
		const shareUrl = 'https://arthur-show.com/?share=20260602';
		const searchInput = document.querySelector('[data-message-search]');
		const items = Array.from(document.querySelectorAll('[data-archive-list] .archive-item'));
		const monthButtons = Array.from(document.querySelectorAll('[data-month-filter]'));
		const noResults = document.querySelector('[data-no-results]');
		let activeMonth = 'all';
		let currentLotteryIndex = 0;
		const lotteryHistory = [];
		const initialLotteryIndex = lotteryItems.length
			? Math.floor(Math.random() * lotteryItems.length)
			: 0;

		function updateShareLinks() {
			const encodedUrl = encodeURIComponent(shareUrl);
			const encodedText = encodeURIComponent(`${shareTitle}\n${shareText}`);
			const encodedLineText = encodeURIComponent(`${shareTitle}\n${shareText}\n${shareUrl}`);
			const line = document.querySelector('[data-share-line]');
			const x = document.querySelector('[data-share-x]');
			const facebook = document.querySelector('[data-share-facebook]');

			if (line) line.href = `https://line.me/R/msg/text/?${encodedLineText}`;
			if (x) x.href = `https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}`;
			if (facebook) facebook.href = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
		}

		async function copyShareLink() {
			const statusItems = document.querySelectorAll('[data-copy-status]');
			try {
				await navigator.clipboard.writeText(`${shareTitle}\n${shareText}\n${shareUrl}`);
				statusItems.forEach((item) => {
					item.textContent = 'コピーしました';
				});
				setTimeout(() => {
					statusItems.forEach((item) => {
						item.textContent = 'URLをクリップボードへ';
					});
				}, 1800);
			} catch {
				window.prompt('この内容をコピーしてください', `${shareTitle}\n${shareText}\n${shareUrl}`);
			}
		}

		async function sharePage() {
			if (navigator.share) {
				try {
					await navigator.share({
						title: shareTitle,
						text: shareText,
						url: shareUrl,
					});
					return;
				} catch (error) {
					if (error.name === 'AbortError') return;
				}
			}
			await copyShareLink();
		}

		function applyArchiveFilter() {
			const query = (searchInput?.value || '').trim().toLowerCase();
			let visible = 0;
			items.forEach((item) => {
				const monthOk = activeMonth === 'all' || item.dataset.month === activeMonth;
				const searchOk = !query || (item.dataset.search || '').includes(query);
				const show = monthOk && searchOk;
				item.hidden = !show;
				if (show) visible += 1;
			});
			if (noResults) noResults.hidden = visible !== 0;
		}

		function renderLotteryItem(index) {
			const item = lotteryItems[index];
			if (!item) return;
			const card = document.querySelector('[data-lottery-card]');
			const watch = document.querySelector('[data-lottery-watch]');
			const previous = document.querySelector('[data-lottery-prev]');
			const thumb = document.querySelector('[data-lottery-thumb]');
			const date = document.querySelector('[data-lottery-date]');
			const title = document.querySelector('[data-lottery-title]');
			const description = document.querySelector('[data-lottery-description]');

			card?.setAttribute('href', item.url);
			watch?.setAttribute('href', item.url);
			if (thumb) thumb.src = item.thumb;
			if (date) date.textContent = item.date;
			if (title) title.textContent = item.title;
			if (description) description.textContent = item.description || '';
			if (previous) previous.disabled = lotteryHistory.length === 0;
			card?.classList.remove('is-drawn');
			requestAnimationFrame(() => {
				card?.classList.add('is-drawn');
			});
		}

		function drawLottery() {
			if (!lotteryItems.length) return;
			let nextIndex = Math.floor(Math.random() * lotteryItems.length);
			if (lotteryItems.length > 1) {
				while (nextIndex === currentLotteryIndex) {
					nextIndex = Math.floor(Math.random() * lotteryItems.length);
				}
			}
			lotteryHistory.push(currentLotteryIndex);
			currentLotteryIndex = nextIndex;
			renderLotteryItem(currentLotteryIndex);
		}

		function showPreviousLottery() {
			if (!lotteryHistory.length) return;
			currentLotteryIndex = lotteryHistory.pop();
			renderLotteryItem(currentLotteryIndex);
		}

		searchInput?.addEventListener('input', applyArchiveFilter);
		monthButtons.forEach((button) => {
			button.addEventListener('click', (event) => {
				event.preventDefault();
				activeMonth = button.dataset.monthFilter || 'all';
				monthButtons.forEach((b) => b.classList.toggle('active', b === button));
				applyArchiveFilter();
				document.querySelector('#archive')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			});
		});
		monthButtons[0]?.classList.add('active');
		updateShareLinks();
		document.querySelector('[data-lottery-prev]')?.addEventListener('click', showPreviousLottery);
		document.querySelectorAll('[data-share-native]').forEach((button) => {
			button.addEventListener('click', sharePage);
		});
		document.querySelectorAll('[data-copy-link]').forEach((button) => {
			button.addEventListener('click', copyShareLink);
		});
		currentLotteryIndex = initialLotteryIndex;
		renderLotteryItem(currentLotteryIndex);
		document.querySelector('[data-lottery-button]')?.addEventListener('click', drawLottery);
	</script>
</Layout>

