		<script is:inline>
			(() => {
				const campaignEnd = new Date('2026-07-20T00:00:00+09:00').getTime();
				const active = Date.now() < campaignEnd;
				document.documentElement.classList.toggle('gospel-talk-campaign-visible', active);

				function sendGospelTalkCampaignEvent(eventName, placement) {
					if (typeof window.gtag !== 'function') return;
					window.gtag('event', eventName, {
						campaign_name: 'gospel_talk_summer_osaka_2026',
						campaign_placement: placement,
					});
				}

				function initializeGospelTalkCampaign() {
					document.querySelectorAll('[data-gospel-talk-campaign-window]').forEach((element) => {
						element.hidden = !active;
					});
					if (!active) return;

					const viewedPlacements = new Set();
					document.querySelectorAll('[data-gospel-talk-campaign-link]').forEach((link) => {
						const placement = link.dataset.campaignPlacement || 'unknown';
						if (!viewedPlacements.has(placement)) {
							viewedPlacements.add(placement);
							sendGospelTalkCampaignEvent('gospel_talk_campaign_view', placement);
						}
						link.addEventListener('click', () => {
							sendGospelTalkCampaignEvent('gospel_talk_campaign_click', placement);
						});
					});
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initializeGospelTalkCampaign, { once: true });
				} else {
					initializeGospelTalkCampaign();
				}
			})();
		</script>

