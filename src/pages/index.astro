---
import Layout from '../layouts/Layout.astro';
import YoutubeSubscribeBanner from '../components/YoutubeSubscribeBanner.astro';
import { getCollection } from 'astro:content';

const siteURL = 'https://arthur-show.com';
const blessingNightKagurazakaUrl = 'https://www.blessingnight.jp/schedule/schedule366';
const blessingNightKagurazakaBanner = '/assets/generated/blessing-night-kagurazaka-20260717-banner.webp';
const blessingTimeOsakaBanner = '/assets/generated/blessing-time-osaka2026-banner.webp';
const saturdayNightArthurBanner = '/assets/generated/saturday-night-arthur-20260704-banner.webp';

// サイトのビルドが実行された現在の時刻を取得
const currentBuildTime = new Date(); 

// コレクションから記事を取得し、フィルタリングする
const allMessages = (await getCollection('daily-messages', ({ data }) => {
	// data.date（フロントマターの日時）が currentBuildTime 以下（過去または同時刻）の記事だけを公開
	return data.date <= currentBuildTime;
})).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featuredMessages = allMessages.slice(0, 3);
const archiveMessages = allMessages.slice(3);
const monthFormatter = new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', timeZone: 'Asia/Tokyo' });
const tokyoDateParts = new Intl.DateTimeFormat('en-CA', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: 'Asia/Tokyo',
});
const getTokyoMonthKey = (date: Date) => tokyoDateParts.format(date).slice(0, 7);
const normalizeSearchText = (value = '') => value
	.replace(/<style>{`[\s\S]*?`}<\/style>/g, ' ')
	.replace(/\{\/\*[\s\S]*?\*\/\}/g, ' ')
	.replace(/<[^>]+>/g, ' ')
	.replace(/[{}()[\];"'`<>]/g, ' ')
	.replace(/\s+/g, ' ')
	.trim()
	.toLowerCase();
const cleanArchiveDescription = (value = '', fallback = '') => {
	const cleaned = value
		.replace(/THE ARTHUR HOLLANDS SHOW\s*YouTube公式サイトがスタートしました。?/g, ' ')
		.replace(/https:\/\/arthur-show\.com\/messages\/[^\s"']+/g, ' ')
		.replace(/【新企画】\s*📖?\s*3分で復習！\s*👉?THE DAILY ディボーションガイド\s*はこちら/g, ' ')
		.replace(/THE DAILY ディボーションガイド\s*はこちら/g, ' ')
		.replace(/\s+/g, ' ')
		.trim();
	return cleaned || fallback;
};
const cleanInlineText = (value = '') => value
	.replace(/<br\s*\/?>/g, ' ')
	.replace(/<[^>]+>/g, ' ')
	.replace(/&nbsp;/g, ' ')
	.replace(/&amp;/g, '&')
	.replace(/&quot;/g, '"')
	.replace(/&#39;/g, "'")
	.replace(/\s+/g, ' ')
	.trim();
const normalizeScriptureRef = (ref = '') => ref
	.replace(/^イザヤ(?=[\s　0-9０-９])/, 'イザヤ書')
	.replace(/^ヘブル(?=[\s　0-9０-９])/, 'ヘブル人への手紙')
	.replace(/^ヨハネの第一の手紙/, 'ヨハネの手紙 第一')
	.replace(/^ヨハネ(?=[\s　0-9０-９])/, 'ヨハネの福音書')
	.replace(/^ルカ(?=[\s　0-9０-９])/, 'ルカの福音書')
	.replace(/^マタイ(?=[\s　0-9０-９])/, 'マタイの福音書')
	.replace(/^マルコ(?=[\s　0-9０-９])/, 'マルコの福音書')
	.replace(/^ローマ(?=[\s　0-9０-９])/, 'ローマ人への手紙')
	.replace(/^ピリピ(?=[\s　0-9０-９])/, 'ピリピ人への手紙')
	.replace(/^ガラテヤ(?=[\s　0-9０-９])/, 'ガラテヤ人への手紙')
	.replace(/^第一コリント人への手紙|^第一コリント|^第1コリント|^コリント人への手紙第一/, 'コリント人への手紙 第一')
	.replace(/^第二コリント人への手紙|^第二コリント|^第2コリント|^コリント人への手紙第二/, 'コリント人への手紙 第二')
	.replace(/^第一テサロニケ人への手紙|^第一テサロニケ/, 'テサロニケ人への手紙 第一')
	.replace(/\s+/g, ' ')
	.trim();
const getScriptureBook = (ref = '') => ref
	.replace(/[0-9０-９].*$/, '')
	.replace(/[　\s]+$/, '')
	.trim();
const bibleBooks = [
	'創世記', '出エジプト記', 'レビ記', '民数記', '申命記', 'ヨシュア記', '士師記', 'ルツ記',
	'サムエル記 第一', 'サムエル記 第二', '列王記 第一', '列王記 第二', '歴代誌 第一', '歴代誌 第二',
	'エズラ記', 'ネヘミヤ記', 'エステル記', 'ヨブ記', '詩篇', '箴言', '伝道者の書', '雅歌',
	'イザヤ書', 'エレミヤ書', '哀歌', 'エゼキエル書', 'ダニエル書', 'ホセア書', 'ヨエル書', 'アモス書',
	'オバデヤ書', 'ヨナ書', 'ミカ書', 'ナホム書', 'ハバクク書', 'ゼパニヤ書', 'ハガイ書', 'ゼカリヤ書', 'マラキ書',
	'マタイの福音書', 'マルコの福音書', 'ルカの福音書', 'ヨハネの福音書', '使徒の働き',
	'ローマ人への手紙', 'コリント人への手紙 第一', 'コリント人への手紙 第二', 'ガラテヤ人への手紙',
	'エペソ人への手紙', 'ピリピ人への手紙', 'コロサイ人への手紙', 'テサロニケ人への手紙 第一',
	'テサロニケ人への手紙 第二', 'テモテへの手紙 第一', 'テモテへの手紙 第二', 'テトスへの手紙',
	'ピレモンへの手紙', 'ヘブル人への手紙', 'ヤコブの手紙', 'ペテロの手紙 第一', 'ペテロの手紙 第二',
	'ヨハネの手紙 第一', 'ヨハネの手紙 第二', 'ヨハネの手紙 第三', 'ユダの手紙', 'ヨハネの黙示録',
];
const bibleBookOrder = new Map(bibleBooks.map((book, index) => [book, index]));
const months = Array.from(new Set(allMessages.map((post) => getTokyoMonthKey(post.data.date)))).map((key) => {
	const [year, month] = key.split('-').map(Number);
	const date = new Date(year, month - 1, 1);
	return {
		key,
		label: monthFormatter.format(date),
		count: allMessages.filter((post) => getTokyoMonthKey(post.data.date) === key).length,
	};
});
const seenArchiveMonths = new Set<string>();
const archiveRows = archiveMessages.map((post) => {
	const monthKey = getTokyoMonthKey(post.data.date);
	const showMonthAnchor = !seenArchiveMonths.has(monthKey);
	seenArchiveMonths.add(monthKey);
	return {
		post,
		monthKey,
		showMonthAnchor,
		searchText: normalizeSearchText([
			post.data.title,
			cleanArchiveDescription(post.data.description, post.data.title),
			(post.data.tags || []).join(' '),
			post.body,
		].join(' ')),
	};
});

const formatDate = (date: Date) => date.toLocaleDateString('ja-JP', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: 'Asia/Tokyo',
});
const messageLotteryItems = allMessages.map((post) => ({
	title: post.data.title,
	date: formatDate(post.data.date),
	url: `/messages/${post.slug}`,
	thumb: `https://i.ytimg.com/vi/${post.data.youtubeId}/hq720.jpg`,
	description: cleanArchiveDescription(post.data.description, post.data.title),
}));
const homeTitle = 'THE ARTHUR HOLLANDS SHOW';
const homeDescription = 'アーサーホーランド（アーサー・ホーランド / Arthur Hollands）のメッセージ、THE DAILY、WALK ACROSS、イベント情報をまとめた動画アーカイブです。';
const homeFaqItems = [
	{
		question: 'アーサーホーランドとは？',
		answer: 'アーサーホーランド（アーサー・ホーランド / Arthur Hollands）は、聖書、人生、愛、希望を語り、THE ARTHUR HOLLANDS SHOW、THE DAILY with ARTHUR HOLLANDS、WALK ACROSSなどでメッセージを届けているメッセンジャーです。',
	},
	{
		question: 'THE ARTHUR HOLLANDS SHOWでは何が見られますか？',
		answer: 'THE ARTHUR HOLLANDS SHOWの生配信アーカイブ、THE DAILY with ARTHUR HOLLANDSの短い聖書メッセージ、イベント映像、WALK ACROSSの十字架行進記録を探せます。',
	},
	{
		question: 'WALK ACROSS GOTO ISLANDS 2026とは？',
		answer: '2026年6月、長崎県・五島列島を舞台に十字架を掲げて歩く祈りの旅です。現地映像、ドキュメンタリー、行進記録を順次掲載します。',
	},
	{
		question: '最新メッセージはどこで見られますか？',
		answer: 'トップページの最新メッセージ欄とメッセージ一覧から、日付、キーワード、月別でアーサーホーランドの最新動画を探せます。',
	},
];
const homeStructuredData = [
	{
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		"@id": `${siteURL}/#collection`,
		url: `${siteURL}/`,
		name: "THE ARTHUR HOLLANDS SHOW",
		alternateName: [
			"アーサー・ホーランド公式動画アーカイブ",
			"Arthur Hollands official video archive",
			"THE ARTHUR HOLLANDS SHOW",
		],
		inLanguage: "ja-JP",
		description: homeDescription,
		about: { "@id": `${siteURL}/#arthur-hollands` },
		isPartOf: { "@id": `${siteURL}/#website` },
	},
	{
		"@context": "https://schema.org",
		"@type": "ItemList",
		name: "アーサーホーランド最新メッセージ",
		itemListElement: featuredMessages.map((post, index) => ({
			"@type": "ListItem",
			position: index + 1,
			url: `${siteURL}/messages/${post.slug}/`,
			name: post.data.title,
		})),
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"@id": `${siteURL}/#breadcrumb`,
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "THE ARTHUR HOLLANDS SHOW",
				item: `${siteURL}/`,
			},
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"@id": `${siteURL}/#faq`,
		mainEntity: homeFaqItems.map((item) => ({
			"@type": "Question",
			name: item.question,
			acceptedAnswer: {
				"@type": "Answer",
				text: item.answer,
			},
		})),
	},
];
const rawScriptureRows = allMessages.flatMap((post) => {
	const rows = Array.from(post.body.matchAll(/<p\s+class=["']verse-text["'][^>]*>([\s\S]*?)<\/p>\s*<span\s+class=["']verse-ref["'][^>]*>([\s\S]*?)<\/span>/g))
		.map((match) => {
			const text = cleanInlineText(match[1]);
			const ref = normalizeScriptureRef(cleanInlineText(match[2]));
			return {
				ref,
				text,
				book: getScriptureBook(ref),
				post,
			};
		})
		.filter((row) => row.ref && row.text);

	if (rows.length) return rows;

	const refs = Array.from(post.body.matchAll(/<span\s+class=["']msg-verse-ref["'][^>]*>([\s\S]*?)<\/span>/g))
		.map((match) => normalizeScriptureRef(cleanInlineText(match[1])))
		.filter(Boolean);
	return Array.from(new Set(refs)).map((ref) => ({
		ref,
		text: post.data.description,
		book: getScriptureBook(ref),
		post,
	}));
});
const scriptureRows = rawScriptureRows.map((row, index) => ({
	...row,
	isRecent: index < 12,
}));
const scriptureBooks = Array.from(new Set(scriptureRows.map((row) => row.book).filter(Boolean)))
	.sort((a, b) => {
		const orderA = bibleBookOrder.get(a) ?? 999;
		const orderB = bibleBookOrder.get(b) ?? 999;
		return orderA === orderB ? a.localeCompare(b, 'ja') : orderA - orderB;
	});
const oldTestamentBooks = scriptureBooks.filter((book) => (bibleBookOrder.get(book) ?? 999) < 39);
const newTestamentBooks = scriptureBooks.filter((book) => (bibleBookOrder.get(book) ?? 999) >= 39);
---

<Layout
	title={homeTitle}
	description={homeDescription}
	image="/walk-across-goto2026/assets/goto-cross-walk-2026-wide.jpg"
	imageAlt="WALK ACROSS GOTO ISLANDS 2026 | THE ARTHUR HOLLANDS SHOW"
	imageWidth={1280}
	imageHeight={720}
	ogType="website"
	structuredData={homeStructuredData}
>
	<div class="container">
		<details class="home-event-drawer">
			<summary class="home-event-summary">
				<span class="home-event-summary-media" aria-hidden="true">
					<img src={saturdayNightArthurBanner} alt="" width="1600" height="900" loading="eager" />
				</span>
				<span class="home-event-summary-copy">
					<span class="home-event-summary-kicker">EVENT INFO</span>
					<strong>イベント告知</strong>
					<span>Saturday Night Arthur / BLESSING NIGHT 神楽坂 / BLESSING TIME in OSAKA</span>
				</span>
				<span class="home-event-summary-action" aria-hidden="true">
					<span class="closed">見る</span>
					<span class="opened">閉じる</span>
				</span>
			</summary>
			<div class="home-event-panel">
				<a class="blessing-time-feature" href="/saturday-night-arthur-20260704/" aria-label="Saturday Night Arthur 2026年7月4日 特別ページを見る">
					<img
						src={saturdayNightArthurBanner}
						alt=""
						width="1600"
						height="900"
						loading="eager"
						aria-hidden="true"
					/>
					<div class="blessing-time-feature-copy">
						<p class="blessing-time-feature-kicker">SPECIAL EVENT</p>
						<h2>Saturday Night Arthur</h2>
						<p>
							2026年7月4日（土）、小田原市国府津「BLEND PARK」で開かれる
							賛美と御言葉の夕べ。
						</p>
						<div class="blessing-time-feature-meta">
							<span>2026.7.4（SAT）</span>
							<span>17:00 START</span>
							<span>小田原市国府津「BLEND PARK」</span>
						</div>
						<span class="blessing-time-feature-button">告知ページを見る</span>
					</div>
				</a>

				<a class="blessing-time-feature blessing-night-home-feature" href={blessingNightKagurazakaUrl} target="_blank" rel="noopener noreferrer" aria-label="BLESSING NIGHT 神楽坂 2026年7月17日 詳細・申込ページを見る">
					<img
						src={blessingNightKagurazakaBanner}
						alt=""
						width="1600"
						height="900"
						loading="eager"
						aria-hidden="true"
					/>
					<div class="blessing-time-feature-copy">
						<p class="blessing-time-feature-kicker">NEXT BLESSING NIGHT</p>
						<h2>BLESSING NIGHT 神楽坂</h2>
						<p>
							不良牧師が語る聖なる夜のトークライブ。Music Guest は Migiwa。
							詳細と申込は公式ページからご確認ください。
						</p>
						<div class="blessing-time-feature-meta">
							<span>2026年7月17日（金）</span>
							<span>OPEN 18:30 / START 19:00</span>
							<span>u-ma kagurazaka</span>
							<span>Charge 3,000円（飲食代別途）</span>
						</div>
						<span class="blessing-time-feature-button">詳細・申込ページへ</span>
					</div>
				</a>

				<a class="blessing-time-feature" href="/blessing-time-osaka2026/" aria-label="BLESSING TIME in OSAKA 2026年7月18日 特別ページを見る">
					<img
						src={blessingTimeOsakaBanner}
						alt=""
						width="1600"
						height="900"
						loading="eager"
						aria-hidden="true"
					/>
					<div class="blessing-time-feature-copy">
						<p class="blessing-time-feature-kicker">SPECIAL EVENT</p>
						<h2>BLESSING TIME in OSAKA</h2>
						<p>
							アーサー・ホーランド Talk Live と、豪華アーティスト陣による Worship。
							ジーザスの愛と希望に満ちた祝福の時間を、ぜひご一緒ください。
						</p>
						<div class="blessing-time-feature-meta">
							<span>2026年7月18日（土）</span>
							<span>OPEN 14:30 / START 15:00</span>
							<span>大阪クリスチャンセンター OCCホール</span>
						</div>
						<span class="blessing-time-feature-button">特別ページを見る</span>
					</div>
				</a>
			</div>
		</details>

		<YoutubeSubscribeBanner />

		<a class="awaji-feature goto-feature" href="/walk-across-goto2026/" aria-label="ARTHUR HOLLANDS WALK ACROSS GOTO ISLANDS 2026 特設ページを見る">
			<div class="awaji-visual">
				<img src="/walk-across-goto2026/assets/goto-cross-walk-2026-wide.jpg" alt="WALK ACROSS GOTO ISLANDS 2026 五島列島十字架行進の告知ビジュアル" loading="eager" />
			</div>
			<div class="awaji-copy">
				<p class="awaji-kicker">LIVE PROJECT / 6.22 START</p>
				<h2>WALK ACROSS GOTO ISLANDS 2026</h2>
				<p class="awaji-ja">五島列島十字架行進、月曜日から始動。</p>
				<p class="awaji-text">現地から届く映像、行進の記録、祈りの歩みを順次公開していきます。</p>
				<div class="goto-status-row" aria-label="WALK ACROSS GOTO ISLANDS 2026 更新予定">
					<span>現地映像</span>
					<span>行進記録</span>
					<span>ドキュメンタリー</span>
				</div>
				<span class="awaji-button">現地レポートを見る</span>
			</div>
		</a>

		<div id="messages" class="messages-anchor" aria-hidden="true"></div>

		<a class="awaji-feature diviner-feature" href="/diviner/" aria-label="ARTHUR HOLLANDS × DIVINER 特設ページを見る">
			<div class="awaji-visual diviner-visual">
				<img src="/assets/diviner-arthur-202606/rendered/walk-closeup-cross.webp" alt="ARTHUR HOLLANDS × DIVINER" loading="eager" />
			</div>
			<div class="awaji-copy diviner-copy">
				<p class="awaji-kicker">NEW COLLABORATION</p>
				<h2>ARTHUR HOLLANDS × DIVINER</h2>
				<p class="awaji-ja">A new signal is coming.</p>
				<p class="awaji-text">RECKLESS LIFE / YOU ARE LOVED</p>
				<span class="awaji-button">特設ページを見る</span>
			</div>
		</a>

		<section class="latest-section" aria-labelledby="featured-title">
			<div class="section-bar">
				<div>
					<p class="section-kicker">LATEST MESSAGES</p>
					<h2 id="featured-title">最新メッセージ</h2>
				</div>
				<a class="section-link" href="#archive">一覧から探す</a>
			</div>
			<div class="featured-grid">
				{featuredMessages.map((post, index) => (
					<a href={`/messages/${post.slug}`} class:list={['featured-card', { primary: index === 0 }]}>
						<div class="featured-thumb">
							<img
								src={`https://img.youtube.com/vi/${post.data.youtubeId}/maxresdefault.jpg`}
								alt={post.data.title}
								loading={index === 0 ? 'eager' : 'lazy'}
							/>
							<div class="play-icon">▶</div>
						</div>
						<div class="featured-body">
							<div class="card-date">{formatDate(post.data.date)}</div>
							<h3>{post.data.title}</h3>
						</div>
					</a>
				))}
			</div>
		</section>

		<section class="share-section" id="share" aria-labelledby="share-title">
			<h2 id="share-title">このページをシェアする</h2>
			<div class="share-grid" aria-label="SNS共有ボタン">
				<button class="share-card primary-share" type="button" data-share-native>
					<span>スマホで共有</span>
				</button>
				<a class="share-card line" href="https://line.me/R/msg/text/?THE%20ARTHUR%20HOLLANDS%20SHOW%0Ahttps%3A%2F%2Farthur-show.com%2F" data-share-line target="_blank" rel="noreferrer">
					<span>LINE</span>
				</a>
				<a class="share-card x" href="https://twitter.com/intent/tweet?text=THE%20ARTHUR%20HOLLANDS%20SHOW&url=https%3A%2F%2Farthur-show.com%2F" data-share-x target="_blank" rel="noreferrer">
					<span>X</span>
				</a>
				<a class="share-card facebook" href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Farthur-show.com%2F" data-share-facebook target="_blank" rel="noreferrer">
					<span>Facebook</span>
				</a>
				<button class="share-card instagram" type="button" data-copy-link>
					<span>Instagram</span>
				</button>
				<button class="share-card copy" type="button" data-copy-link>
					<span>リンクコピー</span>
					<small data-copy-status>URLをクリップボードへ</small>
				</button>
			</div>
		</section>

		<section class="lottery-section" id="message-jukebox" aria-labelledby="lottery-title">
			<div class="lottery-copy">
				<p class="jukebox-label">特設コーナー</p>
				<h2 id="lottery-title">BIBLE<br />JUKEBOX</h2>
				<p>あの日の言葉が、今のあなたに届く。</p>
				<div class="jukebox-actions" aria-label="BIBLE JUKEBOX 操作">
