---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// サイトのビルドが実行された現在の時刻を取得
const currentBuildTime = new Date(); 

// コレクションから記事を取得し、フィルタリングする
const allMessages = (await getCollection('daily-messages', ({ data }) => {
	// data.date（フロントマターの日時）が currentBuildTime 以下（過去または同時刻）の記事だけを公開
	return data.date <= currentBuildTime;
})).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Latest Messages">
	<div class="container">
		<a class="awaji-feature" href="/walk-across-awaji2026/" aria-label="ARTHUR HOLLANDS WALK ACROSS AWAJI 2026 アーカイブを見る">
			<div class="awaji-visual">
				<img src="/assets/walk-across-awaji2026-poster.webp" alt="WALK ACROSS AWAJI 2026 淡路島一周十字架行進のチラシ" loading="eager" />
			</div>
			<div class="awaji-copy">
				<p class="awaji-kicker">MEMORIAL ARCHIVE</p>
				<h2>WALK ACROSS AWAJI 2026</h2>
				<p class="awaji-ja">アーサーホーランド淡路島一周十字架行進2026</p>
				<p class="awaji-text">祈り、出会い、洗礼、感謝に満ちた5日間の記録。</p>
				<span class="awaji-button">アーカイブを見る</span>
			</div>
		</a>

		<div class="page-intro">
			<h1>LATEST MESSAGES</h1>
			<p>魂を揺さぶる言葉の記録</p>
		</div>

		<div class="card-grid">
			{allMessages.map((post) => (
				<a href={`/messages/${post.slug}`} class="card">
					<div class="card-thumb">
						<img 
							src={`https://img.youtube.com/vi/${post.data.youtubeId}/maxresdefault.jpg`} 
							alt={post.data.title}
						/>
						<div class="play-icon">▶</div>
					</div>
					<div class="card-body">
						<div class="card-date">
							{post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase()}
						</div>
						<h2 class="card-title">{post.data.title}</h2>
						<div class="card-tags">
							{post.data.tags?.map(tag => <span>#{tag}</span>)}
						</div>
					</div>
				</a>
			))}
		</div>
	</div>
</Layout>

<style>
	.container {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 20px;
	}
	
	.page-intro {
		text-align: center;
		padding: 60px 0;
	}
	
	.page-intro h1 {
		font-family: 'Oswald', sans-serif;
		font-size: 2.5rem;
		margin-bottom: 10px;
		color: #000; /* 黒 */
	}
	
	.page-intro p {
		font-family: 'Noto Sans JP', sans-serif;
		color: #666;
		font-weight: 500;
	}

	.awaji-feature {
		position: relative;
		display: grid;
		grid-template-columns: 170px 1fr;
		gap: 24px;
		align-items: center;
		margin: 28px 0 8px;
		padding: 18px;
		overflow: hidden;
		background: #0a0a0a;
		color: #fff;
		border-left: 5px solid #c5a059;
		box-shadow: 0 14px 34px rgba(0, 0, 0, 0.14);
	}

	.awaji-feature::before {
		display: none;
	}

	.awaji-copy {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.awaji-kicker {
		margin-bottom: 6px;
		color: #c5a059;
		font-family: 'Oswald', sans-serif;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.awaji-copy h2 {
		margin-bottom: 8px;
		font-family: 'Oswald', sans-serif;
		font-size: clamp(1.65rem, 4vw, 2.8rem);
		line-height: 1.05;
		letter-spacing: 0;
		color: #fff;
	}

	.awaji-ja {
		margin-bottom: 6px;
		font-size: clamp(0.98rem, 2.2vw, 1.18rem);
		font-weight: 900;
		line-height: 1.5;
	}

	.awaji-text {
		margin-bottom: 16px;
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.92rem;
	}

	.awaji-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: fit-content;
		min-height: 38px;
		padding: 0 14px;
		background: #c5a059;
		color: #000;
		font-weight: 900;
		font-size: 0.9rem;
	}

	.awaji-visual {
		position: relative;
		z-index: 1;
		aspect-ratio: 520 / 629;
		background: #151515;
		overflow: hidden;
	}

	.awaji-visual img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		opacity: 0.94;
		transition: 0.3s;
	}

	.awaji-feature:hover .awaji-visual img {
		transform: scale(1.025);
		opacity: 1;
	}

	.awaji-feature:hover .awaji-button {
		background: #fff;
	}

	.card-grid {
		display: grid;
		gap: 50px;
	}
	
	.card {
		display: block;
	}
	
	.card:hover .play-icon {
		background: #c5a059;
		color: #000;
		border-color: #c5a059;
	}
	
	.card:hover .card-title {
		color: #c5a059; /* ホバー時はゴールド */
	}

	.card-thumb { 
		position: relative;
		width: 100%;
		aspect-ratio: 16/9; 
		background: #000;
		overflow: hidden;
		margin-bottom: 20px;
		border-bottom: 4px solid #000;
	}
	
	.card-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.9;
		transition: 0.3s;
	}
	
	.card:hover img {
		opacity: 1;
		transform: scale(1.02);
	}
	
	.play-icon {
		position: absolute;
		bottom: 20px;
		right: 20px;
		width: 50px;
		height: 50px;
		background: rgba(0,0,0,0.7);
		color: #fff;
		border: 2px solid #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.2rem;
		transition: 0.3s;
	}

	.card-date { 
		font-family: 'Oswald', sans-serif;
		color: #999;
		font-size: 0.9rem;
		letter-spacing: 0.1em;
		margin-bottom: 5px;
	}
	
	/* ★修正箇所：タイトルを強制的に黒く、太く、モダンに */
	.card-title {
		font-family: 'Noto Sans JP', sans-serif; /* ゴシック体 */
		font-size: 1.8rem;
		font-weight: 900; /* 極太 */
		line-height: 1.4;
		margin-bottom: 15px;
		transition: 0.3s;
		color: #000000 !important; /* 強制的に真っ黒 */
	}
	
	.card-tags span {
		font-size: 0.8rem;
		color: #000;
		background: #f4f4f5; 
		padding: 4px 10px;
		margin-right: 5px;
		font-weight: bold;
		display: inline-block;
	}

	@media (max-width: 760px) {
		.awaji-feature {
			grid-template-columns: 1fr;
			min-height: 0;
			gap: 16px;
			margin: 18px 0 4px;
			padding: 14px;
		}

		.awaji-visual {
			min-height: 0;
			aspect-ratio: 520 / 629;
			max-width: 220px;
			width: 100%;
			margin: 0 auto;
		}

		.awaji-visual img {
			height: auto;
			object-fit: contain;
		}
	}
</style>
