---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const currentBuildTime = new Date();
const allMessages = (await getCollection('daily-messages', ({ data }) => {
	return data.date <= currentBuildTime;
})).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (date: Date) => date.toLocaleDateString('ja-JP', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: 'Asia/Tokyo',
});

const jukeboxItems = allMessages.map((post) => ({
	title: post.data.title,
	date: formatDate(post.data.date),
	url: `/messages/${post.slug}`,
	thumb: `https://i.ytimg.com/vi/${post.data.youtubeId}/hq720.jpg`,
	description: post.data.description,
}));
---

<Layout
	title="BIBLE JUKEBOX"
	description="あの日の言葉が、今のあなたに届く。"
	image="/assets/generated/bible-jukebox-og.jpg"
	imageAlt="BIBLE JUKEBOX | THE ARTHUR HOLLANDS SHOW"
>
	<main class="jukebox-page">
		<section class="jukebox-hero" aria-labelledby="jukebox-title">
			<div class="jukebox-banner" aria-hidden="true">
				<img src="/assets/generated/bible-jukebox-banner.webp" alt="" loading="eager" />
			</div>
			<div class="jukebox-copy">
				<p class="jukebox-label">特設コーナー</p>
				<h1 id="jukebox-title">BIBLE JUKEBOX</h1>
				<p class="jukebox-lead">あの日の言葉が、今のあなたに届く。</p>
				<div class="jukebox-actions" aria-label="BIBLE JUKEBOX 操作">
					<a class="jukebox-action watch-action" href={jukeboxItems[0]?.url || '#'} data-jukebox-watch>WATCH HERE</a>
					<button class="jukebox-action next-action" type="button" data-jukebox-button>NEXT EPISODE</button>
					<button class="jukebox-action previous-action" type="button" data-jukebox-prev disabled>PREVIOUS EPISODE</button>
				</div>
			</div>

			<a class="jukebox-record" href={jukeboxItems[0]?.url || '#'} data-jukebox-card>
				<span class="record-art">
					<img src={jukeboxItems[0]?.thumb} alt="" data-jukebox-thumb loading="eager" />
				</span>
				<span class="record-info">
					<span class="record-date" data-jukebox-date>{jukeboxItems[0]?.date}</span>
					<strong data-jukebox-title>{jukeboxItems[0]?.title}</strong>
					<small data-jukebox-description>{jukeboxItems[0]?.description}</small>
					<span class="record-cta">メッセージを開く</span>
				</span>
			</a>
		</section>

		<section class="share-section" id="share" aria-labelledby="share-title">
			<h2 id="share-title">このページをシェアする</h2>
			<div class="share-grid" aria-label="SNS共有ボタン">
				<button class="share-card primary-share" type="button" data-share-native>
					<span>スマホで共有</span>
				</button>
				<a class="share-card line" href="https://line.me/R/msg/text/?BIBLE%20JUKEBOX%0Ahttps%3A%2F%2Farthur-show.com%2Fmessage-jukebox%2F" data-share-line target="_blank" rel="noreferrer">
					<span>LINE</span>
				</a>
				<a class="share-card x" href="https://twitter.com/intent/tweet?text=BIBLE%20JUKEBOX&url=https%3A%2F%2Farthur-show.com%2Fmessage-jukebox%2F" data-share-x target="_blank" rel="noreferrer">
					<span>X</span>
				</a>
				<a class="share-card facebook" href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Farthur-show.com%2Fmessage-jukebox%2F" data-share-facebook target="_blank" rel="noreferrer">
					<span>Facebook</span>
				</a>
				<button class="share-card instagram" type="button" data-copy-link>
					<span>Instagram</span>
				</button>
				<button class="share-card copy" type="button" data-copy-link>
					<span>リンクコピー</span>
					<small data-copy-status>URLをクリップボードへ</small>
				</button>
			</div>
		</section>
	</main>

	<script type="application/json" data-jukebox-items set:html={JSON.stringify(jukeboxItems)}></script>
	<script is:inline>
		const jukeboxItems = JSON.parse(document.querySelector('[data-jukebox-items]')?.textContent || '[]');
		const shareTitle = 'BIBLE JUKEBOX';
		const shareText = 'あの日の言葉が、今のあなたに届く。';
		const shareUrl = 'https://arthur-show.com/message-jukebox/?share=20260602';
		let currentJukeboxIndex = 0;
		const jukeboxHistory = [];
		const initialJukeboxIndex = jukeboxItems.length
			? Math.floor(Math.random() * jukeboxItems.length)
			: 0;

		function updateShareLinks() {
			const encodedUrl = encodeURIComponent(shareUrl);
			const encodedText = encodeURIComponent(`${shareTitle}\n${shareText}`);
			const encodedLineText = encodeURIComponent(`${shareTitle}\n${shareText}\n${shareUrl}`);
			const line = document.querySelector('[data-share-line]');
			const x = document.querySelector('[data-share-x]');
			const facebook = document.querySelector('[data-share-facebook]');

			if (line) line.href = `https://line.me/R/msg/text/?${encodedLineText}`;
			if (x) x.href = `https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}`;
			if (facebook) facebook.href = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
		}

		async function copyShareLink() {
			const statusItems = document.querySelectorAll('[data-copy-status]');
			try {
				await navigator.clipboard.writeText(`${shareTitle}\n${shareText}\n${shareUrl}`);
				statusItems.forEach((item) => {
					item.textContent = 'コピーしました';
				});
				setTimeout(() => {
					statusItems.forEach((item) => {
						item.textContent = 'URLをクリップボードへ';
					});
				}, 1800);
			} catch {
				window.prompt('この内容をコピーしてください', `${shareTitle}\n${shareText}\n${shareUrl}`);
			}
		}

		async function sharePage() {
			if (navigator.share) {
				try {
					await navigator.share({
						title: shareTitle,
						text: shareText,
						url: shareUrl,
					});
					return;
				} catch (error) {
					if (error.name === 'AbortError') return;
				}
			}
			await copyShareLink();
		}

		function renderJukeboxMessage(index) {
			const item = jukeboxItems[index];
			if (!item) return;
			const card = document.querySelector('[data-jukebox-card]');
			const watch = document.querySelector('[data-jukebox-watch]');
			const previous = document.querySelector('[data-jukebox-prev]');
			const thumb = document.querySelector('[data-jukebox-thumb]');
			const date = document.querySelector('[data-jukebox-date]');
			const title = document.querySelector('[data-jukebox-title]');
			const description = document.querySelector('[data-jukebox-description]');

			if (card) card.href = item.url;
			if (watch) watch.href = item.url;
			if (thumb) thumb.src = item.thumb;
			if (date) date.textContent = item.date;
			if (title) title.textContent = item.title;
			if (description) description.textContent = item.description || '';
			if (previous) previous.disabled = jukeboxHistory.length === 0;

			card?.classList.remove('is-drawn');
			requestAnimationFrame(() => {
				card?.classList.add('is-drawn');
			});
		}

		function drawJukeboxMessage() {
			if (!jukeboxItems.length) return;
			let nextIndex = Math.floor(Math.random() * jukeboxItems.length);
			if (jukeboxItems.length > 1) {
				while (nextIndex === currentJukeboxIndex) {
					nextIndex = Math.floor(Math.random() * jukeboxItems.length);
				}
			}
			jukeboxHistory.push(currentJukeboxIndex);
			currentJukeboxIndex = nextIndex;
			renderJukeboxMessage(currentJukeboxIndex);
		}

		function showPreviousJukeboxMessage() {
			if (!jukeboxHistory.length) return;
			currentJukeboxIndex = jukeboxHistory.pop();
			renderJukeboxMessage(currentJukeboxIndex);
		}

		updateShareLinks();
		document.querySelectorAll('[data-share-native]').forEach((button) => {
			button.addEventListener('click', sharePage);
		});
		document.querySelectorAll('[data-copy-link]').forEach((button) => {
			button.addEventListener('click', copyShareLink);
		});
		currentJukeboxIndex = initialJukeboxIndex;
		renderJukeboxMessage(currentJukeboxIndex);
		document.querySelector('[data-jukebox-prev]')?.addEventListener('click', showPreviousJukeboxMessage);
		document.querySelector('[data-jukebox-button]')?.addEventListener('click', drawJukeboxMessage);
	</script>
</Layout>

<style>
	.jukebox-page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 28px 20px 0;
	}

	.jukebox-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(410px, 1fr) minmax(0, 1fr);
		gap: 28px;
		min-height: calc(100vh - 210px);
		align-items: center;
		padding: 34px;
		overflow: hidden;
		background:
			linear-gradient(90deg, rgba(197, 160, 89, 0.24) 0 2px, transparent 2px 13px),
			linear-gradient(135deg, #070707 0%, #1a0f0b 48%, #050505 100%);
		color: #fff;
		border: 1px solid rgba(197, 160, 89, 0.5);
		box-shadow: inset 0 0 0 3px rgba(255, 255, 255, 0.05), 0 22px 44px rgba(0, 0, 0, 0.18);
	}

	.jukebox-hero::before {
		content: "";
		position: absolute;
		inset: 14px;
		pointer-events: none;
		border: 1px solid rgba(255, 255, 255, 0.18);
	}

	.jukebox-hero::after {
		content: "";
		position: absolute;
		top: 24px;
		bottom: 24px;
		left: 24px;
		width: 10px;
		background: #b62424;
		box-shadow: 18px 0 0 #c5a059, 36px 0 0 rgba(255, 255, 255, 0.9);
		pointer-events: none;
	}

	.jukebox-banner {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
	}

	.jukebox-banner img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0.52;
		filter: saturate(1.08) contrast(1.08);
	}

	.jukebox-banner::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0.68) 44%, rgba(0, 0, 0, 0.35) 100%),
			linear-gradient(180deg, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.72));
	}

	.jukebox-copy,
	.jukebox-record {
		position: relative;
		z-index: 1;
	}

	.jukebox-copy {
		padding-left: 58px;
	}

	.jukebox-label {
		width: fit-content;
		margin-bottom: 12px;
		padding: 5px 10px;
		background: #fff;
		color: #111;
		font-size: 0.8rem;
		font-weight: 900;
	}

	.jukebox-copy h1 {
		margin-bottom: 14px;
		color: #f4d06f;
		font-family: 'Oswald', sans-serif;
		font-size: clamp(2.8rem, 4.1vw, 3.45rem);
		font-weight: 900;
		line-height: 0.95;
		white-space: nowrap;
	}

	.jukebox-lead {
		max-width: 28em;
		margin-bottom: 24px;
		color: rgba(255, 255, 255, 0.9);
		font-size: 1.08rem;
		font-weight: 900;
		line-height: 1.8;
	}

	.jukebox-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		align-items: center;
	}

	.jukebox-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 54px;
		max-width: 100%;
		padding: 0 28px;
		border: 3px solid rgba(255, 255, 255, 0.82);
		font-family: 'Oswald', sans-serif;
		font-size: 1.08rem;
		font-weight: 900;
		letter-spacing: 0.1em;
		line-height: 1;
		cursor: pointer;
	}

	.watch-action {
		background: linear-gradient(180deg, #ffffff 0%, #f2f2f2 64%, #bdbdbd 100%);
		color: #000;
		box-shadow: 0 0 0 3px #111, 6px 6px 0 #c5a059, inset 0 2px 0 rgba(255, 255, 255, 0.8);
	}

	.next-action {
		background: linear-gradient(180deg, #fff5c9 0%, #c5a059 62%, #8a6728 100%);
		color: #000;
		box-shadow: 0 0 0 3px #111, 6px 6px 0 #6d1616, inset 0 2px 0 rgba(255, 255, 255, 0.7);
	}

	.previous-action {
		min-height: 42px;
		padding: 0 16px;
		background: linear-gradient(180deg, #4b4b4b 0%, #202020 100%);
		color: #fff;
		border-color: rgba(255, 255, 255, 0.5);
		font-size: 0.82rem;
		box-shadow: 0 0 0 2px #111, 5px 5px 0 rgba(197, 160, 89, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.25);
	}

	.previous-action:disabled,
	.previous-action:disabled:hover {
		opacity: 0.42;
		cursor: default;
		transform: none;
	}

	.jukebox-action:hover {
		transform: translateY(1px);
	}

	.watch-action:hover {
		background: linear-gradient(180deg, #ffffff 0%, #dcdcdc 70%, #a6a6a6 100%);
	}

	.next-action:hover {
		background: linear-gradient(180deg, #fff 0%, #e0bd67 70%, #9b742f 100%);
	}

	.jukebox-record {
		display: grid;
		grid-template-rows: auto 1fr;
		min-width: 0;
		overflow: hidden;
		background: #111;
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.18);
		box-shadow: 10px 10px 0 rgba(197, 160, 89, 0.3);
	}

	.jukebox-record.is-drawn {
		animation: record-pop 0.28s ease-out;
	}

	.record-art {
		display: block;
		aspect-ratio: 16 / 9;
		background: #000;
		overflow: hidden;
		border: 10px solid #050505;
	}

	.record-art img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.record-info {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 20px;
		border-top: 4px solid #c5a059;
	}

	.record-date {
		margin-bottom: 8px;
		color: #c5a059;
		font-family: 'Oswald', sans-serif;
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.record-info strong {
		display: -webkit-box;
		overflow: hidden;
		font-size: 1.35rem;
		font-weight: 900;
		line-height: 1.45;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.record-info small {
		display: -webkit-box;
		margin-top: 10px;
		overflow: hidden;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.88rem;
		font-weight: 700;
		line-height: 1.65;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.record-cta {
		width: fit-content;
		margin-top: 16px;
		padding-bottom: 3px;
		color: #fff;
		border-bottom: 2px solid #c5a059;
		font-size: 0.88rem;
		font-weight: 900;
	}

	.share-section {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		margin-top: 20px;
		padding: 12px 0;
		border-top: 1px solid #e4e4e7;
		border-bottom: 1px solid #e4e4e7;
	}

	.share-section h2 {
		flex: 0 0 auto;
		color: #666;
		font-size: 0.86rem;
		font-weight: 900;
	}

	.share-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 8px;
	}

	.share-card {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 34px;
		padding: 0 11px;
		color: #111;
		text-align: center;
		text-decoration: none;
		cursor: pointer;
		background: #f4f4f5;
		border: 1px solid #e4e4e7;
		font: inherit;
	}

	.share-card span {
		display: block;
		font-size: 0.78rem;
		font-weight: 900;
		line-height: 1;
	}

	.share-card small {
		display: none;
	}

	.share-card:hover {
		transform: translateY(-1px);
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
	}

	.primary-share {
		color: #fff;
		background: #000;
	}

	.line {
		border-bottom: 3px solid #06c755;
	}

	.x {
		border-bottom: 3px solid #111;
	}

	.facebook {
		border-bottom: 3px solid #1877f2;
	}

	.instagram {
		border-bottom: 3px solid #e4405f;
	}

	.copy {
		border-bottom: 3px solid #c5a059;
	}

	@keyframes record-pop {
		from {
			opacity: 0.55;
			transform: translateY(8px) scale(0.985);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@media (max-width: 820px) {
		.jukebox-page {
			padding: 18px 14px 0;
		}

		.jukebox-hero {
			grid-template-columns: 1fr;
			min-height: 0;
			padding: 22px;
		}

		.jukebox-hero::after {
			top: 18px;
			bottom: auto;
			left: 18px;
			width: 8px;
			height: 62px;
			box-shadow: 14px 0 0 #c5a059, 28px 0 0 rgba(255, 255, 255, 0.9);
		}

		.jukebox-copy {
			padding: 78px 0 0;
		}

		.jukebox-copy h1 {
			font-size: clamp(2.2rem, 9vw, 2.65rem);
		}

		.share-section {
			align-items: flex-start;
			flex-direction: column;
		}

		.share-grid {
			justify-content: flex-start;
		}
	}
</style>
