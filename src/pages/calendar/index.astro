			{
				id: 'manual-gospel-talk-summer-osaka-2026-07-19',
				summary: 'Gospel Talk in the Summer －神の言葉を語る－',
				description: [
					'11:00am',
					'J. Disciple Church Osaka・大阪弟子教会',
					'入場無料（席上献金があります）',
					'https://arthur-show.com/gospel-talk-summer-osaka20260719/',
				].join('\n'),
				location: 'J. Disciple Church Osaka・大阪弟子教会 〒542-0078 大阪市中央区高津1-3-6 JDCビル',
				start: {
