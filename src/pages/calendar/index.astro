	<script is:inline>
		const CALENDAR_ID = 'arthur.hollands.hp@gmail.com';
		const CALENDAR_API_KEY = 'AIzaSyDOtGM5jr8bNp1utVpG2_gSRH03RNGBkI8';
		const CALENDAR_SHARE_URL = 'https://arthur-show.com/calendar/';
		const CALENDAR_SHARE_TITLE = 'アーサーホーランド関連スケジュール | THE ARTHUR HOLLANDS SHOW';
		const TOKYO_TIME_ZONE = 'Asia/Tokyo';
