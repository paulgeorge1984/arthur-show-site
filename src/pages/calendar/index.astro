			{
				id: 'manual-the-essence-akita-2026-11-14',
				summary: 'THE ESSENCE',
				description: [
					'きれいごとでは終われない、人生の本質を問う夜',
					'OPEN 18:30 / 19:00〜21:00',
					'秋田キャッスルホテル 弥生の間',
					'入場無料（席上献金あり）',
					'https://arthur-show.com/the-essence-akita-20261114/',
				].join('\n'),
				location: '秋田キャッスルホテル 弥生の間 〒010-0001 秋田県秋田市中通1丁目3番5号',
				start: {
					dateTime: '2026-11-14T19:00:00+09:00',
					timeZone: TOKYO_TIME_ZONE,
				},
				end: {
					dateTime: '2026-11-14T21:00:00+09:00',
					timeZone: TOKYO_TIME_ZONE,
				},
			},
		];

		const monthContainer = document.querySelector('[data-calendar-months]');
		const miniCalendarContainer = document.querySelector('[data-mini-calendars]');
		const fallbackNode = document.querySelector('[data-calendar-fallback]');
		const shareNativeButtons = document.querySelectorAll('[data-calendar-share-native]');
		const shareCopyButtons = document.querySelectorAll('[data-calendar-copy-link]');
		const shareCopyStatusNodes = document.querySelectorAll('[data-calendar-copy-status]');

		const tokyoPartsFormatter = new Intl.DateTimeFormat('en-CA', {
			year: 'numeric',
			month: '2-digit',
			day: '2-digit',
			timeZone: TOKYO_TIME_ZONE,
		});
		const monthFormatter = new Intl.DateTimeFormat('ja-JP', {
			year: 'numeric',
			month: 'long',
			timeZone: TOKYO_TIME_ZONE,
		});
		const dayFormatter = new Intl.DateTimeFormat('ja-JP', {
			month: 'numeric',
			day: 'numeric',
			weekday: 'short',
			timeZone: TOKYO_TIME_ZONE,
		});
		const dayNumberFormatter = new Intl.DateTimeFormat('ja-JP', {
			day: '2-digit',
			timeZone: TOKYO_TIME_ZONE,
		});
		const weekdayFormatter = new Intl.DateTimeFormat('ja-JP', {
			weekday: 'short',
			timeZone: TOKYO_TIME_ZONE,
		});
		const timeFormatter = new Intl.DateTimeFormat('ja-JP', {
			hour: '2-digit',
			minute: '2-digit',
			timeZone: TOKYO_TIME_ZONE,
		});
		function getTokyoParts(date = new Date()) {
			const [year, month, day] = tokyoPartsFormatter.format(date).split('-').map(Number);
			return { year, month, day };
		}

		function addMonths(year, month, offset) {
			const base = new Date(Date.UTC(year, month - 1 + offset, 1));
			return {
				year: base.getUTCFullYear(),
				month: base.getUTCMonth() + 1,
			};
		}

		function pad2(value) {
			return String(value).padStart(2, '0');
		}

		function monthKey(year, month) {
			return `${year}-${pad2(month)}`;
		}

		function tokyoDateFromDateOnly(value) {
			return new Date(`${value}T00:00:00+09:00`);
		}

		function buildRange() {
			const now = getTokyoParts();
			const current = { year: now.year, month: now.month, key: monthKey(now.year, now.month) };
			const nextParts = addMonths(now.year, now.month, 1);
			const next = { ...nextParts, key: monthKey(nextParts.year, nextParts.month) };
			const followingParts = addMonths(now.year, now.month, 2);
			const following = { ...followingParts, key: monthKey(followingParts.year, followingParts.month) };
			const afterFollowing = addMonths(now.year, now.month, 3);
			return {
				current,
				next,
				following,
				months: [current, next, following],
				timeMin: `${current.key}-01T00:00:00+09:00`,
				timeMax: `${monthKey(afterFollowing.year, afterFollowing.month)}-01T00:00:00+09:00`,
				todayStart: tokyoDateFromDateOnly(`${now.year}-${pad2(now.month)}-${pad2(now.day)}`),
			};
		}

		function escapeHtml(value = '') {
			return String(value)
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#39;');
		}

		function textFromHtml(value = '') {
			const doc = new DOMParser().parseFromString(String(value), 'text/html');
			return (doc.body.textContent || '').replace(/\u00a0/g, ' ').trim();
		}

		function formatMultilineText(value = '') {
			const cleanText = textFromHtml(value);
			if (!cleanText) return '';
			return cleanText
				.split(/\n+/)
				.map((line) => escapeHtml(line.trim()))
				.filter(Boolean)
				.map((line) => line.replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>'))
				.join('<br />');
		}

		function getEventStart(event) {
			if (event.start?.dateTime) return new Date(event.start.dateTime);
			return tokyoDateFromDateOnly(event.start?.date);
		}

		function getEventEnd(event) {
			if (event.end?.dateTime) return new Date(event.end.dateTime);
			if (event.end?.date) return tokyoDateFromDateOnly(event.end.date);
			return getEventStart(event);
		}

		function getEventMonthKey(event) {
			if (event.start?.date) return event.start.date.slice(0, 7);
			const parts = getTokyoParts(getEventStart(event));
			return monthKey(parts.year, parts.month);
		}

		function getDateKeyFromDate(date) {
			const parts = getTokyoParts(date);
			return `${parts.year}-${pad2(parts.month)}-${pad2(parts.day)}`;
		}

		function getWeekdayIndexFromDateKey(key) {
			const [year, month, day] = key.split('-').map(Number);
			return new Date(Date.UTC(year, month - 1, day)).getUTCDay();
		}

		function addDaysToDateKey(key, offset) {
			return getDateKeyFromDate(new Date(tokyoDateFromDateOnly(key).getTime() + (offset * DAY_MS)));
		}

		function getEventVisibleDateKeys(event) {
			const startKey = event.start?.date || getDateKeyFromDate(getEventStart(event));
			let endKey = startKey;

			if (event.start?.date && event.end?.date) {
				endKey = getDateKeyFromDate(new Date(tokyoDateFromDateOnly(event.end.date).getTime() - DAY_MS));
			} else if (event.end?.dateTime) {
				endKey = getDateKeyFromDate(getEventEnd(event));
			}

			const keys = [];
			let currentKey = startKey;
			for (let guard = 0; guard < 62; guard += 1) {
				keys.push(currentKey);
				if (currentKey === endKey) break;
				currentKey = addDaysToDateKey(currentKey, 1);
			}
			return keys;
		}

		function groupEventsByDate(events) {
			const grouped = new Map();
			events.forEach((event) => {
				getEventVisibleDateKeys(event).forEach((key) => {
					if (!grouped.has(key)) grouped.set(key, []);
					grouped.get(key).push(event);
				});
			});
			return grouped;
		}

		function formatDateRange(event) {
			const start = getEventStart(event);
			if (event.start?.date && event.end?.date) {
				const visibleEnd = new Date(tokyoDateFromDateOnly(event.end.date).getTime() - DAY_MS);
				if (dayFormatter.format(start) === dayFormatter.format(visibleEnd)) return dayFormatter.format(start);
				return `${dayFormatter.format(start)} - ${dayFormatter.format(visibleEnd)}`;
			}
			const end = getEventEnd(event);
			if (dayFormatter.format(start) === dayFormatter.format(end)) return dayFormatter.format(start);
			return `${dayFormatter.format(start)} - ${dayFormatter.format(end)}`;
		}

		function formatTimeRange(event) {
			if (!event.start?.dateTime) return '';
			const start = getEventStart(event);
			const end = getEventEnd(event);
			if (Number.isNaN(end.valueOf())) return timeFormatter.format(start);
			if (start.getTime() === end.getTime()) return timeFormatter.format(start);
			return `${timeFormatter.format(start)} - ${timeFormatter.format(end)}`;
		}

		function monthLabelForKey(key) {
			return monthFormatter.format(tokyoDateFromDateOnly(`${key}-01`));
		}

		function normalizeEventSummary(value = '') {
			return String(value).replace(/ブレッシングナイ(?=[＠@\s（(]|$)/g, 'ブレッシングナイト');
		}

		function resolveRelatedEventLinks(event) {
			const searchableText = normalizeEventSummary([
				event.summary || '',
				textFromHtml(event.description || ''),
				textFromHtml(event.location || ''),
			].join(' '));

			return RELATED_EVENT_LINKS.filter(({ pattern }) => pattern.test(searchableText));
		}

		function renderRelatedEventLinks(event) {
			const links = resolveRelatedEventLinks(event);
			if (!links.length) return '';

			return `
				<div class="event-related-links" aria-label="関連公式リンク">
					${links.map((link) => `
						<a href="${link.url}" target="_blank" rel="noopener noreferrer">${escapeHtml(link.label)}</a>
					`).join('')}
				</div>
			`;
		}

		function isEventInRange(event, range) {
			const start = getEventStart(event).getTime();
			return start >= new Date(range.timeMin).getTime() && start < new Date(range.timeMax).getTime();
		}

		function isBlessingTimeOsakaEvent(event) {
			const startKey = event.start?.date || getDateKeyFromDate(getEventStart(event));
			const searchableText = `${event.summary || ''} ${event.description || ''} ${event.location || ''}`;
			return startKey === '2026-07-18' && /blessing\s*time/i.test(searchableText) && /(osaka|大阪)/i.test(searchableText);
		}

		function isBlessingNightKagurazakaEvent(event) {
			const startKey = event.start?.date || getDateKeyFromDate(getEventStart(event));
			const searchableText = `${event.summary || ''} ${event.description || ''} ${event.location || ''}`;
			return startKey === '2026-07-17'
				&& /(?:blessing\s*night|ブレッシングナイト|ブレッシングナイ)/i.test(searchableText);
		}

		function isSaturdayNightArthurEvent(event) {
			const startKey = event.start?.date || getDateKeyFromDate(getEventStart(event));
			const searchableText = `${event.summary || ''} ${event.description || ''} ${event.location || ''}`;
			return startKey === '2026-07-04'
				&& /saturday\s*night\s*arthur|賛美と御言葉の夕べ/i.test(searchableText);
		}

		function isTheEssenceAkitaEvent(event) {
			const startKey = event.start?.date || getDateKeyFromDate(getEventStart(event));
			const searchableText = `${event.summary || ''} ${event.description || ''} ${event.location || ''}`;
			return startKey === '2026-11-14'
				&& /the\s*essence|人生の本質|秋田キャッスル/i.test(searchableText);
		}

		function isGospelTalkSummerEvent(event) {
			const startKey = event.start?.date || getDateKeyFromDate(getEventStart(event));
			const searchableText = `${event.summary || ''} ${event.description || ''} ${event.location || ''}`;
			return startKey === '2026-07-19'
				&& /gospel\s*talk|神の言葉を語る|大阪弟子教会|j\.\s*disciple/i.test(searchableText);
		}

		function mergeManualEvents(events, range) {
			const manualEventsInRange = MANUAL_EVENTS.filter((event) => isEventInRange(event, range));
			if (!manualEventsInRange.length) return events;
			const hasSaturdayNightArthur = events.some((event) => isSaturdayNightArthurEvent(event));
			const hasBlessingTimeOsaka = events.some((event) => isBlessingTimeOsakaEvent(event));
			const hasTheEssenceAkita = events.some((event) => isTheEssenceAkitaEvent(event));
			const hasGospelTalkSummer = events.some((event) => isGospelTalkSummerEvent(event));
			const gospelTalkManualEvent = manualEventsInRange.find((event) => event.id === 'manual-gospel-talk-summer-osaka-2026-07-19');
			let mergedEvents = events;
			if (gospelTalkManualEvent && hasGospelTalkSummer) {
				mergedEvents = mergedEvents.map((event) => {
					if (!isGospelTalkSummerEvent(event)) return event;
					return {
						...event,
						summary: gospelTalkManualEvent.summary,
						description: gospelTalkManualEvent.description,
						location: gospelTalkManualEvent.location,
						start: gospelTalkManualEvent.start,
						end: gospelTalkManualEvent.end,
					};
				});
			}
			return [
				...mergedEvents,
				...manualEventsInRange.filter((event) => {
					if (isSaturdayNightArthurEvent(event)) return !hasSaturdayNightArthur;
					if (isBlessingTimeOsakaEvent(event)) return !hasBlessingTimeOsaka;
					if (isTheEssenceAkitaEvent(event)) return !hasTheEssenceAkita;
					if (isGospelTalkSummerEvent(event)) return !hasGospelTalkSummer;
					return true;
				}),
			];
		}

		function renderEventCard(event, todayStart) {
			const start = getEventStart(event);
			const end = getEventEnd(event);
			const isPast = end.getTime() <= todayStart.getTime();
			const description = formatMultilineText(event.description || '');
			const location = textFromHtml(event.location || '');
			const dayNumber = dayNumberFormatter.format(start);
			const weekday = weekdayFormatter.format(start);
			const startKey = event.start?.date || getDateKeyFromDate(start);
			const weekdayIndex = getWeekdayIndexFromDateKey(startKey);
			const weekdayClass = weekdayIndex === 0 ? ' is-sunday' : weekdayIndex === 6 ? ' is-saturday' : '';
			const timeRange = formatTimeRange(event);
			const summary = normalizeEventSummary(event.summary || '名称未定');
			const relatedLinks = renderRelatedEventLinks(event);

			return `
				<article class="event-card${isPast ? ' is-past' : ''}">
					<div class="event-date${weekdayClass}" aria-label="${escapeHtml(formatDateRange(event))}">
						<span>${escapeHtml(dayNumber)}</span>
						<small>${escapeHtml(weekday)}</small>
					</div>
					<div class="event-body">
							<div class="event-meta">
								<span>${escapeHtml(formatDateRange(event))}</span>
								${timeRange ? `<span>${escapeHtml(timeRange)}</span>` : ''}
								${isPast ? '<em>終了</em>' : ''}
							</div>
								<h3>${escapeHtml(summary)}</h3>
								${description ? `<p class="event-description">${description}</p>` : ''}
								${location ? `<p class="event-location">${escapeHtml(location)}</p>` : ''}
								${relatedLinks}
							</div>
						</article>
					`;
		}

		function renderMiniCalendar(month, eventsByDate, monthEvents, todayKey) {
			const daysInMonth = new Date(Date.UTC(month.year, month.month, 0)).getUTCDate();
			const firstWeekday = new Date(Date.UTC(month.year, month.month - 1, 1)).getUTCDay();
			const weekdayLabels = ['日', '月', '火', '水', '木', '金', '土'];
			const blanks = Array.from({ length: firstWeekday }, () => '<span class="mini-calendar-day is-empty" aria-hidden="true"></span>');
			const dayCells = Array.from({ length: daysInMonth }, (_, index) => {
				const day = index + 1;
				const key = `${month.key}-${pad2(day)}`;
				const weekdayIndex = getWeekdayIndexFromDateKey(key);
				const events = eventsByDate.get(key) || [];
				const eventTitles = events.map((event) => normalizeEventSummary(event.summary || '名称未定'));
				const classNames = [
					'mini-calendar-day',
					weekdayIndex === 0 ? 'is-sunday' : '',
					weekdayIndex === 6 ? 'is-saturday' : '',
					events.length ? 'has-events' : '',
					key === todayKey ? 'is-today' : '',
				].filter(Boolean).join(' ');
				const preview = events.length
					? `<span class="mini-calendar-events" aria-hidden="true"><em>${events.length}</em></span>`
					: '';
				const ariaLabel = events.length
					? `${month.month}月${day}日 ${weekdayLabels[weekdayIndex]}曜日、予定${events.length}件: ${eventTitles.join('、')}`
					: `${month.month}月${day}日 ${weekdayLabels[weekdayIndex]}曜日`;

				return `
					<a class="${classNames}" href="#month-${month.key}-events" aria-label="${escapeHtml(ariaLabel)}">
						<span class="mini-calendar-number">${day}</span>
						${preview}
					</a>
				`;
			});
			const weekdays = weekdayLabels.map((label, index) => {
				const className = index === 0 ? 'is-sunday' : index === 6 ? 'is-saturday' : '';
				return `<span class="${className}">${label}</span>`;
			}).join('');
			const monthEventPreview = monthEvents.length
				? `
					<ul class="mini-month-events">
						${monthEvents.map((event) => `
							<li>
								<a href="#month-${month.key}-events">
									<time>${escapeHtml(formatDateRange(event))}</time>
									<span>${escapeHtml(normalizeEventSummary(event.summary || '名称未定'))}</span>
								</a>
							</li>
						`).join('')}
					</ul>
				`
				: '<p class="mini-month-empty">この月の予定は現在登録されていません。</p>';

			return `
				<section class="mini-calendar-card" aria-label="${escapeHtml(monthLabelForKey(month.key))} ミニカレンダー">
					<div class="mini-calendar-title">
						<p class="calendar-label">${month.key}</p>
						<h3>${escapeHtml(monthLabelForKey(month.key))}</h3>
					</div>
					<div class="mini-calendar-weekdays" aria-hidden="true">${weekdays}</div>
					<div class="mini-calendar-grid">
						${blanks.join('')}
						${dayCells.join('')}
					</div>
					${monthEventPreview}
				</section>
			`;
		}

		function renderMonth(month, events, todayStart) {
			const eventMarkup = events.length
				? events.map((event) => renderEventCard(event, todayStart)).join('')
				: '<p class="empty-month">この月の予定は現在登録されていません。</p>';

			return `
				<section class="month-block" id="month-${month.key}-events" data-month="${month.key}">
					<div class="month-title">
						<div>
							<p class="calendar-label">${month.key}</p>
							<h3>${escapeHtml(monthLabelForKey(month.key))}</h3>
						</div>
						<strong>${events.length} EVENTS</strong>
					</div>
					<div class="event-list">
						${eventMarkup}
					</div>
				</section>
			`;
		}

		async function fetchCalendarEvents(range) {
			const allItems = [];
			let pageToken = '';
			do {
				const params = new URLSearchParams({
					key: CALENDAR_API_KEY,
					singleEvents: 'true',
					orderBy: 'startTime',
					timeZone: TOKYO_TIME_ZONE,
					maxAttendees: '1',
					maxResults: '250',
					showDeleted: 'false',
					timeMin: range.timeMin,
					timeMax: range.timeMax,
				});
				if (pageToken) params.set('pageToken', pageToken);
				const response = await fetch(`https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(CALENDAR_ID)}/events?${params.toString()}`);
				if (!response.ok) throw new Error(`Google Calendar API error: ${response.status}`);
				const data = await response.json();
				allItems.push(...(data.items || []));
				pageToken = data.nextPageToken || '';
				if (!pageToken) return { items: allItems, updated: data.updated };
			} while (pageToken);
			return { items: allItems, updated: '' };
		}

		function calendarShareMessage() {
			return `${CALENDAR_SHARE_TITLE}\n${CALENDAR_SHARE_URL}`;
		}

		function setCopyStatus(label) {
			shareCopyStatusNodes.forEach((node) => {
				node.textContent = label;
			});
		}

		function fallbackCopyText(text) {
			const textarea = document.createElement('textarea');
			textarea.value = text;
			textarea.setAttribute('readonly', '');
			textarea.style.position = 'fixed';
			textarea.style.top = '-1000px';
			textarea.style.left = '-1000px';
			textarea.style.opacity = '0';
			document.body.appendChild(textarea);
			textarea.focus({ preventScroll: true });
			textarea.select();
			textarea.setSelectionRange(0, text.length);
			let copied = false;
			try {
				copied = document.execCommand('copy');
			} catch {
				copied = false;
			}
			textarea.remove();
			return copied;
		}

		async function copyCalendarShareLink() {
			const message = calendarShareMessage();
			try {
				if (navigator.clipboard?.writeText) {
					await navigator.clipboard.writeText(message);
				} else if (!fallbackCopyText(message)) {
					throw new Error('copy unavailable');
				}
				setCopyStatus('コピーしました');
				setTimeout(() => setCopyStatus('URLをコピー'), 1800);
			} catch {
				if (fallbackCopyText(message)) {
					setCopyStatus('コピーしました');
					setTimeout(() => setCopyStatus('URLをコピー'), 1800);
					return;
				}
				setCopyStatus('コピーできませんでした');
				setTimeout(() => setCopyStatus('URLをコピー'), 1800);
			}
		}

		async function shareCalendarPage() {
			if (navigator.share) {
				try {
					await navigator.share({
						title: CALENDAR_SHARE_TITLE,
						url: CALENDAR_SHARE_URL,
					});
					return;
				} catch (error) {
					if (error.name === 'AbortError') return;
				}
			}
			await copyCalendarShareLink();
		}

		async function initCalendar() {
			const range = buildRange();

			try {
				const { items, updated } = await fetchCalendarEvents(range);
				const activeEvents = mergeManualEvents(
					items.filter((event) => event.status !== 'cancelled' && !isBlessingNightKagurazakaEvent(event)),
					range
				)
					.sort((a, b) => getEventStart(a).getTime() - getEventStart(b).getTime());
				const grouped = new Map(range.months.map((month) => [month.key, []]));
				activeEvents.forEach((event) => {
					const key = getEventMonthKey(event);
					if (grouped.has(key)) grouped.get(key).push(event);
				});
				const eventsByDate = groupEventsByDate(activeEvents);
				const todayKey = getDateKeyFromDate(range.todayStart);

					if (miniCalendarContainer) {
						miniCalendarContainer.innerHTML = range.months
							.map((month) => renderMiniCalendar(month, eventsByDate, grouped.get(month.key) || [], todayKey))
							.join('');
					}
				if (monthContainer) {
					monthContainer.innerHTML = range.months
						.map((month) => renderMonth(month, grouped.get(month.key) || [], range.todayStart))
						.join('');
				}
			} catch (error) {
				console.error(error);
				if (fallbackNode) fallbackNode.hidden = false;
			}
		}

		initCalendar();
		shareNativeButtons.forEach((button) => {
			button.addEventListener('click', shareCalendarPage);
		});
		shareCopyButtons.forEach((button) => {
			button.addEventListener('click', copyCalendarShareLink);
		});
	</script>
</Layout>

