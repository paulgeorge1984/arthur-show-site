import SiteFooter from '../../components/SiteFooter.astro';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no" />
    <title>ARTHUR HOLLANDS WALK ACROSS GOTO ISLANDS 2026 | 五島列島十字架行進2026</title>
    <meta
      name="description"
      content="ARTHUR HOLLANDS WALK ACROSS GOTO ISLANDS 2026。2026年6月、長崎県五島列島を舞台に行われる十字架行進の特設ページ。スケジュール、現地映像、ドキュメンタリー映像を順次掲載します。"
    />
    <meta name="keywords" content="Arthur Hollands, アーサーホーランド, WALK ACROSS GOTO ISLANDS 2026, 五島列島十字架行進2026, 五島列島, 十字架行進, 長崎, キリシタン史" />
    <link rel="canonical" href="https://arthur-show.com/walk-across-goto2026/" />
    <meta property="og:title" content="ARTHUR HOLLANDS WALK ACROSS GOTO ISLANDS 2026 | 五島列島十字架行進2026" />
    <meta property="og:description" content="2026年6月、十字架を掲げて五島列島を歩く祈りの旅。現地映像、ドキュメンタリー映像、行進記録を順次掲載します。" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content="https://arthur-show.com/walk-across-goto2026/" />
    <meta property="og:site_name" content="THE ARTHUR HOLLANDS SHOW" />
    <meta property="og:image" content="https://arthur-show.com/walk-across-goto2026/assets/goto-cross-walk-2026.jpg" />
    <meta property="og:image:secure_url" content="https://arthur-show.com/walk-across-goto2026/assets/goto-cross-walk-2026.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1055" />
    <meta property="og:image:height" content="1491" />
    <meta property="og:image:alt" content="Arthur Hollands 五島列島十字架行進2026 告知ビジュアル" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="ARTHUR HOLLANDS WALK ACROSS GOTO ISLANDS 2026 | 五島列島十字架行進2026" />
    <meta name="twitter:description" content="2026年6月、十字架を掲げて五島列島を歩く祈りの旅。現地映像とドキュメンタリー映像を順次掲載します。" />
    <meta name="twitter:image" content="https://arthur-show.com/walk-across-goto2026/assets/goto-cross-walk-2026.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700;900&family=Oswald:wght@400;700&family=Shippori+Mincho:wght@500;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="./styles.css?v=20260601-goto-page" />
  </head>
  <body>
    <header class="site-header" id="top">
      <div class="header-inner">
        <a href="/" class="archive-logo" aria-label="THE ARTHUR HOLLANDS SHOW トップページへ戻る">
          <span class="logo-main">THE ARTHUR HOLLANDS SHOW</span>
          <span class="logo-sub">You are Loved</span>
        </a>
      </div>
    </header>
    <div class="global-nav-shell" data-global-nav-shell>
      <nav class="global-quick-nav" aria-label="サイト内主要メニューショートカット">
        <a href="/#messages">Arthur Hollands' Message</a>
        <a href="/arthur-hollands-show/">THE ARTHUR HOLLANDS SHOW</a>
        <a href="/friday-night/">FRIDAY NIGHT</a>
        <a href="/walk-across/">WALK ACROSS</a>
        <a href="/walk-across-awaji2026/">WALK ACROSS AWAJI 2026</a>
        <a href="/walk-across-goto2026/" class="active">GOTO ISLANDS 2026</a>
        <a href="/message-jukebox/">BIBLE JUKEBOX</a>
        <a href="/swords-of-words/">THE SWORDS OF WORDS</a>
        <a href="/1000-verses/">厳選 1000 VERSES</a>
      </nav>
      <button class="global-menu-toggle" type="button" aria-expanded="false" aria-controls="global-section-nav" data-global-menu-toggle>
        <span class="menu-lines" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <strong>SITE MENU</strong>
      </button>
      <nav class="global-section-nav" id="global-section-nav" aria-label="サイト内主要メニュー" data-global-section-nav>
        <a href="/#messages">Arthur Hollands' Message</a>
        <a href="/arthur-hollands-show/">THE ARTHUR HOLLANDS SHOW</a>
        <a href="/friday-night/">FRIDAY NIGHT</a>
        <a href="/walk-across/">WALK ACROSS</a>
        <a href="/walk-across-awaji2026/">WALK ACROSS AWAJI 2026</a>
        <a href="/walk-across-goto2026/" class="active">GOTO ISLANDS 2026</a>
        <a href="/message-jukebox/">BIBLE JUKEBOX</a>
        <a href="/swords-of-words/">THE SWORDS OF WORDS</a>
        <a href="/1000-verses/">厳選 1000 VERSES</a>
      </nav>
    </div>
    <nav class="walk-local-nav" aria-label="ページ内ナビゲーション">
      <a href="#about">概要</a>
      <a href="#schedule">スケジュール</a>
      <a href="#field-videos">現地映像</a>
      <a href="#documentary">ドキュメンタリー</a>
      <a href="#updates">更新予定</a>
      <a href="#share">シェア</a>
    </nav>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-media">
          <button type="button" data-full="./assets/goto-cross-walk-2026.jpg" aria-label="五島列島十字架行進2026 告知ビジュアルを拡大表示">
            <img src="./assets/goto-cross-walk-2026.jpg" alt="Arthur Hollands 五島列島十字架行進2026 告知ビジュアル" />
          </button>
        </div>
        <div class="hero-copy">
          <p class="eyebrow">ARTHUR HOLLANDS</p>
          <h1 id="hero-title">
            <span>WALK ACROSS GOTO ISLANDS 2026</span>
            <strong>五島列島十字架行進 2026</strong>
          </h1>
          <p>
            2026年6月、長崎県・五島列島を舞台に十字架行進が始まります。
            海を渡り、島から島へ。祈りを込めて十字架を掲げ、五島の道を歩いていきます。
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#schedule">行進スケジュールを見る</a>
            <a class="button secondary" href="#field-videos">今後の映像掲載予定</a>
          </div>
          <div class="quick-share" aria-label="シェア">
            <button class="share-native" type="button" data-share-native>このページをシェア</button>
            <button type="button" data-copy-link>リンクをコピー</button>
          </div>
        </div>
      </section>

      <section class="section intro" id="about" aria-labelledby="about-title">
        <div class="section-heading">
          <p class="eyebrow">ABOUT THE WALK</p>
          <h2 id="about-title">信仰の足跡をたどり、十字架を掲げて歩く。</h2>
          <p>
            福江島、久賀島、奈留島、若松島、そして上五島へ。
            それぞれの島に刻まれた歴史を覚えながら、祈りとともに一歩一歩進んでいく旅です。
          </p>
        </div>
        <div class="intro-grid">
          <article>
            <span>01</span>
            <h3>島から島へ</h3>
            <p>海を渡り、島々の道を歩きながら、祈りを込めて十字架を掲げます。</p>
          </article>
          <article>
            <span>02</span>
            <h3>キリシタン史を覚えて</h3>
            <p>五島列島は、日本のキリシタン史において重要な舞台の一つです。</p>
          </article>
          <article>
            <span>03</span>
            <h3>記録を更新していくページ</h3>
            <p>現地から届く映像、写真、ドキュメンタリーの情報をこのページに追加していきます。</p>
          </article>
        </div>
      </section>

      <section class="section history-band" aria-labelledby="history-title">
        <p class="eyebrow">HISTORY AND PRAYER</p>
        <h2 id="history-title">祈りを受け継いだ島々へ。</h2>
        <p>
          かつて多くのキリシタンが、信仰を守るために長崎本土から五島へ移り住み、
          厳しい時代の中で祈りを受け継いできました。今回の行進では、その信仰の足跡をたどりながら、
          十字架を掲げて歩いていきます。
        </p>
      </section>

      <section class="section schedule-section" id="schedule" aria-labelledby="schedule-title">
        <div class="section-heading">
          <p class="eyebrow">SCHEDULE</p>
          <h2 id="schedule-title">行進スケジュール</h2>
          <p>行進は朝7:00スタートを基本に、各島の地形や移動状況に合わせて進めていく予定です。</p>
        </div>
        <div class="schedule-grid">
          <article><time>6月21日(日) 夜</time><strong>福江島にて集会予定</strong></article>
          <article><time>6月22日(月)</time><strong>福江島</strong></article>
          <article><time>6月23日(火)</time><strong>福江島</strong></article>
          <article><time>6月24日(水)</time><strong>久賀島</strong></article>
          <article><time>6月25日(木)</time><strong>奈留島</strong></article>
          <article><time>6月26日(金)</time><strong>若松島</strong></article>
          <article><time>6月27日(土)</time><strong>上五島</strong></article>
        </div>
        <div class="contact-panel">
          <p>当日の詳しいコースについては、事前にサポートスタッフの後藤までお問い合わせください。</p>
          <span>後藤：080-3927-1165</span>
        </div>
      </section>

      <section class="section media-section" id="field-videos" aria-labelledby="field-videos-title">
        <div class="section-heading">
          <p class="eyebrow">FIELD VIDEO UPDATES</p>
          <h2 id="field-videos-title">現地からの映像</h2>
          <p>行進中に届くショート映像、現地レポート、祈りの記録をここに追加していきます。</p>
        </div>
        <div class="video-grid" data-video-grid></div>
      </section>

      <section class="section documentary-section" id="documentary" aria-labelledby="documentary-title">
        <div class="documentary-panel">
          <p class="eyebrow">DOCUMENTARY ARCHIVE</p>
          <h2 id="documentary-title">ドキュメンタリー映像の公開場所</h2>
          <p>
            五島列島十字架行進の歩みをまとめたドキュメンタリー映像、ダイジェスト、後日公開される特別映像を、
            公開後このセクションに掲載します。
          </p>
          <div class="documentary-list" data-documentary-grid></div>
        </div>
      </section>

      <section class="section updates" id="updates" aria-labelledby="updates-title">
        <div class="section-heading">
          <p class="eyebrow">UPDATES</p>
          <h2 id="updates-title">このページで更新していく内容</h2>
        </div>
        <div class="update-grid">
          <article>
            <h3>出発地点・集合情報</h3>
            <p>各日の詳しいコースや集合場所が決まり次第、追記します。</p>
          </article>
          <article>
            <h3>現地写真・映像</h3>
            <p>島々を歩く様子、祈り、出会い、集会の記録を掲載します。</p>
          </article>
          <article>
            <h3>ドキュメンタリー</h3>
            <p>行進後に公開される映像作品や紹介ページへのリンクをまとめます。</p>
          </article>
        </div>
      </section>

      <section class="section share-section" id="share" aria-labelledby="share-title">
        <div class="section-heading">
          <p class="eyebrow">SHARE</p>
          <h2 id="share-title">五島列島十字架行進をシェアする</h2>
          <p>祈りの旅を、必要としている人へ届けられるように。</p>
        </div>
        <div class="share-grid" aria-label="SNS共有ボタン">
          <button class="share-card primary-share" type="button" data-share-native>
            <span>スマホで共有</span>
            <small>標準の共有メニューを開く</small>
          </button>
          <a class="share-card line" href="https://line.me/R/msg/text/?https%3A%2F%2Farthur-show.com%2Fwalk-across-goto2026%2F" data-share-line target="_blank" rel="noreferrer">
            <span>LINE</span>
            <small>友だち・グループへ送る</small>
          </a>
          <a class="share-card x" href="https://twitter.com/intent/tweet?url=https%3A%2F%2Farthur-show.com%2Fwalk-across-goto2026%2F" data-share-x target="_blank" rel="noreferrer">
            <span>X</span>
            <small>投稿で紹介する</small>
          </a>
          <a class="share-card facebook" href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Farthur-show.com%2Fwalk-across-goto2026%2F" data-share-facebook target="_blank" rel="noreferrer">
            <span>Facebook</span>
            <small>タイムラインで共有する</small>
          </a>
          <button class="share-card instagram" type="button" data-copy-link>
            <span>Instagram</span>
            <small>投稿・ストーリーズ用にURLをコピー</small>
          </button>
          <button class="share-card copy" type="button" data-copy-link>
            <span>リンクコピー</span>
            <small data-copy-status>URLをクリップボードへ</small>
          </button>
        </div>
      </section>
    </main>

    <SiteFooter />

    <div class="lightbox" hidden>
      <button class="lightbox-close" type="button" aria-label="閉じる">×</button>
      <img alt="" />
    </div>

    <script is:inline src="/walk-across-goto2026/script.js"></script>
  </body>
</html>
