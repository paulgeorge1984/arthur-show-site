---
import Layout from '../../layouts/Layout.astro';
import Article, { frontmatter } from '../../content/daily-messages/2026-10-20.mdx';
const previewPath = '/messages/preview-kitamoto-morning-e852bce95097/';
---
<Layout title={frontmatter.title} description={frontmatter.description} image={frontmatter.heroImage} imageWidth={1600} imageHeight={750} noindex={true} canonicalPath={previewPath}>
  <div class="message-preview">
    <aside class="preview-note" aria-label="公開前プレビュー">
      <strong>公開前プレビュー · 2026年10月20日 6:30（日本時間）公開</strong>
      <p>2026年10月20日 6:30（日本時間）のプレミア公開に合わせて記事を公開します。</p>
    </aside>
    {frontmatter.youtubeId && <div class="preview-video"><iframe src={`https://www.youtube.com/embed/${frontmatter.youtubeId}`} title={frontmatter.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>}
    <Article />
    <p id="share-status" aria-live="polite"></p>
  </div>
</Layout>
<script>
const title = document.querySelector('.msg-title')?.textContent?.trim() || document.title;
const url = window.location.origin + window.location.pathname;
const text = `${title}\nTHE ARTHUR HOLLANDS SHOW`;
const combined = `${text}\n${url}`;
const links = {
  twitter: `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
  line: `https://line.me/R/msg/text/?${encodeURIComponent(combined)}`,
};
document.querySelectorAll<HTMLButtonElement>('.share-button').forEach((button) => {
  button.addEventListener('click', async () => {
    if (button.classList.contains('copy')) {
      try {
        await navigator.clipboard.writeText(combined);
        const status = document.getElementById('share-status');
        if (status) status.textContent = 'リンクをコピーしました。';
      } catch { window.prompt('このURLをコピーしてください', combined); }
      return;
    }
    const key = Object.keys(links).find((name) => button.classList.contains(name)) as keyof typeof links | undefined;
    if (key) window.open(links[key], '_blank', 'noopener,noreferrer');
  });
});
</script>
<style>
.message-preview { max-width: 960px; margin: 0 auto; padding: 32px 24px 80px; }
.preview-video { aspect-ratio: 16 / 9; margin: 28px 0; }
.preview-video iframe { width: 100%; height: 100%; border: 0; }
.preview-note { border: 1px solid #c5a059; border-radius: 8px; padding: 18px 22px; background: #fffcf5; color: #29251f; }
.preview-note strong { font-size: .95rem; }
.preview-note p { margin: 8px 0 0; font-size: .9rem; line-height: 1.8; }
#share-status { text-align: center; min-height: 1.5em; font-size: .9rem; }
@media(max-width: 600px) { .message-preview { padding: 20px 16px 56px; } }
</style>
