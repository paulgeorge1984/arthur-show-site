---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlessingNightNotice from '../../components/BlessingNightNotice.astro';
import { slideNotesByDeckId } from '../../data/slideNotes';

const siteURL = 'https://arthur-show.com';

export async function getStaticPaths() {
  const blogEntries = await getCollection('daily-messages');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const slideDeckIds = Array.from(new Set(
	[...entry.body.matchAll(/docs\.google\.com\/presentation\/d\/([^/"?#]+)/g)]
		.map((match) => match[1])
));
const hasInlineSlideNotes = /<SlideNotes\b|data-slide-notes-fallback/.test(entry.body);
const slideTranslationNotes = slideDeckIds
	.map((deckId) => ({
		deckId,
		paragraphs: (slideNotesByDeckId[deckId] || '')
			.split(/\n{2,}/)
			.map((paragraph) => paragraph.trim())
			.filter(Boolean),
	}));
const messageShareTitle = entry.data.title;
const messageShareText = 'アーサーホーランド公式YouTubeチャンネル THE ARTHUR HOLLANDS SHOW';
const messageShareUrl = `https://arthur-show.com/messages/${entry.slug}/?share=20260602`;
const messageImage = entry.data.heroImage || `https://i.ytimg.com/vi/${entry.data.youtubeId}/hq720.jpg`;
const canonicalPath = `/messages/${entry.slug}/`;
const messageDescription = `${entry.data.description} アーサーホーランド（アーサー・ホーランド / Arthur Hollands）公式動画アーカイブより。`;
const showBlessingNotice = ['2026-06-09', '2026-06-12'].includes(entry.slug);
const messageStructuredData = [
	{
		"@context": "https://schema.org",
		"@type": "VideoObject",
		"@id": `${siteURL}${canonicalPath}#video`,
		name: entry.data.title,
		description: messageDescription,
		thumbnailUrl: [messageImage],
		uploadDate: entry.data.date.toISOString(),
		embedUrl: `https://www.youtube.com/embed/${entry.data.youtubeId}`,
		contentUrl: `https://www.youtube.com/watch?v=${entry.data.youtubeId}`,
		inLanguage: "ja-JP",
		isPartOf: { "@id": `${siteURL}/#website` },
		about: { "@id": `${siteURL}/#arthur-hollands` },
		publisher: { "@id": `${siteURL}/#arthur-hollands` },
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "アーサーホーランド公式動画アーカイブ",
				item: `${siteURL}/`,
			},
			{
				"@type": "ListItem",
				position: 2,
				name: entry.data.title,
				item: `${siteURL}${canonicalPath}`,
			},
		],
	},
];
---

<Layout
	title={entry.data.title}
	description={messageDescription}
	image={messageImage}
	imageAlt={`${entry.data.title} サムネイル`}
	imageWidth={1280}
	imageHeight={720}
	ogType="article"
	canonicalPath={canonicalPath}
	structuredData={messageStructuredData}
>
	
	<div id="video-anchor" class="video-anchor">
		<div id="floating-player" class="player-container">
			<div class="video-inner">
				<iframe 
					src={`https://www.youtube.com/embed/${entry.data.youtubeId}?rel=0`} 
					title="YouTube video player" 
					frameborder="0" 
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
					allowfullscreen>
				</iframe>
			</div>
			<button id="close-pip" class="pip-close-btn" aria-label="Close PiP">×</button>
		</div>
	</div>

	<article class="content-area">
		<Content />
		{slideTranslationNotes.length > 0 && !hasInlineSlideNotes && (
			<section class="slide-notes-fallback" data-slide-notes-fallback hidden>
				<div class="slide-notes-header">
					<div>
						<p class="slide-notes-kicker">GOOGLE SLIDES TEXT</p>
						<h2>スライド翻訳コーナー</h2>
					</div>
					<button type="button" class="slide-notes-toggle" aria-expanded="true" data-slide-notes-toggle>×</button>
				</div>
				<div class="slide-notes-content" data-slide-notes-content>
					{slideTranslationNotes.map((note) => (
						note.paragraphs.length > 0 ? (
							<details class="slide-notes-card" open data-slide-notes-deck={note.deckId}>
								<summary>このGoogleスライドの本文</summary>
								<div class="slide-notes-copy">
									{note.paragraphs.map((paragraph) => (
										<p>{paragraph}</p>
									))}
								</div>
							</details>
						) : (
							<div class="slide-notes-card slide-notes-link-card" data-slide-notes-deck={note.deckId}>
								<a
									class="slide-translate-button slide-translate-button-secondary"
									href={`https://docs.google.com/presentation/d/${note.deckId}/export/txt`}
									target="_blank"
									rel="noopener noreferrer"
									data-slide-notes-text-link
									data-slide-deck-id={note.deckId}
								>
									スライド本文を翻訳で開く
								</a>
							</div>
						)
					))}
				</div>
			</section>
		)}
		{showBlessingNotice && <BlessingNightNotice variant="article" />}
	</article>

</Layout>

<script define:vars={{ messageShareTitle, messageShareText, messageShareUrl }}>
	const anchor = document.getElementById('video-anchor');
	const player = document.getElementById('floating-player');
	const closeBtn = document.getElementById('close-pip');

	if (anchor && player && closeBtn) {
		const observer = new IntersectionObserver((entries) => {
			if (window.innerWidth <= 768) return; // スマホは除外

			entries.forEach(entry => {
				// 上にスクロールアウトしたらPiPオン
				if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
					player.classList.add('is-pip');
				} else {
					// 見えてる時は通常モード
					player.classList.remove('is-pip');
					player.classList.remove('pip-hidden');
				}
			});
		}, {
			rootMargin: '-100px 0px 0px 0px',
			threshold: 0
		});

		observer.observe(anchor);

		closeBtn.addEventListener('click', () => {
			player.classList.add('pip-hidden');
		});
	}

	function updateMessageShareButtons() {
		const shareButtons = document.querySelectorAll('.share-button');
		const encodedUrl = encodeURIComponent(messageShareUrl);
		const shareText = [messageShareTitle, messageShareText].filter(Boolean).join('\n');
		const shareTextWithUrl = [messageShareTitle, messageShareText, messageShareUrl].filter(Boolean).join('\n');
		const encodedText = encodeURIComponent(shareText);
		const encodedLineText = encodeURIComponent(shareTextWithUrl);

		shareButtons.forEach((button) => {
			button.removeAttribute('onclick');

			if (button.classList.contains('twitter')) {
				button.addEventListener('click', () => {
					window.open(`https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}`, '_blank', 'noopener,noreferrer');
				});
				return;
			}

			if (button.classList.contains('facebook')) {
				button.addEventListener('click', () => {
					window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`, '_blank', 'noopener,noreferrer');
				});
				return;
			}

			if (button.classList.contains('line')) {
				button.addEventListener('click', () => {
					window.open(`https://line.me/R/msg/text/?${encodedLineText}`, '_blank', 'noopener,noreferrer');
				});
				return;
			}

			if (button.classList.contains('copy')) {
				button.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(shareTextWithUrl);
						const originalLabel = button.getAttribute('aria-label') || 'リンクをコピー';
						button.setAttribute('aria-label', 'コピーしました');
						setTimeout(() => {
							button.setAttribute('aria-label', originalLabel);
						}, 1800);
					} catch {
						window.prompt('このURLをコピーしてください', shareTextWithUrl);
					}
				});
			}
		});
	}

	updateMessageShareButtons();

	function suppressGoogleTranslateChrome() {
		if (!window.location.hostname.endsWith('.translate.goog')) return;

		document.documentElement.style.setProperty('margin-top', '0', 'important');
		document.documentElement.style.setProperty('overflow-x', 'hidden', 'important');
		document.body?.style.setProperty('margin-top', '0', 'important');
		document.body?.style.setProperty('top', '0', 'important');
		document.body?.style.setProperty('overflow-x', 'hidden', 'important');
		document
			.querySelectorAll('iframe#gt-nvframe, iframe.goog-te-banner-frame, iframe.skiptranslate, body > .skiptranslate, #goog-gt-tt, .goog-te-balloon-frame, .VIpgJd-ZVi9od-ORHb-OEVmcd')
			.forEach((item) => {
				item.style.setProperty('display', 'none', 'important');
				item.style.setProperty('visibility', 'hidden', 'important');
				item.style.setProperty('width', '0', 'important');
				item.style.setProperty('height', '0', 'important');
				item.style.setProperty('opacity', '0', 'important');
				item.style.setProperty('pointer-events', 'none', 'important');
			});
		if (window.scrollX) window.scrollTo(0, window.scrollY);
	}

	suppressGoogleTranslateChrome();
	if (window.location.hostname.endsWith('.translate.goog')) {
		const translateChromeObserver = new MutationObserver(suppressGoogleTranslateChrome);
		translateChromeObserver.observe(document.documentElement, { childList: true, subtree: true });
		window.addEventListener('load', () => {
			suppressGoogleTranslateChrome();
			[300, 1000, 2400, 5000].forEach((delay) => {
				window.setTimeout(suppressGoogleTranslateChrome, delay);
			});
		}, { once: true });
	}

	function getTargetTranslationLanguage() {
		const params = new URLSearchParams(window.location.search);
		const candidate = params.get('_x_tr_tl') || params.get('lang') || '';
		const normalized = normalizeTranslationLanguage(candidate);
		if (!normalized || normalized === 'ja') return '';
		return normalized;
	}

	function normalizeTranslationLanguage(language) {
		const normalized = (language || '').trim();
		const lower = normalized.toLowerCase();
		if (lower === 'zh-cn' || lower === 'zh-hans') return 'zh-CN';
		if (lower === 'zh-tw' || lower === 'zh-hant') return 'zh-TW';
		return lower;
	}

	function getTranslationLanguageLabel(language) {
		const labels = {
			en: 'English translation',
			'zh-CN': '简体中文翻译',
			'zh-TW': '繁體中文翻譯',
			ko: '한국어 번역',
			es: 'Traducción al español',
			fr: 'Traduction française',
			de: 'Deutsche Übersetzung',
			it: 'Traduzione italiana',
			pt: 'Tradução em português',
			ru: 'Русский перевод',
			ar: 'ترجمة عربية',
			hi: 'हिन्दी अनुवाद',
			th: 'คำแปลภาษาไทย',
			vi: 'Bản dịch tiếng Việt',
			id: 'Terjemahan Bahasa Indonesia',
			ms: 'Terjemahan Bahasa Melayu',
			tl: 'Salin sa Tagalog',
			ne: 'नेपाली अनुवाद',
			my: 'မြန်မာဘာသာပြန်',
			km: 'ការបកប្រែភាសាខ្មែរ',
			bn: 'বাংলা অনুবাদ',
			ta: 'தமிழ் மொழிபெயர்ப்பு',
			ur: 'اردو ترجمہ',
			fa: 'ترجمه فارسی',
			tr: 'Türkçe çeviri',
		};

		return labels[language] || `${language.toUpperCase()} translation`;
	}

	function updateSlideTranslationLanguageNotice(language) {
		document.querySelectorAll('[data-slide-notes-language]').forEach((notice) => {
			notice.hidden = true;
			notice.textContent = '';
		});
	}

	function buildTranslatedTextExportUrl(deckId, language) {
		const textExportUrl = `https://docs.google.com/presentation/d/${deckId}/export/txt`;
		if (!language) return textExportUrl;

		const translateUrl = new URL('https://translate.google.com/translate');
		translateUrl.searchParams.set('sl', 'ja');
		translateUrl.searchParams.set('tl', language);
		translateUrl.searchParams.set('u', textExportUrl);
		return translateUrl.href;
	}

	function updateSlideNotesTextLinks(language) {
		document.querySelectorAll('[data-slide-notes-text-link]').forEach((link) => {
			const deckId = link.dataset.slideDeckId || '';
			if (!deckId) return;
			link.href = buildTranslatedTextExportUrl(deckId, language);
		});
	}

	function getOriginalSlideUrl(source) {
		const sourceUrl = new URL(source, window.location.href);
		const originalUrl = new URL(sourceUrl.href);

		if (originalUrl.hostname === 'docs-google-com.translate.goog') {
			originalUrl.hostname = 'docs.google.com';
		}

		['_x_tr_sl', '_x_tr_tl', '_x_tr_hl', '_x_tr_pto'].forEach((param) => {
			originalUrl.searchParams.delete(param);
		});

		return originalUrl.href;
	}

	function getSlideDeckId(source) {
		const sourceUrl = new URL(getOriginalSlideUrl(source), window.location.href);
		const match = sourceUrl.pathname.match(/\/presentation\/d\/([^/]+)/);
		return match ? match[1] : '';
	}

	function buildTranslatedSlideTextUrl(source, language) {
		const deckId = getSlideDeckId(source);
		if (!deckId) return getOriginalSlideUrl(source);

		return buildTranslatedTextExportUrl(deckId, language);
	}

	function setSlideNotesFallbackVisibility(shouldShow) {
		document.querySelectorAll('[data-slide-notes-fallback]').forEach((notes) => {
			notes.hidden = !shouldShow;
		});
		document.querySelectorAll('.slide-translation-layout').forEach((layout) => {
			layout.dataset.slideNotesVisible = shouldShow ? 'true' : 'false';
		});
	}

	const slideNotesMobileQuery = window.matchMedia('(max-width: 768px)');

	function setSlideNotesMinimized(notes, minimized) {
		notes.dataset.slideNotesMinimized = minimized ? 'true' : 'false';
		const toggle = notes.querySelector('[data-slide-notes-toggle]');
		if (!toggle) return;

		toggle.textContent = minimized ? '＋' : '×';
		toggle.setAttribute('aria-expanded', String(!minimized));
		toggle.setAttribute('aria-label', minimized ? 'スライド本文を表示' : 'スライド本文を最小化');
	}

	function initializeSlideNotesToggles(targetLanguage) {
		document.querySelectorAll('[data-slide-notes-fallback]').forEach((notes) => {
			if (notes.dataset.slideNotesToggleReady !== 'true') {
				notes.dataset.slideNotesToggleReady = 'true';
				notes.querySelector('[data-slide-notes-toggle]')?.addEventListener('click', () => {
					notes.dataset.slideNotesTouched = 'true';
					setSlideNotesMinimized(notes, notes.dataset.slideNotesMinimized !== 'true');
				});
			}

			if (notes.dataset.slideNotesTouched === 'true') return;
			setSlideNotesMinimized(notes, false);
		});
	}

	function placeSlideNotesFallback(container, notes) {
		if (!container || !notes) return container?.parentElement || null;

		const existingLayout = container.closest('.slide-translation-layout');
		if (existingLayout) {
			return existingLayout.querySelector('.slide-media-column') || container.parentElement;
		}

		const layout = document.createElement('div');
		layout.className = 'slide-translation-layout';

		const mediaColumn = document.createElement('div');
		mediaColumn.className = 'slide-media-column';

		container.insertAdjacentElement('beforebegin', layout);
		mediaColumn.append(container);
		layout.append(mediaColumn);
		layout.append(notes);
		notes.dataset.slideNotesPlaced = 'true';
		document.querySelector('.content-area')?.classList.add('has-slide-translation-layout');

		return mediaColumn;
	}

	function getSlideNotesFallbackForDeck(deckId) {
		if (!deckId) return null;

		let matchingFallback = null;
		document.querySelectorAll('[data-slide-notes-deck]').forEach((card) => {
			if (card.dataset.slideNotesDeck !== deckId) return;
			matchingFallback = card.closest('[data-slide-notes-fallback]');
		});
		return matchingFallback;
	}

	function addSlideTranslationSupport() {
		const targetLanguage = getTargetTranslationLanguage();
		setSlideNotesFallbackVisibility(Boolean(targetLanguage));
		updateSlideTranslationLanguageNotice(targetLanguage);
		updateSlideNotesTextLinks(targetLanguage);
		initializeSlideNotesToggles(targetLanguage);
		if (!targetLanguage) return;

		document.querySelectorAll('iframe[src*="docs.google.com/presentation/d/"], iframe[src*="docs-google-com.translate.goog/presentation/d/"]').forEach((iframe) => {
			const source = iframe.getAttribute('src');
			if (!source || iframe.dataset.slideTranslationReady === 'true') return;

			const originalSlideUrl = getOriginalSlideUrl(source);
			const translatedTextUrl = buildTranslatedSlideTextUrl(source, targetLanguage);
			iframe.dataset.slideTranslationReady = 'true';
			iframe.dataset.originalSlideSrc = originalSlideUrl;
			iframe.dataset.translatedSlideTextSrc = translatedTextUrl;
			if (source !== originalSlideUrl) {
				iframe.setAttribute('src', originalSlideUrl);
			}

			const deckId = getSlideDeckId(source);
			const container = iframe.closest('.slide-container') || iframe.parentElement;
			const notes = getSlideNotesFallbackForDeck(deckId);
			const actionParent = notes ? placeSlideNotesFallback(container, notes) : container;
			if (!actionParent || actionParent.querySelector('.slide-translate-actions')) return;

			const actions = document.createElement('div');
			actions.className = 'slide-translate-actions';

			const link = document.createElement('a');
			link.className = 'slide-translate-button';
			link.href = originalSlideUrl;
			link.target = '_blank';
			link.rel = 'noopener noreferrer';
			link.textContent = 'Googleスライドを開く';

			actions.append(link);

			if (notes) {
				const notesHasCopy = Boolean(notes.querySelector('.slide-notes-copy'));
				const notesLink = document.createElement('a');
				notesLink.className = 'slide-translate-button slide-translate-button-secondary';
				notesLink.href = '#slide-translation-text';
				notesLink.textContent = notesHasCopy ? 'スライド本文を見る' : 'スライド本文を開く';
				notesLink.addEventListener('click', (event) => {
					event.preventDefault();
					notes.scrollIntoView({ behavior: 'smooth', block: 'start' });
				});
				actions.append(notesLink);
				notes.id = 'slide-translation-text';
			} else {
				const textLink = document.createElement('a');
				textLink.className = 'slide-translate-button slide-translate-button-secondary';
				textLink.href = translatedTextUrl;
				textLink.target = '_blank';
				textLink.rel = 'noopener noreferrer';
				textLink.textContent = 'スライド本文を翻訳で開く';
				actions.append(textLink);
			}

			actionParent.append(actions);
		});
	}

	addSlideTranslationSupport();
	slideNotesMobileQuery.addEventListener?.('change', () => {
		initializeSlideNotesToggles(getTargetTranslationLanguage());
	});
</script>

<style>
	/* --- 共通設定 --- */
	.video-anchor {
		width: 100%;
		aspect-ratio: 16 / 9;
		max-width: 1000px;
		margin: 0 auto;
		position: relative;
		background: #000;
	}

	.player-container {
		width: 100%;
		height: 100%;
		background: #000;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.video-inner {
		width: 100%;
		height: 100%;
		position: relative;
	}

	iframe {
		width: 100%;
		height: 100%;
		display: block;
	}

	.content-area {
		width: 100%;
		max-width: 800px;
		margin: 0 auto;
		padding: 40px 20px;
		background: #fff;
		position: relative;
		z-index: 10;
		overflow-x: clip;
	}

	:global(html),
	:global(body) {
		width: 100%;
		max-width: 100%;
		overflow-x: hidden;
	}

	:global(html.translated-ltr),
	:global(html.translated-rtl) {
		margin-top: 0 !important;
	}

	:global(body.translated-ltr),
	:global(body.translated-rtl) {
		top: 0 !important;
		margin-top: 0 !important;
	}

	:global(iframe#gt-nvframe),
	:global(iframe.goog-te-banner-frame),
	:global(iframe.skiptranslate),
	:global(body > .skiptranslate),
	:global(#goog-gt-tt),
	:global(.goog-te-balloon-frame),
	:global(.VIpgJd-ZVi9od-ORHb-OEVmcd) {
		display: none !important;
		visibility: hidden !important;
		width: 0 !important;
		height: 0 !important;
		opacity: 0 !important;
		pointer-events: none !important;
	}

	:global(.goog-text-highlight) {
		background: transparent !important;
		box-shadow: none !important;
	}

	:global(.article-wrap),
	:global(.slide-container),
	:global(.slide-translation-layout),
	:global(.slide-media-column) {
		max-width: 100%;
		min-width: 0;
	}

	:global(.slide-translation-layout) {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 18px;
		align-items: start;
		margin-top: 18px;
	}

	:global(.slide-translation-layout[data-slide-notes-visible="false"]) {
		display: block;
	}

	:global(.slide-media-column) {
		min-width: 0;
	}

	:global(.slide-translation-layout .slide-container) {
		margin-top: 0;
	}

	:global(.slide-translate-actions) {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		justify-content: flex-start;
		margin: 12px 0 0;
		max-width: 100%;
		min-width: 0;
	}

	:global(.slide-translate-button) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 38px;
		padding: 0 14px;
		background: #111;
		border: 1px solid #c5a059;
		color: #c5a059;
		font-family: 'Oswald', sans-serif;
		font-size: 0.82rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-decoration: none;
		max-width: 100%;
		min-width: 0;
		text-align: center;
		white-space: normal;
	}

	:global(.slide-translate-button:hover) {
		background: #c5a059;
		color: #000;
	}

	:global(.slide-translate-button-secondary) {
		background: #fff;
		color: #111;
		border-color: #111;
	}

	:global(.slide-translate-button-secondary:hover) {
		background: #111;
		color: #fff;
	}

	:global(.slide-notes-fallback) {
		margin: 48px 0 0;
		padding: 28px;
		border: 1px solid #c5a059;
		background: #fffaf0;
		color: #111;
	}

	:global(.slide-notes-fallback[hidden]),
	:global(.slide-notes-language[hidden]) {
		display: none !important;
	}

	:global(.slide-translation-layout .slide-notes-fallback) {
		margin: 0;
	}

	:global(.slide-notes-header) {
