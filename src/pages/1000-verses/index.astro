---
import Layout from '../../layouts/Layout.astro';
import BookletViewer from '../../components/BookletViewer.astro';
---

<Layout
	title="厳選 1000 VERSES"
	description="2021年から2025年まで、アーサー先生が集会やメッセージの中で引用してきた聖句を、冊子形式でご覧いただけます。"
	image="/assets/1000-verses-og.jpg"
	imageAlt="厳選 1000 VERSES | THE ARTHUR HOLLANDS SHOW"
>
	<main class="verses-page">
		<div class="verses-inner">
			<BookletViewer />
			<section class="share-section" id="share" aria-labelledby="share-title">
				<h2 id="share-title">このページをシェアする</h2>
				<div class="share-grid" aria-label="SNS共有ボタン">
					<button class="share-card primary-share" type="button" data-share-native>
						<span>スマホで共有</span>
					</button>
					<a class="share-card line" href="https://line.me/R/msg/text/?%E5%8E%B3%E9%81%B8%201000%20VERSES%0Ahttps%3A%2F%2Farthur-show.com%2F1000-verses%2F" data-share-line target="_blank" rel="noreferrer">
						<span>LINE</span>
					</a>
					<a class="share-card x" href="https://twitter.com/intent/tweet?text=%E5%8E%B3%E9%81%B8%201000%20VERSES&url=https%3A%2F%2Farthur-show.com%2F1000-verses%2F" data-share-x target="_blank" rel="noreferrer">
						<span>X</span>
					</a>
					<a class="share-card facebook" href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Farthur-show.com%2F1000-verses%2F" data-share-facebook target="_blank" rel="noreferrer">
						<span>Facebook</span>
					</a>
					<button class="share-card instagram" type="button" data-copy-link>
						<span>Instagram</span>
					</button>
					<button class="share-card copy" type="button" data-copy-link>
						<span>リンクコピー</span>
						<small data-copy-status>URLをクリップボードへ</small>
					</button>
				</div>
			</section>
		</div>
	</main>

	<script is:inline>
		const shareTitle = '厳選 1000 VERSES | アーサーホーランド公式YouTubeチャンネル THE ARTHUR HOLLANDS SHOW';
		const shareText = 'このページでは、2021年から2025年まで、アーサー先生が集会やメッセージの中で引用してきた聖句を、冊子形式でご覧いただけます。さらに、読み進めていく中で、それぞれの聖句に関連する動画も下部に表示されます。聖書をより深く味わうための助けとして、ぜひご活用ください。';
		const shareUrl = 'https://arthur-show.com/1000-verses/';

		function updateShareLinks() {
			const encodedUrl = encodeURIComponent(shareUrl);
			const encodedText = encodeURIComponent(`${shareTitle}\n${shareText}`);
			const encodedLineText = encodeURIComponent(`${shareTitle}\n${shareText}\n${shareUrl}`);
			const line = document.querySelector('[data-share-line]');
			const x = document.querySelector('[data-share-x]');
			const facebook = document.querySelector('[data-share-facebook]');

			if (line) line.href = `https://line.me/R/msg/text/?${encodedLineText}`;
			if (x) x.href = `https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}`;
			if (facebook) facebook.href = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
		}

		async function copyShareLink() {
			const statusItems = document.querySelectorAll('[data-copy-status]');
			const payload = `${shareTitle}\n${shareText}\n${shareUrl}`;
			try {
				await navigator.clipboard.writeText(payload);
				statusItems.forEach((item) => {
					item.textContent = 'コピーしました';
				});
				setTimeout(() => {
					statusItems.forEach((item) => {
						item.textContent = 'URLをクリップボードへ';
					});
				}, 1800);
			} catch {
				window.prompt('この内容をコピーしてください', payload);
			}
		}

		async function sharePage() {
			if (navigator.share) {
				try {
					await navigator.share({
						title: shareTitle,
						text: shareText,
						url: shareUrl,
					});
					return;
				} catch (error) {
					if (error.name === 'AbortError') return;
				}
			}
			await copyShareLink();
		}

		updateShareLinks();
		document.querySelectorAll('[data-share-native]').forEach((button) => {
			button.addEventListener('click', sharePage);
		});
		document.querySelectorAll('[data-copy-link]').forEach((button) => {
			button.addEventListener('click', copyShareLink);
		});
	</script>
</Layout>

<style>
	.verses-page {
		margin: -22px 0 -80px;
		padding: 34px 20px 72px;
		background:
			radial-gradient(circle at 78% 0%, rgba(197, 160, 89, 0.26), transparent 34%),
			linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0 18%, transparent 18% 100%),
			linear-gradient(180deg, #080705 0%, #15100a 46%, #050505 100%);
		color: #fff;
	}

	.verses-inner {
		max-width: 1180px;
		margin: 0 auto;
	}

	.share-section {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		margin-top: 18px;
		padding: 14px 0;
		border-top: 1px solid rgba(197, 160, 89, 0.5);
		border-bottom: 1px solid rgba(197, 160, 89, 0.28);
	}

	.share-section h2 {
		flex: 0 0 auto;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.86rem;
		font-weight: 900;
	}

	.share-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 8px;
	}

	.share-card {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 34px;
		padding: 0 11px;
		color: #fff;
		text-align: center;
		text-decoration: none;
		cursor: pointer;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(197, 160, 89, 0.32);
		font: inherit;
	}

	.share-card span {
		display: block;
		font-size: 0.78rem;
		font-weight: 900;
		line-height: 1;
	}

	.share-card small {
		display: none;
	}

	.share-card:hover {
		transform: translateY(-1px);
		background: rgba(255, 255, 255, 0.14);
	}

	.primary-share {
		color: #050505;
		background: #c5a059;
	}

	.line {
		border-bottom: 3px solid #06c755;
	}

	.x {
		border-bottom: 3px solid #fff;
	}

	.facebook {
		border-bottom: 3px solid #1877f2;
	}

	.instagram {
		border-bottom: 3px solid #e4405f;
	}

	.copy {
		border-bottom: 3px solid #c5a059;
	}

	@media (max-width: 980px) {
		.verses-page {
			margin-top: -18px;
			padding: 22px 14px 52px;
		}

		.share-section {
			align-items: flex-start;
			flex-direction: column;
		}

		.share-grid {
			justify-content: flex-start;
		}
	}
</style>
