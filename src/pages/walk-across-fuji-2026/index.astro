<style is:global>.fuji-share-buttons{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.fuji-share-buttons a,.fuji-share-buttons button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 20px;border:1px solid #142329;border-radius:5px;background:#142329;color:#fff;font:700 15px/1.4 sans-serif;text-decoration:none;cursor:pointer}.fuji-share-buttons [data-fuji-share="line"]{background:#067d35;border-color:#067d35}.fuji-share-buttons [data-fuji-share="facebook"]{background:#1769b7;border-color:#1769b7}.fuji-share-buttons [data-fuji-share="copy"]{background:transparent;color:#142329}.fuji-share-buttons :focus-visible{outline:3px solid #ca3025;outline-offset:3px}.fuji-share-status{min-height:1.6em;margin:10px 0 0;font-size:14px}.fuji-share-url{box-sizing:border-box;width:100%;padding:10px;font-size:16px}@media(max-width:520px){.fuji-share-buttons{display:grid;grid-template-columns:1fr 1fr}.fuji-share-buttons [data-fuji-share="native"]{grid-column:1/-1}}</style>
<script is:inline>(()=>{const box=document.querySelector('.fuji-share');if(!box)return;const url=location.origin+location.pathname;const title='富士山一周十字架行進2026';const text='2026年9月24日（木）〜27日（日）毎朝7:00スタート。富士山を一周する4日間。';const enc=encodeURIComponent;const status=box.querySelector('.fuji-share-status');const field=box.querySelector('.fuji-share-url');const links={line:'https://social-plugins.line.me/lineit/share?url='+enc(url)+'&text='+enc(title+'\n'+text),x:'https://twitter.com/intent/tweet?text='+enc(title+'\n'+text)+'&url='+enc(url),facebook:'https://www.facebook.com/sharer/sharer.php?u='+enc(url)};Object.entries(links).forEach(([key,value])=>{box.querySelector('[data-fuji-share="'+key+'"]').href=value;});async function copy(){try{await navigator.clipboard.writeText(url);status.textContent='リンクをコピーしました。';field.hidden=true;}catch{field.value=url;field.hidden=false;field.focus();field.select();status.textContent='表示されたURLをコピーしてください。';}}box.querySelector('[data-fuji-share="copy"]').addEventListener('click',copy);box.querySelector('[data-fuji-share="native"]').addEventListener('click',async()=>{if(navigator.share){try{await navigator.share({title,text,url});status.textContent='';}catch(error){if(error.name!=='AbortError'){await copy();}}}else{await copy();}});})();</script>
