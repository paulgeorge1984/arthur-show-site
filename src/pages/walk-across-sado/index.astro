	<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
	<script is:inline define:vars={{ mapRoutes, stops, sadoIslandBounds }}>
		(() => {
			const element = document.getElementById('sado-map');
			if (!element || !window.L) return;
			const map = window.L.map(element, { scrollWheelZoom: false, zoomControl: true, zoomSnap: .25, zoomDelta: .5 });
			window.L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap contributors</a>' }).addTo(map);
			const layer = window.L.featureGroup().addTo(map);
			mapRoutes.forEach((route) => window.L.polyline(route.coordinates, { color: route.color, opacity: .96, weight: 6 }).bindTooltip(`DAY ${route.day}｜${route.from} → ${route.to}`, { sticky: true, className: 'route-line-label' }).addTo(layer));
			stops.forEach((stop) => window.L.marker([stop.lat, stop.lng], { alt: stop.name, icon: window.L.divIcon({ className: 'route-marker-shell', html: `<span>${stop.marker}</span>`, iconAnchor: [19, 19], iconSize: [38, 38] }) }).bindTooltip(stop.name, { permanent: true, direction: stop.direction, offset: stop.direction === 'top' ? [0, -18] : stop.direction === 'left' ? [-18, 0] : [18, 0], className: 'route-place-label' }).addTo(layer));
			const islandBounds = window.L.latLngBounds(sadoIslandBounds).pad(.035);
			const fitWholeIsland = () => {
				map.invalidateSize();
				map.fitBounds(islandBounds, { animate: false, padding: [32, 32] });
			};
			fitWholeIsland();
			window.L.control.scale({ imperial: false, position: 'bottomleft' }).addTo(map);
			let resizeFrame;
			window.addEventListener('resize', () => {
				window.cancelAnimationFrame(resizeFrame);
				resizeFrame = window.requestAnimationFrame(fitWholeIsland);
			}, { passive: true });
		})();
		</script>
		<script is:inline define:vars={{ shareTitle, shareText, shareUrl }}>
			(() => {
				const root = document.querySelector('[data-share-root]');
				if (!root) return;

				const nativeButton = root.querySelector('[data-share-native]');
				const copyButton = root.querySelector('[data-copy-link]');
				const copyStatus = root.querySelector('[data-copy-status]');
				const liveStatus = root.querySelector('[data-share-live-status]');
				const payload = { title: shareTitle, text: shareText, url: shareUrl };

				const announce = (message) => {
					if (liveStatus) liveStatus.textContent = message;
				};

				const legacyCopy = () => {
					const textarea = document.createElement('textarea');
					textarea.value = shareUrl;
					textarea.setAttribute('readonly', '');
					textarea.style.position = 'fixed';
					textarea.style.opacity = '0';
					document.body.appendChild(textarea);
					textarea.select();
					const copied = document.execCommand('copy');
					textarea.remove();
					return copied;
				};

				const copyShareUrl = async () => {
					try {
						if (navigator.clipboard && window.isSecureContext) {
							await navigator.clipboard.writeText(shareUrl);
						} else if (!legacyCopy()) {
							window.prompt('このURLをコピーしてください', shareUrl);
						}
						if (copyStatus) copyStatus.textContent = 'コピーしました';
						announce('記事のURLをコピーしました。');
						window.setTimeout(() => {
							if (copyStatus) copyStatus.textContent = 'URLをコピー';
						}, 2400);
					} catch {
						window.prompt('このURLをコピーしてください', shareUrl);
						announce('URLを表示しました。');
					}
				};

				copyButton?.addEventListener('click', copyShareUrl);
				nativeButton?.addEventListener('click', async () => {
					if (!navigator.share) {
						await copyShareUrl();
						return;
					}
					try {
						await navigator.share(payload);
						announce('共有メニューを開きました。');
					} catch (error) {
						if (error?.name !== 'AbortError') announce('共有メニューを開けませんでした。リンクコピーをご利用ください。');
					}
				});
			})();
		</script>
		<script is:inline>
			(() => {
				const scrollToDayReport = () => {
					if (!/^#day[1-5]-report$/.test(window.location.hash)) return;
					const report = document.getElementById(window.location.hash.slice(1));
					if (!report) return;
					window.requestAnimationFrame(() => report.scrollIntoView({ block: 'start', behavior: 'auto' }));
				};

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', scrollToDayReport, { once: true });
				} else {
					scrollToDayReport();
				}
				window.addEventListener('load', scrollToDayReport, { once: true });
				window.addEventListener('hashchange', scrollToDayReport);
			})();
		</script>
