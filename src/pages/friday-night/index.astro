---
import Layout from '../../layouts/Layout.astro';
import archive from '../../data/friday-night-archive.json';

type FridayVideo = {
	id: string;
	title: string;
	url: string;
	thumbnail?: string;
	duration?: string;
	viewCount?: string;
};

const archiveData = archive as {
	fetchedAt: string | null;
	playlist: { id: string; title: string; url: string };
	videos: FridayVideo[];
};

const videos = archiveData.videos || [];
const latestVideo = videos[0];
const featureVideos = videos.slice(0, 6);
const isVrTitle = (title: string) => /VR版|ＶＲ版|VR version|\bVR\b/i.test(title);
const vrVideos = videos.filter((video) => isVrTitle(video.title));
const nonVrVideos = videos.filter((video) => !isVrTitle(video.title));
const originVideos = nonVrVideos.slice(-6).reverse();
const yearFromTitle = (title: string) => title.match(/20\d{2}/)?.[0] || 'ARCHIVE';
const years = Array.from(new Set(videos.map((video) => yearFromTitle(video.title)))).sort((a, b) => {
	if (a === 'ARCHIVE') return 1;
	if (b === 'ARCHIVE') return -1;
	return Number(b) - Number(a);
});
const yearCounts = new Map(years.map((year) => [year, videos.filter((video) => yearFromTitle(video.title) === year).length]));
const totalHours = Math.round(videos.reduce((total, video) => {
	const match = String(video.duration || '').match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
	if (!match) return total;
	const hours = Number(match[1] || 0);
	const minutes = Number(match[2] || 0);
	const seconds = Number(match[3] || 0);
	return total + hours + minutes / 60 + seconds / 3600;
}, 0));

const formatDuration = (value?: string) => {
	const match = String(value || '').match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
	if (!match) return '';
	const hours = Number(match[1] || 0);
	const minutes = Number(match[2] || 0);
	const seconds = Number(match[3] || 0);
	if (hours) return `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
	return `${minutes}:${String(seconds).padStart(2, '0')}`;
};
const formatViews = (value?: string) => {
	const count = Number(value || 0);
	if (!count) return '';
	return new Intl.NumberFormat('ja-JP').format(count);
};
---

<Layout
	title="FRIDAY NIGHT"
	description="OCC Friday Night。毎月第一金曜日19:00より、お茶の水クリスチャンセンターにて開催。アーサー・ホーランドが30年以上語り続けてきた集会と、コロナ禍以降に始まった映像伝道の歴史的アーカイブ。"
>
	<article class="friday-page">
		<header class="friday-hero">
			<div class="hero-copy">
				<p class="section-label">OCC FRIDAY NIGHT ARCHIVE</p>
				<h1>FRIDAY NIGHT</h1>
				<p>
					アーサー・ホーランドが30年以上にわたり語り続けてきた、OCC Friday Night。
					教会の扉が閉ざされたコロナ禍に、コロナの緊急事態宣言より、ジーザスの大宣教命令が上なんだと叫び、始まった映像伝道の記録です。
				</p>
				<div class="hero-actions">
					<a href="#archive">ARCHIVE</a>
					<a href={archiveData.playlist.url} target="_blank" rel="noopener noreferrer">YOUTUBE</a>
				</div>
				<div class="event-info" aria-label="OCCフライデイナイト開催情報">
					<span>OCC FRIDAY NIGHT</span>
					<strong>毎月第一金曜日 19:00-</strong>
					<small>お茶の水クリスチャンセンターにて開催</small>
				</div>
			</div>
			{latestVideo && (
				<a class="hero-feature" href={latestVideo.url} target="_blank" rel="noopener noreferrer">
					<span class="feature-thumb">
						<img src={latestVideo.thumbnail || `https://i.ytimg.com/vi/${latestVideo.id}/hq720.jpg`} alt={`${latestVideo.title} サムネイル`} loading="eager" />
					</span>
					<span class="feature-body">
						<small>LATEST RECORD</small>
						<strong>{latestVideo.title}</strong>
						<em>{formatDuration(latestVideo.duration)}{formatViews(latestVideo.viewCount) && ` / ${formatViews(latestVideo.viewCount)} views`}</em>
					</span>
				</a>
			)}
		</header>

		<section class="legacy-band" aria-labelledby="legacy-title">
			<div>
				<p class="section-label">WHY THIS ARCHIVE MATTERS</p>
				<h2 id="legacy-title">閉ざされた時代に、福音を叫ぶ声は止まらなかった。</h2>
			</div>
			<div class="legacy-copy">
				<p>
					Friday Nightは、単なる週末集会の記録ではありません。御茶ノ水クリスチャンセンターで積み重ねられてきた祈りと賛美とメッセージが、映像という形で外へ向かって開かれていった転換点のアーカイブです。
				</p>
				<p>
					会堂に集まれない時期にも、福音伝道の勢いは決して止まりませんでした。コロナの緊急事態宣言より、ジーザスの大宣教命令が上なんだと叫びながら、恐れ、不安、孤独、時代の混乱の中で、それでもジーザスの福音をまっすぐ届けようとする熱が刻まれています。
				</p>
			</div>
		</section>

		<section class="stats-strip" aria-label="アーカイブ概要">
			<div>
				<span>{videos.length}</span>
				<p>MESSAGES</p>
			</div>
			<div>
				<span>{totalHours}</span>
				<p>HOURS</p>
			</div>
			<div>
				<span>2020</span>
				<p>VIDEO MISSION START</p>
			</div>
		</section>

		<section class="origin-section" aria-labelledby="origin-title">
			<div class="section-heading">
				<p class="section-label">HISTORICAL START</p>
				<h2 id="origin-title">映像伝道の始まりに立ち返る</h2>
			</div>
			<div class="origin-grid">
				{originVideos.map((video) => (
					<a class="origin-card" href={video.url} target="_blank" rel="noopener noreferrer">
						<img src={video.thumbnail || `https://i.ytimg.com/vi/${video.id}/hq720.jpg`} alt={`${video.title} サムネイル`} loading="lazy" />
						<span>
							<small>{formatDuration(video.duration)}</small>
							<strong>{video.title}</strong>
						</span>
					</a>
				))}
			</div>
		</section>

		{vrVideos.length > 0 && (
			<section class="vr-section" aria-labelledby="vr-title">
				<div class="vr-copy">
					<p class="section-label">VR RECORDS</p>
					<h2 id="vr-title">100年後を見据えて残された、もうひとつの記録。</h2>
					<p>
						Friday Nightには、通常の映像配信だけでなく、VRカメラで収められた記録も残されています。
						その場に立ち会うような視点でメッセージを後世へ届けるための、100年後を見据えた映像伝道の試みです。
					</p>
				</div>
				<div class="vr-grid">
					{vrVideos.slice(0, 4).map((video) => (
						<a class="vr-card" href={video.url} target="_blank" rel="noopener noreferrer">
							<img src={video.thumbnail || `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt={`${video.title} サムネイル`} loading="lazy" />
							<span>
								<small>VR ARCHIVE / {formatDuration(video.duration)}</small>
								<strong>{video.title}</strong>
							</span>
						</a>
					))}
				</div>
			</section>
		)}

		<section class="featured-section" aria-labelledby="featured-title">
			<div class="section-heading">
				<p class="section-label">RECENT RECORDS</p>
				<h2 id="featured-title">今につながるFriday Night</h2>
			</div>
			<div class="featured-grid">
				{featureVideos.map((video) => (
					<a class="feature-card" href={video.url} target="_blank" rel="noopener noreferrer">
						<img src={video.thumbnail || `https://i.ytimg.com/vi/${video.id}/hq720.jpg`} alt={`${video.title} サムネイル`} loading="lazy" />
						<span>
							<small>{yearFromTitle(video.title)} / {formatDuration(video.duration)}</small>
							<strong>{video.title}</strong>
							{formatViews(video.viewCount) && <em>{formatViews(video.viewCount)} views</em>}
						</span>
					</a>
				))}
			</div>
		</section>

		<section class="share-section" id="share" aria-labelledby="share-title">
			<h2 id="share-title">このページをシェアする</h2>
			<div class="share-grid" aria-label="SNS共有ボタン">
				<button class="share-card primary-share" type="button" data-share-native><span>スマホで共有</span></button>
				<a class="share-card line" href="https://line.me/R/msg/text/?FRIDAY%20NIGHT%0Ahttps%3A%2F%2Farthur-show.com%2Ffriday-night%2F" data-share-line target="_blank" rel="noreferrer"><span>LINE</span></a>
				<a class="share-card x" href="https://twitter.com/intent/tweet?text=FRIDAY%20NIGHT&url=https%3A%2F%2Farthur-show.com%2Ffriday-night%2F" data-share-x target="_blank" rel="noreferrer"><span>X</span></a>
				<a class="share-card facebook" href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Farthur-show.com%2Ffriday-night%2F" data-share-facebook target="_blank" rel="noreferrer"><span>Facebook</span></a>
				<button class="share-card instagram" type="button" data-copy-link><span>Instagram</span></button>
				<button class="share-card copy" type="button" data-copy-link><span>リンクコピー</span><small data-copy-status>URLをクリップボードへ</small></button>
			</div>
		</section>

		<section class="archive-section" id="archive" aria-labelledby="archive-title">
			<div class="archive-heading">
				<div>
					<p class="section-label">FULL ARCHIVE</p>
					<h2 id="archive-title">映像一覧</h2>
				</div>
				<label class="episode-search">
					<span>検索</span>
					<input type="search" placeholder="タイトルで探す" data-friday-search />
				</label>
			</div>
			<div class="year-nav" aria-label="年別ジャンプ">
				<a href="#archive" data-friday-year="all">ALL <small>{videos.length}</small></a>
				{years.map((year) => (
					<a href={`#year-${year}`} data-friday-year={year}>{year}<small>{yearCounts.get(year)}</small></a>
				))}
			</div>
			<div class="episode-list" data-friday-list>
				{years.map((year) => {
					const yearVideos = videos.filter((video) => yearFromTitle(video.title) === year);
					return (
						<section class="year-block" id={`year-${year}`} data-year-block={year}>
							<div class="year-title">
								<span>{year}</span>
								<strong>{yearVideos.length} RECORDS</strong>
							</div>
							<div class="episode-grid">
								{yearVideos.map((video, index) => (
									<a class="episode-card" href={video.url} target="_blank" rel="noopener noreferrer" data-year={year} data-search={`${video.title}`.toLowerCase()}>
										<span class="episode-thumb">
											<img src={video.thumbnail || `https://i.ytimg.com/vi/${video.id}/hq720.jpg`} alt={`${video.title} サムネイル`} loading="lazy" />
										</span>
										<span class="episode-body">
											<span class="episode-meta">{String(index + 1).padStart(2, '0')} / {formatDuration(video.duration)}</span>
											<strong>{video.title}</strong>
											{formatViews(video.viewCount) && <em>{formatViews(video.viewCount)} views</em>}
										</span>
									</a>
								))}
							</div>
						</section>
					);
				})}
			</div>
			<p class="no-results" data-friday-no-results hidden>該当する映像がありません。</p>
		</section>
	</article>

	<script is:inline>
		const shareTitle = 'FRIDAY NIGHT | アーサーホーランド公式YouTubeチャンネル THE ARTHUR HOLLANDS SHOW';
		const shareText = 'OCC Friday Night。毎月第一金曜日19:00より、お茶の水クリスチャンセンターにて開催。コロナ禍以降に始まった映像伝道の歴史的アーカイブ。';
		const shareUrl = 'https://arthur-show.com/friday-night/';
		const searchInput = document.querySelector('[data-friday-search]');
		const episodeCards = Array.from(document.querySelectorAll('[data-friday-list] .episode-card'));
		const yearButtons = Array.from(document.querySelectorAll('[data-friday-year]'));
		const yearBlocks = Array.from(document.querySelectorAll('[data-year-block]'));
		const noResults = document.querySelector('[data-friday-no-results]');
		let activeYear = 'all';

		function updateShareLinks() {
			const encodedUrl = encodeURIComponent(shareUrl);
			const encodedText = encodeURIComponent(`${shareTitle}\n${shareText}`);
			const encodedLineText = encodeURIComponent(`${shareTitle}\n${shareText}\n${shareUrl}`);
			const line = document.querySelector('[data-share-line]');
			const x = document.querySelector('[data-share-x]');
			const facebook = document.querySelector('[data-share-facebook]');
			if (line) line.href = `https://line.me/R/msg/text/?${encodedLineText}`;
			if (x) x.href = `https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}`;
			if (facebook) facebook.href = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
		}

		async function copyShareLink() {
			const statusItems = document.querySelectorAll('[data-copy-status]');
			try {
				await navigator.clipboard.writeText(`${shareTitle}\n${shareText}\n${shareUrl}`);
				statusItems.forEach((item) => { item.textContent = 'コピーしました'; });
				setTimeout(() => {
					statusItems.forEach((item) => { item.textContent = 'URLをクリップボードへ'; });
				}, 1800);
			} catch {
				window.prompt('この内容をコピーしてください', `${shareTitle}\n${shareText}\n${shareUrl}`);
			}
		}

		async function sharePage() {
			if (navigator.share) {
				try {
					await navigator.share({ title: shareTitle, text: shareText, url: shareUrl });
					return;
				} catch (error) {
					if (error.name === 'AbortError') return;
				}
			}
			await copyShareLink();
		}

		function applyFilters() {
			const query = (searchInput?.value || '').trim().toLowerCase();
			let visible = 0;
			episodeCards.forEach((card) => {
				const yearOk = activeYear === 'all' || card.dataset.year === activeYear;
				const searchOk = !query || (card.dataset.search || '').includes(query);
				const show = yearOk && searchOk;
				card.hidden = !show;
				if (show) visible += 1;
			});
			yearBlocks.forEach((block) => {
				const cards = Array.from(block.querySelectorAll('.episode-card'));
				block.hidden = cards.every((card) => card.hidden);
			});
			if (noResults) noResults.hidden = visible !== 0;
		}

		yearButtons.forEach((button) => {
			button.addEventListener('click', (event) => {
				event.preventDefault();
				activeYear = button.dataset.fridayYear || 'all';
				yearButtons.forEach((item) => item.classList.toggle('active', item === button));
				applyFilters();
				document.querySelector('#archive')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			});
		});
		searchInput?.addEventListener('input', applyFilters);
		document.querySelectorAll('[data-share-native]').forEach((button) => button.addEventListener('click', sharePage));
		document.querySelectorAll('[data-copy-link]').forEach((button) => button.addEventListener('click', copyShareLink));
		yearButtons[0]?.classList.add('active');
		updateShareLinks();
	</script>
</Layout>

<style>
	.friday-page {
		--friday-bg: #10100e;
		--friday-panel: #1c1a16;
		--friday-gold: #c5a059;
		--friday-red: #a9362c;
		background: var(--friday-bg);
		color: #f7f0e4;
		margin: -22px 0 -80px;
		padding: 0 20px 90px;
	}

	.friday-hero,
	.legacy-band,
	.stats-strip,
	.origin-section,
	.vr-section,
	.featured-section,
	.share-section,
	.archive-section {
		max-width: 1180px;
		margin: 0 auto;
	}

	.friday-hero {
		min-height: 72vh;
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
		gap: 34px;
		align-items: end;
		padding: 82px 0 42px;
	}

	.section-label {
		color: var(--friday-gold);
		font-family: var(--font-head);
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.18em;
	}

	.hero-copy h1 {
		margin-top: 8px;
		font-family: var(--font-head);
		font-size: clamp(4.2rem, 11vw, 10rem);
		font-weight: 900;
		letter-spacing: 0.01em;
		line-height: 0.88;
	}

	.hero-copy p:not(.section-label) {
		max-width: 680px;
		margin-top: 22px;
		color: rgba(247, 240, 228, 0.82);
		font-family: var(--font-serif);
		font-size: clamp(1.08rem, 2.1vw, 1.45rem);
		font-weight: 700;
		line-height: 1.85;
	}

	.hero-actions,
	.share-grid,
	.pickup-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.hero-actions {
		margin-top: 28px;
	}

	.event-info {
		display: inline-grid;
		gap: 5px;
		margin-top: 18px;
		padding: 14px 18px;
		background: rgba(247, 240, 228, 0.08);
		border-left: 4px solid var(--friday-gold);
		color: rgba(247, 240, 228, 0.84);
	}

	.event-info span,
	.event-info small {
		font-family: var(--font-head);
		font-size: 0.75rem;
		font-weight: 900;
		letter-spacing: 0.12em;
	}

	.event-info strong {
		color: #fff;
		font-family: var(--font-serif);
		font-size: clamp(1.1rem, 2vw, 1.38rem);
		line-height: 1.2;
	}

	.hero-actions a,
	.hero-feature,
	.legacy-band,
	.stats-strip,
	.origin-card,
	.vr-card,
	.feature-card,
	.episode-card,
	.share-section {
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.hero-actions a,
	.share-card {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0 18px;
		background: rgba(197, 160, 89, 0.12);
		color: #fff;
		border: 1px solid rgba(197, 160, 89, 0.75);
		font-family: var(--font-head);
		font-weight: 900;
		letter-spacing: 0.08em;
		cursor: pointer;
	}

	.hero-actions a:hover,
	.share-card:hover {
		background: var(--friday-gold);
		color: #11100e;
	}

	.hero-feature {
		display: grid;
		background: #f7f0e4;
		color: #11100e;
		box-shadow: 0 28px 80px rgba(0, 0, 0, 0.36);
	}

	.feature-thumb {
		aspect-ratio: 16 / 9;
		background: #000;
		overflow: hidden;
	}

	.feature-thumb img,
	.origin-card img,
	.vr-card img,
	.feature-card img,
	.episode-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.feature-body {
		display: grid;
		gap: 8px;
		padding: 22px;
	}

	.feature-body small,
	.feature-body em,
	.feature-card small,
	.feature-card em,
	.vr-card small,
	.origin-card small,
	.episode-meta,
	.episode-body em,
	.year-title strong {
		color: var(--friday-gold);
		font-family: var(--font-head);
		font-size: 0.76rem;
		font-style: normal;
		font-weight: 900;
		letter-spacing: 0.12em;
	}

	.feature-body strong {
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 2.7vw, 2rem);
		line-height: 1.35;
	}

	.legacy-band {
		display: grid;
		grid-template-columns: minmax(260px, 0.75fr) minmax(0, 1.25fr);
		gap: 28px;
		padding: 34px;
		background: rgba(255, 255, 255, 0.055);
	}

	.legacy-band h2,
	.section-heading h2 {
		margin-top: 8px;
		font-family: var(--font-serif);
		font-size: clamp(1.7rem, 4vw, 3rem);
		line-height: 1.25;
	}

	.legacy-copy {
		display: grid;
		gap: 16px;
		color: rgba(247, 240, 228, 0.78);
		line-height: 1.9;
	}

	.stats-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: 24px;
		background: #f7f0e4;
		color: #11100e;
	}

	.stats-strip div {
		padding: 24px;
		border-right: 1px solid rgba(17, 16, 14, 0.18);
	}

	.stats-strip div:last-child {
		border-right: 0;
	}

	.stats-strip span {
		font-family: var(--font-head);
		font-size: clamp(2.8rem, 7vw, 5.5rem);
		font-weight: 900;
		line-height: 0.95;
	}

	.stats-strip p {
		margin-top: 8px;
		color: rgba(17, 16, 14, 0.62);
		font-family: var(--font-head);
		font-weight: 900;
		letter-spacing: 0.12em;
	}

	.origin-section,
	.vr-section,
	.featured-section,
	.archive-section,
	.share-section {
		margin-top: 46px;
	}

	.section-heading,
	.archive-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 18px;
