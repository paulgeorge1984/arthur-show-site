---
import Layout from '../../layouts/Layout.astro';
import { chadWalkAcrossVideos } from '../../data/chad-walk-across-videos';

const chronologicalVideos = [...chadWalkAcrossVideos].reverse().sort((a, b) => a.date.localeCompare(b.date));
const firstVideo = chronologicalVideos[0];
const videoIds = chronologicalVideos.map((video) => video.id);
const playlistIds = videoIds.slice(1).join(',');
const embedUrl = `https://www.youtube.com/embed/${firstVideo.id}?rel=0&playlist=${playlistIds}`;
const youtubeUrl = `https://youtu.be/${firstVideo.id}`;
const channelUrl = 'https://www.youtube.com/@arthurhollands5938/videos';

const parseDuration = (value: string) => {
	const [minutes, seconds] = value.split(':').map(Number);
	return (minutes || 0) * 60 + (seconds || 0);
};
const totalSeconds = chronologicalVideos.reduce((total, video) => total + parseDuration(video.duration), 0);
const totalHours = Math.floor(totalSeconds / 3600);
const totalMinutes = Math.round((totalSeconds % 3600) / 60);
const totalDuration = `${totalHours}時間${String(totalMinutes).padStart(2, '0')}分`;

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'WALK ACROSS USA 2014',
	description: 'Chadさん制作による、2014年のアメリカ横断十字架行進の記録映像アーカイブ。',
	numberOfItems: chronologicalVideos.length,
	itemListElement: chronologicalVideos.map((video, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		url: `https://youtu.be/${video.id}`,
		name: video.date,
	})),
};
---

<Layout
	title="WALK ACROSS USA 2014"
	description="Chadさん制作による、2014年のアメリカ横断十字架行進の記録映像アーカイブ。Arthur Hollands Journeyを含む76本の映像をまとめています。"
	image={`https://i.ytimg.com/vi/${firstVideo.id}/hqdefault.jpg`}
	imageAlt="WALK ACROSS USA 2014 Arthur Hollands Journey サムネイル"
	imageWidth={480}
	imageHeight={360}
	ogType="website"
	canonicalPath="/walk-across-usa2014/"
	structuredData={structuredData}
>
	<article class="america-archive">
		<section class="archive-hero" aria-labelledby="archive-title">
			<div class="hero-copy">
				<a class="back-link" href="/walk-across/">WALK ACROSSへ戻る</a>
				<p class="kicker">RARE FOOTAGE ARCHIVE</p>
				<h1 id="archive-title">WALK ACROSS USA 2014</h1>
				<p class="japanese-title">2014年 アメリカ横断十字架行進</p>
				<p class="lead">
					Chadさん制作による、2014年のアメリカ横断十字架行進の記録映像をまとめたアーカイブです。
					旅の道中のメッセージ、日々の歩み、現地での記録をこのページからたどれます。
				</p>
				<div class="archive-stats" aria-label="アーカイブ概要">
					<span><strong>{chronologicalVideos.length}</strong> VIDEOS</span>
					<span><strong>{totalDuration}</strong> TOTAL</span>
					<span><strong>2014</strong> USA</span>
				</div>
				<div class="hero-actions">
					<a href="#videos">映像一覧を見る</a>
					<a href={channelUrl} target="_blank" rel="noopener noreferrer">チャンネルで見る</a>
				</div>
			</div>
			<div class="hero-player" aria-label={`${firstVideo.date} ${firstVideo.title} YouTube動画`}>
				<iframe
					src={embedUrl}
					title={`${firstVideo.date} ${firstVideo.title}`}
					loading="eager"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					referrerpolicy="strict-origin-when-cross-origin"
					allowfullscreen
				></iframe>
			</div>
		</section>

		<section class="archive-note" aria-label="掲載情報">
			<p>
				掲載している映像は、Chadさん制作の2014年の記録映像です。
				貴重な当時の歩みとして、WALK ACROSSの2014年アーカイブにご紹介いたします。
			</p>
			<p><strong>映像制作: Chadさん</strong></p>
		</section>

		<section class="video-section" id="videos" aria-labelledby="videos-title">
			<div class="section-heading">
				<p class="kicker">ALL VIDEOS</p>
				<h2 id="videos-title">2014 ARCHIVE</h2>
			</div>
			<div class="video-grid">
				{chronologicalVideos.map((video, index) => (
					<a class="video-card" href={`https://youtu.be/${video.id}`} target="_blank" rel="noopener noreferrer">
						<span class="video-thumb">
							<img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt={`${video.date} ${video.title} サムネイル`} loading="lazy" />
							<span class="duration">{video.duration}</span>
						</span>
						<span class="video-body">
							<small>{String(index + 1).padStart(2, '0')}</small>
							<strong>{video.date}</strong>
							<em>YouTubeで開く</em>
						</span>
					</a>
				))}
			</div>
		</section>

		<nav class="archive-footer-nav" aria-label="関連ページ">
			<a href="/walk-across/">WALK ACROSS一覧へ</a>
			<a href={youtubeUrl} target="_blank" rel="noopener noreferrer">代表動画をYouTubeで開く</a>
		</nav>
	</article>
</Layout>

<style>
	.america-archive {
		--archive-bg: #0d0c0a;
		--archive-panel: #181511;
		--archive-gold: #cfa952;
		background: var(--archive-bg);
		color: #f6efe3;
		margin: -22px 0 -80px;
		padding: 0 20px 90px;
	}

	.archive-hero,
	.archive-note,
	.video-section,
	.archive-footer-nav {
		max-width: 1180px;
		margin: 0 auto;
	}

	.archive-hero {
		display: grid;
		grid-template-columns: minmax(0, 0.82fr) minmax(420px, 1.18fr);
		gap: 34px;
		align-items: center;
		min-height: 68vh;
		padding: 76px 0 46px;
		border-bottom: 1px solid rgba(207, 169, 82, 0.34);
	}

	.back-link,
	.kicker,
	.archive-stats,
	.hero-actions a,
	.video-body small,
	.video-body em,
	.archive-footer-nav a {
		font-family: var(--font-head);
		font-weight: 900;
		letter-spacing: 0.1em;
	}

	.back-link {
		display: inline-flex;
		width: fit-content;
		margin-bottom: 28px;
		color: rgba(246, 239, 227, 0.68);
		font-size: 0.78rem;
	}

	.back-link:hover,
	.video-card:hover .video-body em,
	.archive-footer-nav a:hover {
		color: var(--archive-gold);
	}

	.kicker {
		color: var(--archive-gold);
		font-size: 0.78rem;
		letter-spacing: 0.18em;
	}

	h1 {
		margin-top: 12px;
		font-family: var(--font-head);
		font-size: clamp(3.4rem, 8vw, 7.8rem);
		font-weight: 900;
		line-height: 0.9;
		overflow-wrap: anywhere;
	}

	.japanese-title {
		margin-top: 18px;
		font-family: var(--font-serif);
		font-size: clamp(1.18rem, 2.6vw, 1.7rem);
		font-weight: 800;
		line-height: 1.45;
	}

	.lead {
		max-width: 620px;
		margin-top: 18px;
		color: rgba(246, 239, 227, 0.78);
		font-size: 1rem;
		line-height: 1.9;
	}

	.archive-stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 10px;
		margin-top: 26px;
	}

	.archive-stats span {
		display: grid;
		gap: 6px;
		min-width: 0;
		padding: 14px;
		border: 1px solid rgba(207, 169, 82, 0.3);
		background: rgba(255, 255, 255, 0.045);
		color: rgba(246, 239, 227, 0.64);
		font-size: 0.68rem;
	}

	.archive-stats strong {
		color: #fff;
		font-size: clamp(1.2rem, 2.8vw, 1.8rem);
		line-height: 1;
		letter-spacing: 0;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 28px;
	}

	.hero-actions a,
	.archive-footer-nav a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0 18px;
		border: 1px solid rgba(207, 169, 82, 0.72);
		background: rgba(207, 169, 82, 0.12);
		color: #fff;
		font-size: 0.82rem;
	}

	.hero-actions a:hover,
	.archive-footer-nav a:hover {
		background: var(--archive-gold);
		color: #0d0c0a;
	}

	.hero-player {
		aspect-ratio: 16 / 9;
		background: #000;
		border: 1px solid rgba(207, 169, 82, 0.44);
		box-shadow: 12px 12px 0 rgba(207, 169, 82, 0.14);
	}

	.hero-player iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.archive-note {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		margin-top: 28px;
		padding: 20px 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.14);
		color: rgba(246, 239, 227, 0.74);
		line-height: 1.8;
	}

	.archive-note p:first-child {
		max-width: 800px;
	}

	.archive-note strong {
		color: var(--archive-gold);
		font-family: var(--font-head);
		font-size: 0.86rem;
		letter-spacing: 0.1em;
	}

	.video-section {
		padding-top: 58px;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 22px;
		padding-bottom: 16px;
		border-bottom: 3px solid rgba(246, 239, 227, 0.86);
	}

	.section-heading h2 {
		margin-top: 6px;
		font-family: var(--font-head);
		font-size: clamp(2.8rem, 8vw, 6rem);
		line-height: 0.9;
	}

	.section-heading p:last-child {
		max-width: 420px;
		color: rgba(246, 239, 227, 0.7);
		text-align: right;
	}

	.video-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
	}

	.video-card {
		display: grid;
		min-width: 0;
		background: rgba(255, 255, 255, 0.055);
		border: 1px solid rgba(255, 255, 255, 0.12);
		overflow: hidden;
	}

	.video-card:hover {
		border-color: rgba(207, 169, 82, 0.68);
		transform: translateY(-2px);
	}

	.video-thumb {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		background: #000;
		overflow: hidden;
	}

	.video-thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: 0.25s;
	}

	.video-card:hover img {
		transform: scale(1.035);
	}

	.duration {
		position: absolute;
		right: 8px;
		bottom: 8px;
		min-height: 22px;
		padding: 3px 7px;
		background: rgba(0, 0, 0, 0.78);
		color: #fff;
		font-family: var(--font-head);
		font-size: 0.76rem;
		font-weight: 900;
	}

	.video-body {
		display: grid;
		gap: 8px;
		padding: 14px;
	}

	.video-body small,
	.video-body em {
		color: var(--archive-gold);
		font-size: 0.72rem;
		font-style: normal;
	}

	.video-body strong {
		color: #fff;
		font-size: 0.96rem;
		line-height: 1.45;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.archive-footer-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 48px;
	}

	@media (max-width: 1040px) {
		.archive-hero {
			grid-template-columns: 1fr;
			min-height: auto;
		}

		.video-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.america-archive {
			padding-inline: 14px;
		}

		.archive-hero {
			padding-top: 54px;
			gap: 26px;
		}

		h1 {
			font-size: clamp(2.7rem, 12.4vw, 4.4rem);
		}

		.archive-stats {
			grid-template-columns: 1fr;
		}

		.archive-note,
		.section-heading {
			align-items: stretch;
			flex-direction: column;
		}

		.section-heading p:last-child {
			text-align: left;
		}

		.video-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
