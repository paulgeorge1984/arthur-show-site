---
import Layout from '../../layouts/Layout.astro';
import { divinerArticles, divinerCampaign } from '../../data/divinerArthurCampaign';

const pageTitle = divinerCampaign.title;
---

<Layout
	title={pageTitle}
	description={divinerCampaign.summary}
	image={divinerCampaign.images.og}
	imageAlt="ARTHUR HOLLANDS × DIVINER"
	imageWidth={1200}
	imageHeight={630}
	imageType="image/jpeg"
	ogType="website"
	canonicalPath={divinerCampaign.pagePath}
	noindex={true}
	hideChrome={true}
>
	<article class="diviner-page">
		<nav class="preview-tabs" aria-label="確認用バージョン切り替え">
			<a class="active" href={divinerCampaign.pagePath}>TOP</a>
			{divinerArticles.map((article) => (
				<a href={`${divinerCampaign.pagePath}${article.slug}/`}>{article.dateLabel.replace(/（.+）/, '')}</a>
			))}
		</nav>

		<section class="hero" aria-labelledby="campaign-title">
			<picture class="hero-media">
				<img src={divinerCampaign.images.walkClose} alt="" width="1400" height="1750" loading="eager" />
			</picture>
			<div class="hero-copy">
				<p class="eyebrow">ARTHUR HOLLANDS × DIVINER</p>
				<h1 id="campaign-title">COMING SOON</h1>
				<p class="lead">
					A new collaboration begins.<br />
					Stay tuned.
				</p>
				<a class="primary-link" href={divinerCampaign.siteUrl} target="_blank" rel="noopener noreferrer">
					OFFICIAL SITE
				</a>
			</div>
			<div class="hero-strip" aria-hidden="true">
				<span>ARTHUR HOLLANDS</span>
				<span>RECKLESS LIFE</span>
				<span>STAY TUNED</span>
			</div>
		</section>

		<section class="section news" aria-labelledby="news-title">
			<div class="section-heading">
				<p>WHAT'S NEW?</p>
				<h2 id="news-title">最新情報</h2>
			</div>
			<div class="news-panel">
				<span>COMING SOON</span>
				<h3>ARTHUR HOLLANDS × DIVINER</h3>
				<p>Latest news will appear here.</p>
			</div>
		</section>
	</article>
</Layout>

<style>
	.diviner-page {
		min-height: 100vh;
		background: #050505;
		color: #f5f1e8;
		font-family: var(--font-sans);
		overflow: hidden;
	}

	.preview-tabs {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		gap: 8px;
		overflow-x: auto;
		padding: 10px 14px;
		background: rgba(5, 5, 5, 0.94);
		border-bottom: 1px solid rgba(255, 255, 255, 0.14);
		-webkit-overflow-scrolling: touch;
	}

	.preview-tabs::before {
		content: 'PREVIEW VERSION';
		flex: 0 0 auto;
		align-self: center;
		color: #d13a36;
		font-family: var(--font-head);
		font-size: 0.8rem;
		font-weight: 900;
		line-height: 1;
	}

	.preview-tabs a {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 34px;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 6px;
		padding: 0 14px;
		background: #121212;
		color: #f5f1e8;
		font-family: var(--font-head);
		font-size: 0.95rem;
		font-weight: 900;
		line-height: 1;
	}

	.preview-tabs a.active {
		background: #c93434;
		border-color: #c93434;
		color: #fff;
	}

	.hero {
		position: relative;
		display: grid;
		min-height: 720px;
		background: #050505;
		isolation: isolate;
	}

	.hero-media {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, #050505 0%, #050505 38%, rgba(5, 5, 5, 0.72) 58%, rgba(5, 5, 5, 0.22) 100%),
			#050505;
	}

	.hero-media::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(0, 0, 0, 0.98), rgba(0, 0, 0, 0.72) 50%, rgba(0, 0, 0, 0.1)),
			linear-gradient(0deg, #050505 0%, rgba(5, 5, 5, 0) 48%);
	}

	.hero-media img {
		position: absolute;
		top: 0;
		right: max(40px, calc((100vw - 1240px) / 2));
		display: block;
		width: min(42vw, 560px);
		height: 100%;
		object-fit: contain;
		object-position: center center;
		opacity: 0.88;
	}

	.hero-copy {
		position: relative;
		z-index: 1;
		width: min(1060px, calc(100% - 40px));
		margin: 0 auto;
		align-self: end;
		padding: 122px 0 116px;
	}

	.eyebrow,
	.section-heading p {
		color: #d13a36;
		font-family: var(--font-head);
		font-size: 1rem;
		font-weight: 900;
		line-height: 1.2;
		letter-spacing: 0;
	}

	.hero h1 {
		max-width: 960px;
		margin: 14px 0 20px;
		font-family: var(--font-head);
		font-size: 6.5rem;
		font-weight: 900;
		line-height: 0.88;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.lead {
		max-width: 680px;
		color: #f5f1e8;
		font-size: 1.55rem;
		font-weight: 900;
		line-height: 1.7;
		overflow-wrap: anywhere;
	}

	.hero-strip {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 2;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid rgba(255, 255, 255, 0.14);
		border-bottom: 1px solid rgba(255, 255, 255, 0.14);
		background: rgba(201, 52, 52, 0.92);
		color: #fff;
		font-family: var(--font-head);
		font-size: 1rem;
		font-weight: 900;
		line-height: 1.2;
		text-align: center;
		text-transform: uppercase;
	}

	.hero-strip span {
		padding: 13px 12px;
	}

	.hero-strip span + span {
		border-left: 1px solid rgba(255, 255, 255, 0.22);
	}

	.primary-link,
	.cta a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 54px;
		margin-top: 30px;
		border-radius: 6px;
		padding: 0 24px;
		background: #c93434;
		color: #fff;
		font-family: var(--font-head);
		font-size: 1.15rem;
		font-weight: 900;
		line-height: 1.2;
	}

	.section {
		width: min(1060px, calc(100% - 40px));
		margin: 0 auto;
		padding: 86px 0;
	}

	.section-heading {
		margin-bottom: 24px;
	}

	.section-heading h2,
	.message h2 {
		margin-top: 8px;
		font-size: 2.25rem;
		line-height: 1.3;
	}

	.product-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.news-panel {
		max-width: 760px;
		border-top: 1px solid rgba(255, 255, 255, 0.16);
		border-bottom: 1px solid rgba(255, 255, 255, 0.16);
		padding: 32px 0;
	}

	.news-panel span {
		color: #d13a36;
		font-family: var(--font-head);
		font-size: 1rem;
		font-weight: 900;
		line-height: 1.2;
	}

	.news-panel h3 {
		margin-top: 10px;
		font-family: var(--font-head);
		font-size: 2.35rem;
		line-height: 1.08;
	}

	.news-panel p {
		margin-top: 14px;
		color: #d0c8bd;
		font-size: 1.05rem;
		line-height: 1.85;
	}

	.product-card {
		position: relative;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 8px;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0)),
			#121212;
		box-shadow: 0 22px 70px rgba(0, 0, 0, 0.34);
	}

	.product-card img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: contain;
		background: #f6f4ef;
	}

	.product-card div {
		padding: 22px;
	}

	.product-card span {
		color: #d13a36;
		font-family: var(--font-head);
		font-size: 1rem;
		font-weight: 900;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.product-card h3 {
		margin-top: 8px;
		font-family: var(--font-head);
		font-size: 2rem;
		line-height: 1.1;
	}

	.product-card p,
	.message p {
		margin-top: 12px;
		color: #d0c8bd;
		font-size: 1rem;
		line-height: 1.85;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.message {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
		gap: 34px;
		align-items: center;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
	}

	.message img {
		display: block;
		width: 100%;
		border-radius: 8px;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.schedule-list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 12px;
	}

	.schedule-list a {
		display: grid;
		gap: 8px;
		min-height: 126px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 8px;
		padding: 18px;
		background: #151515;
	}

	.schedule-list span {
		color: #d13a36;
		font-family: var(--font-head);
		font-size: 1.15rem;
		font-weight: 900;
		line-height: 1.1;
	}

	.schedule-list strong {
		font-size: 0.98rem;
		line-height: 1.55;
	}

	.cta {
		width: min(1060px, calc(100% - 40px));
		margin: 0 auto;
		padding: 0 0 92px;
		text-align: center;
	}

	.cta strong {
		display: block;
		color: #d13a36;
		font-family: var(--font-head);
		font-size: 1rem;
		font-weight: 900;
		line-height: 1.2;
	}

	.cta p {
		color: #f5f1e8;
		font-size: 1.45rem;
		font-weight: 900;
		line-height: 1.45;
	}

	.cta a {
		margin-top: 22px;
	}

	@media (max-width: 760px) {
		.hero {
			min-height: auto;
			padding-top: 0;
		}

		.preview-tabs {
			padding: 9px 10px;
		}

		.preview-tabs::before {
			font-size: 0.72rem;
		}

		.preview-tabs a {
			min-height: 32px;
			padding: 0 12px;
			font-size: 0.88rem;
		}

		.hero-media {
			position: relative;
			height: 390px;
		}

		.hero-media::after {
			background: linear-gradient(0deg, #050505 0%, rgba(5, 5, 5, 0.22) 62%, rgba(5, 5, 5, 0) 100%);
		}

		.hero-media img {
			position: static;
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: 54% 44%;
		}

		.hero-copy {
			width: calc(100% - 28px);
			max-width: 520px;
			padding: 24px 0 34px;
		}

		.eyebrow,
		.section-heading p {
			font-size: 0.9rem;
		}

		.hero h1 {
			max-width: 350px;
			font-size: 3.55rem;
			line-height: 0.9;
		}

		.lead {
			font-size: 1.12rem;
			line-height: 1.65;
		}

		.hero-strip {
			position: relative;
			grid-template-columns: 1fr;
			font-size: 0.86rem;
		}

		.hero-strip span {
			padding: 8px 12px;
		}

		.hero-strip span + span {
			border-top: 1px solid rgba(255, 255, 255, 0.22);
			border-left: 0;
		}

		.primary-link,
		.cta a {
			width: 100%;
			min-height: 52px;
			margin-top: 22px;
			font-size: 1.04rem;
		}

		.section {
			width: calc(100% - 28px);
			max-width: 520px;
			padding: 54px 0;
		}

		.section-heading h2,
		.message h2 {
			font-size: 1.55rem;
			line-height: 1.35;
		}

		.news-panel {
			padding: 24px 0;
		}

		.news-panel h3 {
			font-size: 1.78rem;
		}

		.product-grid,
		.message,
		.schedule-list {
			grid-template-columns: 1fr;
		}

		.product-grid {
			gap: 18px;
		}

		.product-card img {
			aspect-ratio: 4 / 5;
		}

		.message img {
			aspect-ratio: 1 / 1;
		}

		.product-card div {
			padding: 18px;
		}

		.product-card h3 {
			font-size: 1.75rem;
		}

		.message {
			gap: 20px;
		}

		.schedule-list a {
			min-height: 0;
			grid-template-columns: 84px minmax(0, 1fr);
			align-items: center;
			padding: 16px;
		}

		.cta {
			width: calc(100% - 28px);
			max-width: 520px;
			padding-bottom: 56px;
		}

		.cta p {
			font-size: 1.12rem;
		}
	}
</style>
