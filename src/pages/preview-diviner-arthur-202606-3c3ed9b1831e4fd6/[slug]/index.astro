---
import Layout from '../../../layouts/Layout.astro';
import { divinerArticles, divinerCampaign } from '../../../data/divinerArthurCampaign';

export function getStaticPaths() {
	return divinerArticles.map((article) => ({
		params: { slug: article.slug },
		props: { article },
	}));
}

const { article } = Astro.props;
const pagePath = `${divinerCampaign.pagePath}${article.slug}/`;
const articleLink = article.externalUrl ?? divinerCampaign.siteUrl;
const articleCtaLabel = article.ctaLabel ?? 'DIVINER公式サイトへ';
const showProducts = article.slug === '20260627-launch';
const showLaunchLine = article.slug === '20260627-launch';
const stripCue = article.slug === '20260627-launch'
	? '2026.6.27 21:00'
	: article.slug === '20260626-countdown'
		? 'TOMORROW'
		: 'STAY TUNED';
---

<Layout
	title={`${article.title} | ${divinerCampaign.brand}`}
	description={article.lead}
	image={article.heroImage}
	imageAlt={article.title}
	imageWidth={1080}
	imageHeight={1350}
	imageType="image/png"
	ogType="article"
	canonicalPath={pagePath}
	noindex={true}
	hideChrome={true}
>
	<article class="stage-page">
		<nav class="preview-tabs" aria-label="確認用バージョン切り替え">
			<a href={divinerCampaign.pagePath}>TOP</a>
			{divinerArticles.map((item) => (
				<a class:list={{ active: item.slug === article.slug }} href={`${divinerCampaign.pagePath}${item.slug}/`}>
					{item.dateLabel.replace(/（.+）/, '')}
				</a>
			))}
		</nav>

		<header class="stage-hero">
			<div class="stage-copy">
				<a class="back-link" href={divinerCampaign.pagePath}>ARTHUR HOLLANDS × DIVINER</a>
				<p>{article.dateLabel} / {article.stage}</p>
				<h1>{article.title}</h1>
				<strong>{article.subtitle}</strong>
				<a class="primary-link" href={articleLink} target="_blank" rel="noopener noreferrer">
					{articleCtaLabel}
				</a>
			</div>
			<figure>
				<img src={article.heroImage} alt="" loading="eager" width="1080" height="1350" />
			</figure>
			<div class="stage-strip" aria-hidden="true">
				<span>WALK ACROSS</span>
				<span>RECKLESS LIFE</span>
				<span>{stripCue}</span>
			</div>
		</header>

		<section class="stage-body">
			<div class="body-copy">
				<p class="lead">{article.lead}</p>
				{article.body.map((paragraph) => <p>{paragraph}</p>)}
				{showLaunchLine && <p class="launch">{divinerCampaign.launchLabel} 発売開始</p>}
			</div>
			{showProducts && (
				<div class="item-row" aria-label="発売アイテム">
					<article>
						<img src={divinerCampaign.images.graphicProduct} alt="Graphic TEE" width="1400" height="1750" loading="lazy" />
						<h2>Graphic TEE</h2>
					</article>
					<article>
						<img src={divinerCampaign.images.photoProduct} alt="Photo TEE" width="1400" height="1750" loading="lazy" />
						<h2>Photo TEE</h2>
					</article>
				</div>
			)}
		</section>
	</article>
</Layout>

<style>
	.stage-page {
		min-height: 100vh;
		background:
			linear-gradient(135deg, rgba(201, 52, 52, 0.16), rgba(5, 5, 5, 0) 34%),
			#050505;
		color: #f5f1e8;
		font-family: var(--font-sans);
		overflow-x: hidden;
	}

	.preview-tabs {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		gap: 8px;
		overflow-x: auto;
		padding: 10px 14px;
		background: rgba(5, 5, 5, 0.94);
		border-bottom: 1px solid rgba(255, 255, 255, 0.14);
		-webkit-overflow-scrolling: touch;
	}

	.preview-tabs::before {
		content: 'PREVIEW VERSION';
		flex: 0 0 auto;
		align-self: center;
		color: #d13a36;
		font-family: var(--font-head);
		font-size: 0.8rem;
		font-weight: 900;
		line-height: 1;
	}

	.preview-tabs a {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 34px;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 6px;
		padding: 0 14px;
		background: #121212;
		color: #f5f1e8;
		font-family: var(--font-head);
		font-size: 0.95rem;
		font-weight: 900;
		line-height: 1;
	}

	.preview-tabs a.active {
		background: #c93434;
		border-color: #c93434;
		color: #fff;
	}

	.stage-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 440px);
		gap: 44px;
		width: min(1060px, calc(100% - 40px));
		margin: 0 auto;
		padding: 68px 0 86px;
		align-items: center;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
	}

	.back-link,
	.stage-copy p {
		color: #d13a36;
		font-family: var(--font-head);
		font-size: 1rem;
		font-weight: 900;
		line-height: 1.2;
		letter-spacing: 0;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 28px;
	}

	.stage-copy h1 {
		margin: 14px 0 18px;
		font-family: var(--font-head);
		font-size: 5.5rem;
		font-weight: 900;
		line-height: 0.9;
		letter-spacing: 0;
		text-transform: uppercase;
		overflow-wrap: anywhere;
	}

	.stage-copy strong {
		display: block;
		max-width: 660px;
		color: #f5f1e8;
		font-size: 1.45rem;
		line-height: 1.55;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.primary-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 54px;
		margin-top: 30px;
		border-radius: 6px;
		padding: 0 24px;
		background: #c93434;
		color: #fff;
		font-family: var(--font-head);
		font-size: 1.15rem;
		font-weight: 900;
		line-height: 1.2;
	}

	.stage-hero figure {
		overflow: hidden;
		border-radius: 8px;
		background: #111;
		box-shadow: 0 26px 80px rgba(0, 0, 0, 0.45);
	}

	.stage-hero img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}

	.stage-strip {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		background: #c93434;
		color: #fff;
		font-family: var(--font-head);
		font-size: 0.95rem;
		font-weight: 900;
		line-height: 1.2;
		text-align: center;
		text-transform: uppercase;
	}

	.stage-strip span {
		padding: 12px;
	}

	.stage-strip span + span {
		border-left: 1px solid rgba(255, 255, 255, 0.24);
	}

	.stage-body {
		width: min(1060px, calc(100% - 40px));
		margin: 0 auto;
		padding: 44px 0 92px;
	}

	.body-copy {
		max-width: 820px;
		min-width: 0;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.body-copy p {
		color: #d0c8bd;
		font-size: 1.08rem;
		line-height: 1.9;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.body-copy .lead {
		color: #f5f1e8;
		font-size: 1.4rem;
		font-weight: 900;
		line-height: 1.65;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.body-copy .launch {
		margin-top: 18px;
		color: #f5f1e8;
		font-weight: 900;
	}

	.item-row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
		margin-top: 38px;
	}

	.item-row article {
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 8px;
		background: #151515;
		box-shadow: 0 18px 60px rgba(0, 0, 0, 0.3);
	}

	.item-row img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: contain;
		background: #f6f4ef;
	}

	.item-row h2 {
		padding: 18px;
		font-family: var(--font-head);
		font-size: 1.85rem;
		line-height: 1.1;
	}

	@media (max-width: 760px) {
		.stage-hero {
			grid-template-columns: 1fr;
			width: calc(100% - 28px);
			max-width: 520px;
			gap: 22px;
			padding: 36px 0 84px;
		}

		.back-link {
			margin-bottom: 20px;
			font-size: 0.9rem;
		}

		.stage-copy h1 {
			font-size: 2.7rem;
			line-height: 0.94;
			word-break: break-word;
		}

		.stage-copy strong {
			font-size: 1rem;
			line-height: 1.6;
		}

		.primary-link {
			width: 100%;
			min-height: 52px;
			margin-top: 22px;
			font-size: 1.04rem;
		}

		.stage-body {
			width: calc(100% - 28px);
			max-width: 520px;
			padding-top: 34px;
			padding-bottom: 58px;
		}

		.stage-strip {
			grid-template-columns: 1fr;
			font-size: 0.86rem;
		}

		.preview-tabs {
			padding: 9px 10px;
		}

		.preview-tabs::before {
			font-size: 0.72rem;
		}

		.preview-tabs a {
			min-height: 32px;
			padding: 0 12px;
			font-size: 0.88rem;
		}

		.stage-strip span {
			padding: 8px 12px;
		}

		.stage-strip span + span {
			border-top: 1px solid rgba(255, 255, 255, 0.22);
			border-left: 0;
		}

		.body-copy p {
			font-size: 1rem;
		}

		.body-copy .lead {
			font-size: 1.12rem;
		}

		.item-row {
			grid-template-columns: 1fr;
			margin-top: 28px;
		}

		.item-row img {
			aspect-ratio: 4 / 5;
		}
	}
</style>
