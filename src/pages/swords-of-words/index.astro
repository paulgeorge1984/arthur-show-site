---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import dailyVerseVideos from '../../data/daily-verse-videos.json';
import lineScriptureVideoLinks from '../../data/line-scripture-video-links.json';
import wordOfGodBooklet from '../../data/word-of-god-booklet.json';
import bibleBookVideos from '../../data/bible-book-videos.json';

const currentBuildTime = new Date();
const allMessages = (await getCollection('daily-messages', ({ data }) => {
	return data.date <= currentBuildTime;
})).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (date: Date) => date.toLocaleDateString('ja-JP', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
});

const cleanInlineText = (value = '') => value
	.replace(/<br\s*\/?>/g, ' ')
	.replace(/<[^>]+>/g, ' ')
	.replace(/&nbsp;/g, ' ')
	.replace(/&amp;/g, '&')
	.replace(/&quot;/g, '"')
	.replace(/&#39;/g, "'")
	.replace(/\s+/g, ' ')
	.trim();

const normalizeScriptureRef = (ref = '') => ref
	.replace(/^イザヤ(?=[\s　0-9０-９])/, 'イザヤ書')
	.replace(/^ヘブル(?=[\s　0-9０-９])/, 'ヘブル人への手紙')
	.replace(/^ヨハネの第一の手紙/, 'ヨハネの手紙 第一')
	.replace(/^ヨハネ(?=[\s　0-9０-９])/, 'ヨハネの福音書')
	.replace(/^ルカ(?=[\s　0-9０-９])/, 'ルカの福音書')
	.replace(/^マタイ(?=[\s　0-9０-９])/, 'マタイの福音書')
	.replace(/^マルコ(?=[\s　0-9０-９])/, 'マルコの福音書')
	.replace(/^ローマ(?=[\s　0-9０-９])/, 'ローマ人への手紙')
	.replace(/^ピリピ(?=[\s　0-9０-９])/, 'ピリピ人への手紙')
	.replace(/^ガラテヤ(?=[\s　0-9０-９])/, 'ガラテヤ人への手紙')
	.replace(/^第一コリント人への手紙|^第一コリント|^第1コリント|^コリント人への手紙第一/, 'コリント人への手紙 第一')
	.replace(/^第二コリント人への手紙|^第二コリント|^第2コリント|^コリント人への手紙第二/, 'コリント人への手紙 第二')
	.replace(/^第一テサロニケ人への手紙|^第一テサロニケ/, 'テサロニケ人への手紙 第一')
	.replace(/\s+/g, ' ')
	.trim();

const getScriptureBook = (ref = '') => ref
	.replace(/[0-9０-９].*$/, '')
	.replace(/[　\s]+$/, '')
	.trim();

const bibleBooks = [
	'創世記', '出エジプト記', 'レビ記', '民数記', '申命記', 'ヨシュア記', '士師記', 'ルツ記',
	'サムエル記 第一', 'サムエル記 第二', '列王記 第一', '列王記 第二', '歴代誌 第一', '歴代誌 第二',
	'エズラ記', 'ネヘミヤ記', 'エステル記', 'ヨブ記', '詩篇', '箴言', '伝道者の書', '雅歌',
	'イザヤ書', 'エレミヤ書', '哀歌', 'エゼキエル書', 'ダニエル書', 'ホセア書', 'ヨエル書', 'アモス書',
	'オバデヤ書', 'ヨナ書', 'ミカ書', 'ナホム書', 'ハバクク書', 'ゼパニヤ書', 'ハガイ書', 'ゼカリヤ書', 'マラキ書',
	'マタイの福音書', 'マルコの福音書', 'ルカの福音書', 'ヨハネの福音書', '使徒の働き',
	'ローマ人への手紙', 'コリント人への手紙 第一', 'コリント人への手紙 第二', 'ガラテヤ人への手紙',
	'エペソ人への手紙', 'ピリピ人への手紙', 'コロサイ人への手紙', 'テサロニケ人への手紙 第一',
	'テサロニケ人への手紙 第二', 'テモテへの手紙 第一', 'テモテへの手紙 第二', 'テトスへの手紙',
	'ピレモンへの手紙', 'ヘブル人への手紙', 'ヤコブの手紙', 'ペテロの手紙 第一', 'ペテロの手紙 第二',
	'ヨハネの手紙 第一', 'ヨハネの手紙 第二', 'ヨハネの手紙 第三', 'ユダの手紙', 'ヨハネの黙示録',
];
const bibleBookOrder = new Map(bibleBooks.map((book, index) => [book, index]));

const normalizeMatchText = (value = '') => String(value)
	.normalize('NFKC')
	.toLowerCase()
	.replace(/[\s　。、，,.!！?？:：;；「」『』（）()【】[\]<>＜＞'"“”‘’〜～―—_・]/g, '');

const longestCommonSubstringLength = (a = '', b = '') => {
	if (!a || !b) return 0;
	let best = 0;
	const previous = new Uint16Array(b.length + 1);
	const current = new Uint16Array(b.length + 1);
	for (let i = 1; i <= a.length; i += 1) {
		for (let j = 1; j <= b.length; j += 1) {
			const value = a[i - 1] === b[j - 1] ? previous[j - 1] + 1 : 0;
			current[j] = value;
			if (value > best) best = value;
		}
		previous.set(current);
		current.fill(0);
	}
	return best;
};

const dailyVerseVideoPool = Object.values(dailyVerseVideos.videosByPage || {})
	.flat()
	.filter((video, index, videos) => video?.id && videos.findIndex((item) => item.id === video.id) === index)
	.map((video) => ({
		...video,
		normalizedQuote: normalizeMatchText(video.quote || video.title || ''),
	}));

const uniqueRelatedVideos = (videos = []) => {
	const seen = new Set();
	return videos.filter((video) => {
		const key = `${video.source || 'VIDEO'}:${video.id || video.url}`;
		if (!video?.url || seen.has(key)) return false;
		seen.add(key);
		return true;
	});
};

const scriptureBookPattern = bibleBooks
	.slice()
	.sort((a, b) => b.length - a.length)
	.map((book) => book.replace(/[.*+?^${}()|[\]\\]/g, '\\$&').replace(/\s+/g, '\\s*'))
	.join('|');

const scriptureRefPattern = new RegExp(
	`(${scriptureBookPattern})\\s*[0-9０-９]+\\s*(?:(?:章\\s*[0-9０-９]+(?:[-－ー〜～—][0-9０-９]+)?\\s*節?)|(?:[:：]\\s*[0-9０-９]+(?:[-－ー〜～—][0-9０-９]+)?)|章)`,
	'g'
);

const findRelatedDailyVideos = (text = '') => {
	const normalizedText = normalizeMatchText(text);
	if (normalizedText.length < 8) return [];
	return dailyVerseVideoPool
		.map((video) => {
			const exact = normalizedText.includes(video.normalizedQuote) || video.normalizedQuote.includes(normalizedText);
			const score = exact
				? Math.min(normalizedText.length, video.normalizedQuote.length)
				: longestCommonSubstringLength(normalizedText, video.normalizedQuote);
			const ratio = score / Math.min(normalizedText.length, video.normalizedQuote.length || 1);
			return { ...video, matchScore: score, matchRatio: ratio, matchExact: exact };
		})
		.filter((video) => video.matchExact || (video.matchScore >= 12 && video.matchRatio >= 0.45))
		.sort((a, b) => {
			if (a.matchExact !== b.matchExact) return a.matchExact ? -1 : 1;
			return b.matchScore - a.matchScore;
		})
		.slice(0, 3);
};

const messageScriptureRows = allMessages.flatMap((post) => {
	const verseBoxRows = Array.from(post.body.matchAll(/<p\s+class=["']verse-text["'][^>]*>([\s\S]*?)<\/p>\s*<span\s+class=["']verse-ref["'][^>]*>([\s\S]*?)<\/span>/g))
		.map((match) => {
			const text = cleanInlineText(match[1]);
			const ref = normalizeScriptureRef(cleanInlineText(match[2]));
			return {
				ref,
				text,
				book: getScriptureBook(ref),
				post,
			};
		})
		.filter((row) => row.ref && row.text);

	const markedRefs = Array.from(post.body.matchAll(/<span\s+class=["']msg-verse-ref["'][^>]*>([\s\S]*?)<\/span>/g))
		.map((match) => normalizeScriptureRef(cleanInlineText(match[1])))
		.filter(Boolean);

	const bodyRefs = Array.from(`${post.data.description || ''}\n${post.body}`.matchAll(scriptureRefPattern))
		.map((match) => normalizeScriptureRef(cleanInlineText(match[0]).replace(/\s*:\s*/g, ':')))
		.filter(Boolean);

	const existingRefs = new Set(verseBoxRows.map((row) => row.ref));
	const refRows = Array.from(new Set([...markedRefs, ...bodyRefs]))
		.filter((ref) => !existingRefs.has(ref))
		.map((ref) => ({
			ref,
			text: post.data.description,
			book: getScriptureBook(ref),
			post,
		}));

	return [...verseBoxRows, ...refRows].filter((row) => row.ref && row.text);
});

const extractBookletVerseText = (pageText = '', ref = '') => {
	const escaped = ref.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
	const match = pageText.match(new RegExp(`${escaped}\\s*([\\s\\S]*?)(?=\\n[^\\n]*\\s\\d|\\n\\d\\s\\d\\s\\d|$)`));
	return cleanInlineText(match?.[1] || pageText).replace(/\s*\d\s+\d\s+\d\s*$/, '').slice(0, 260);
};

const extractFullBookletRefs = (pageText = '', fallbackRefs = []) => {
	const fullRefs = Array.from(pageText.matchAll(scriptureRefPattern))
		.map((match) => normalizeScriptureRef(cleanInlineText(match[0]).replace(/\s*:\s*/g, ':')))
		.filter(Boolean);
	if (fullRefs.length) return Array.from(new Set(fullRefs));
	return Array.from(new Set(fallbackRefs.map((ref) => normalizeScriptureRef(ref)).filter(Boolean)));
};

const bookletScriptureRows = (wordOfGodBooklet.pages || []).flatMap((page) => {
	const refs = extractFullBookletRefs(page.text || '', Array.isArray(page.refs) ? page.refs : []);
	return refs.map((ref) => {
		const normalizedRef = normalizeScriptureRef(ref);
		const pageVideos = uniqueRelatedVideos([
			...(lineScriptureVideoLinks.videosByPage?.[String(page.page)] || []),
			...(dailyVerseVideos.videosByPage?.[String(page.page)] || []).map((video) => ({
				...video,
				source: 'THE DAILY',
			})),
		]);
		return {
			ref: normalizedRef,
			text: extractBookletVerseText(page.text || '', ref),
			book: getScriptureBook(normalizedRef),
			source: 'booklet',
			page: page.page,
			href: `/1000-verses/?page=${page.page}#word-of-god-booklet`,
			dateLabel: `P.${page.page}`,
			title: 'THE WORD OF GOD 1000 VERSES COLLECTION',
			relatedVideos: pageVideos,
		};
	}).filter((row) => row.ref && row.text);
});

const bibleBookVideoRows = (bibleBookVideos.videos || []).map((video) => ({
	ref: video.book,
	text: video.quote || video.title,
	book: video.book,
	source: 'bible-book-video',
	href: video.url,
	dateLabel: '66 BOOKS',
	title: 'THE DAILY with Arthur Hollands from 66 books of the Bible',
	relatedVideos: [video],
})).filter((row) => row.ref && row.text && row.relatedVideos.length);

const rawScriptureRows = [
	...messageScriptureRows.map((row) => ({
		...row,
		source: 'message',
		href: `/messages/${row.post.slug}`,
		dateLabel: formatDate(row.post.data.date),
		title: row.post.data.title,
		relatedVideos: findRelatedDailyVideos(row.text),
	})),
	...bookletScriptureRows,
	...bibleBookVideoRows,
];

const scriptureRows = rawScriptureRows
	.filter((row) => Array.isArray(row.relatedVideos) && row.relatedVideos.length > 0)
	.map((row, index) => ({
		...row,
		isRecent: index < 12,
	}));
const scriptureBooks = Array.from(new Set(scriptureRows.map((row) => row.book).filter(Boolean)))
	.sort((a, b) => {
		const orderA = bibleBookOrder.get(a) ?? 999;
		const orderB = bibleBookOrder.get(b) ?? 999;
		return orderA === orderB ? a.localeCompare(b, 'ja') : orderA - orderB;
	});
const oldTestamentBooks = scriptureBooks.filter((book) => (bibleBookOrder.get(book) ?? 999) < 39);
const newTestamentBooks = scriptureBooks.filter((book) => (bibleBookOrder.get(book) ?? 999) >= 39);
---

<Layout
	title="THE SWORDS OF WORDS"
	description="御言葉からアーサー・ホーランドのメッセージを探す索引。"
>
	<main class="swords-page">
		<section class="scripture-section" id="scripture-index" aria-labelledby="scripture-title">
			<div class="swords-banner" aria-hidden="true">
				<img src="/assets/generated/swords-of-words-banner.webp" alt="" loading="eager" />
			</div>
			<div class="section-bar scripture-bar">
				<div>
					<p class="section-kicker">御言葉から探す</p>
					<h1 id="scripture-title">THE SWORDS OF WORDS</h1>
				</div>
				<p class="archive-count">{scriptureRows.length}件</p>
			</div>

			<figure class="swords-feature-image" aria-hidden="true">
				<img src="/assets/generated/swords-of-words-banner.webp" alt="" loading="eager" />
			</figure>

			<div class="scripture-quick" aria-label="聖句表示切り替え">
				<button class="scripture-filter active" type="button" data-scripture-filter="recent">最近の御言葉</button>
				<button class="scripture-filter" type="button" data-scripture-filter="all">すべて</button>
			</div>

			<details class="scripture-book-index" open>
				<summary>66巻順で探す</summary>
				<div class="book-index-columns">
					<div class="book-index-group">
						<h2>OLD TESTAMENT</h2>
						<div class="book-index-grid">
							{oldTestamentBooks.map((book) => (
								<button class="scripture-filter" type="button" data-scripture-filter={book}>{book}</button>
							))}
						</div>
					</div>
					<div class="book-index-group">
						<h2>NEW TESTAMENT</h2>
						<div class="book-index-grid">
							{newTestamentBooks.map((book) => (
								<button class="scripture-filter" type="button" data-scripture-filter={book}>{book}</button>
							))}
						</div>
					</div>
				</div>
			</details>

			<div class="scripture-grid" data-scripture-list>
				{scriptureRows.map((row) => (
					<article
						class="scripture-card"
						data-scripture-card
						data-scripture-book={row.book}
						data-scripture-recent={row.isRecent ? 'true' : 'false'}
						hidden={!row.isRecent}
					>
						<a class="scripture-message-link" href={row.href}>
							<span class="scripture-ref">{row.ref}</span>
							<q>{row.text}</q>
							<span class="scripture-meta">
								<span>{row.dateLabel}</span>
								<strong>{row.title}</strong>
							</span>
						</a>
						{row.relatedVideos.length > 0 && (
							<div class="scripture-related" aria-label={`${row.ref}に関連するデイリーメッセージ`}>
								<span class="scripture-related-label">RELATED MESSAGES</span>
								{row.relatedVideos.slice(0, 2).map((video) => (
									<a class="scripture-video-link" href={video.url} target="_blank" rel="noopener noreferrer">
										<img src={video.thumbnail} alt="" loading="lazy" />
										<span>
											<strong>{video.title}</strong>
											<small>{video.quote || video.source || 'RELATED MESSAGE'}</small>
										</span>
									</a>
								))}
							</div>
						)}
					</article>
				))}
			</div>
			<p class="no-results" data-scripture-empty hidden>該当する御言葉がありません。</p>

		</section>
	</main>

	<script is:inline>
		const scriptureCards = Array.from(document.querySelectorAll('[data-scripture-card]'));
		const scriptureFilters = Array.from(document.querySelectorAll('[data-scripture-filter]'));
		const scriptureEmpty = document.querySelector('[data-scripture-empty]');

		function applyScriptureFilter(book) {
			let visible = 0;
			scriptureCards.forEach((card) => {
				const show = book === 'all'
					|| (book === 'recent' && card.dataset.scriptureRecent === 'true')
					|| card.dataset.scriptureBook === book;
				card.hidden = !show;
				if (show) visible += 1;
			});
			if (scriptureEmpty) scriptureEmpty.hidden = visible !== 0;
		}

		scriptureFilters.forEach((button) => {
			button.addEventListener('click', () => {
				const book = button.dataset.scriptureFilter || 'recent';
				scriptureFilters.forEach((b) => b.classList.toggle('active', b === button));
				applyScriptureFilter(book);
			});
		});
	</script>
</Layout>

<style>
	.swords-page {
		max-width: 1080px;
		margin: 0 auto;
		padding: 0 20px 46px;
	}

	.scripture-section {
		position: relative;
		padding: 28px;
		overflow: hidden;
		background:
			radial-gradient(circle at 80% 0%, rgba(197, 160, 89, 0.24), transparent 28%),
			linear-gradient(115deg, transparent 0 24%, rgba(255, 255, 255, 0.08) 24% 25%, transparent 25% 100%),
			linear-gradient(135deg, #090909 0%, #16110c 48%, #050505 100%);
		color: #fff;
		border: 1px solid rgba(197, 160, 89, 0.5);
		border-left: 8px solid #c5a059;
		box-shadow: inset 0 0 0 3px rgba(255, 255, 255, 0.04), 0 22px 46px rgba(0, 0, 0, 0.16);
	}

	.scripture-section::before {
		content: "";
		position: absolute;
		top: 38px;
		right: -64px;
		width: min(58vw, 700px);
		height: 32px;
		background:
			linear-gradient(90deg, transparent 0 8%, #050505 8% 11%, #c5a059 11% 14%, #f7f7f7 14% 45%, #bfc3c8 45% 48%, #ffffff 48% 84%, #8f949b 84% 100%);
		clip-path: polygon(0 42%, 86% 42%, 100% 50%, 86% 58%, 0 58%);
		opacity: 0.9;
		pointer-events: none;
	}

	.scripture-section::after {
		content: "";
		position: absolute;
		inset: 16px;
		border: 1px solid rgba(255, 255, 255, 0.16);
		pointer-events: none;
	}

	.swords-banner {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
	}

	.swords-banner img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		opacity: 0.42;
		filter: saturate(1.08) contrast(1.12);
	}

	.swords-banner::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.72) 52%, rgba(0, 0, 0, 0.56) 100%),
			linear-gradient(180deg, rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.86));
	}

	.section-bar {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 18px;
		margin-bottom: 18px;
		padding: 16px 0 20px;
		border-bottom: 3px solid #c5a059;
	}

	.section-kicker {
		color: #c5a059;
		font-family: 'Oswald', sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.scripture-bar h1 {
		max-width: 760px;
		color: #f7f7f7;
		font-family: 'Oswald', sans-serif;
		font-size: clamp(2.4rem, 7vw, 4.4rem);
		line-height: 0.95;
		text-shadow: 3px 3px 0 #000, 5px 5px 0 rgba(197, 160, 89, 0.42);
	}

	.archive-count {
		flex: 0 0 auto;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.9rem;
		font-weight: 900;
	}

	.swords-feature-image {
		position: relative;
		z-index: 1;
		aspect-ratio: 21 / 7;
		margin-bottom: 18px;
		overflow: hidden;
		border: 1px solid rgba(197, 160, 89, 0.6);
		border-bottom: 5px solid #c5a059;
		background: #050505;
		box-shadow: 10px 10px 0 rgba(197, 160, 89, 0.18);
	}

	.swords-feature-image::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, rgba(0, 0, 0, 0.64), transparent 38%, rgba(0, 0, 0, 0.28)),
			linear-gradient(180deg, transparent 45%, rgba(0, 0, 0, 0.66));
		pointer-events: none;
	}

	.swords-feature-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 42%;
		filter: saturate(1.12) contrast(1.08);
	}

	.scripture-quick {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 10px;
	}

	.scripture-book-index {
		position: relative;
		z-index: 1;
		margin-bottom: 18px;
		background:
			linear-gradient(90deg, rgba(197, 160, 89, 0.18) 0 2px, transparent 2px 12px),
			rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(197, 160, 89, 0.5);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
	}

	.scripture-book-index summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 42px;
		padding: 0 14px;
		background: #050505;
		color: #fff;
		border-bottom: 3px solid #c5a059;
		font-family: 'Oswald', sans-serif;
		font-size: 0.95rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		cursor: pointer;
	}

	.scripture-book-index summary::after {
		content: "+";
		color: #c5a059;
		font-size: 1.2rem;
	}

	.scripture-book-index[open] summary::after {
		content: "-";
	}

	.book-index-columns {
		display: grid;
