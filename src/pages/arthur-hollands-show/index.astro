---
import Layout from '../../layouts/Layout.astro';
import archive from '../../data/arthur-show-archive.json';
import seriesArchive from '../../data/arthur-show-series.json';

type ShowVideo = {
	id: string;
	title: string;
	description?: string;
	excerpt?: string;
	publishedAt?: string;
	year?: string;
	thumbnail?: string;
	duration?: string;
	viewCount?: string;
};

type ShowSeries = {
	slug: string;
	kind: string;
	label: string;
	title: string;
	description: string;
	playlistId: string;
	url: string;
	count: number;
	countLabel?: string;
	videos: ShowVideo[];
};

const archiveData = archive as {
	fetchedAt: string | null;
	playlist: { id: string; title: string; url: string };
	videos: ShowVideo[];
};
const seriesData = seriesArchive as { fetchedAt: string | null; playlists: ShowSeries[] };

const videos = archiveData.videos || [];
const excludedSeriesPlaylistIds = new Set(['PL-faIdjPoxKiA5aStAASg7VMrjT_-90_o']);
const showSeries = (seriesData.playlists || []).filter((series) => !excludedSeriesPlaylistIds.has(series.playlistId));
const paintingSeries = showSeries.find((series) => series.kind === 'painting');
const relatedSeries = showSeries.filter((series) => series.kind !== 'painting');
const years = Array.from(new Set(videos.map((video) => video.year || 'ARCHIVE'))).sort((a, b) => {
	if (a === 'ARCHIVE') return 1;
	if (b === 'ARCHIVE') return -1;
	return Number(b) - Number(a);
});
const yearCounts = new Map(years.map((year) => [year, videos.filter((video) => (video.year || 'ARCHIVE') === year).length]));
const walkAcrossUsa2014Archive = {
	year: '2014',
	title: 'WALK ACROSS USA 2014',
	description: 'Chadさん制作による、2014年のアメリカ横断十字架行進の記録映像アーカイブ。',
	url: '/walk-across-usa2014/',
	thumbnail: 'https://i.ytimg.com/vi/xCH4c1yXnhw/hqdefault.jpg',
	count: 76,
};
const displayYears = years.includes(walkAcrossUsa2014Archive.year)
	? years
	: [...years, walkAcrossUsa2014Archive.year];
const getYearCountLabel = (year: string) => {
	if (year === walkAcrossUsa2014Archive.year) return `${walkAcrossUsa2014Archive.count} VIDEOS`;
	return `${yearCounts.get(year)} EPISODES`;
};
const getYearNavCount = (year: string) => {
	if (year === walkAcrossUsa2014Archive.year) return walkAcrossUsa2014Archive.count;
	return yearCounts.get(year);
};
const totalHours = Math.round(videos.reduce((total, video) => {
	const match = String(video.duration || '').match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
	if (!match) return total;
	const hours = Number(match[1] || 0);
	const minutes = Number(match[2] || 0);
	const seconds = Number(match[3] || 0);
	return total + hours + minutes / 60 + seconds / 3600;
}, 0));

const formatDate = (value?: string) => {
	if (!value) return '';
	const date = new Date(value);
	if (Number.isNaN(date.valueOf())) return '';
	return new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date);
};
const formatDuration = (value?: string) => {
	const match = String(value || '').match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
	if (!match) return '';
	const hours = Number(match[1] || 0);
	const minutes = Number(match[2] || 0);
	const seconds = Number(match[3] || 0);
	if (hours) return `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
	return `${minutes}:${String(seconds).padStart(2, '0')}`;
};
const formatViews = (value?: string) => {
	const count = Number(value || 0);
	if (!count) return '';
	return new Intl.NumberFormat('ja-JP').format(count);
};
const pickupItems = videos.map((video) => ({
	id: video.id,
	title: video.title,
	excerpt: video.excerpt || video.description || '',
	url: `https://youtu.be/${video.id}`,
	thumbnail: video.thumbnail || `https://i.ytimg.com/vi/${video.id}/hq720.jpg`,
	meta: [
		video.year || '',
		formatDate(video.publishedAt),
		formatDuration(video.duration),
	].filter(Boolean).join(' / '),
	views: formatViews(video.viewCount),
}));
const socialImage = pickupItems[0]?.id
	? `https://i.ytimg.com/vi/${pickupItems[0].id}/hq720.jpg`
	: '/og-image.jpg';
---

<Layout
	title="THE ARTHUR HOLLANDS SHOW"
	description="毎週水曜14:00、生配信で語られてきたチャンネルの原点となる生配信番組 THE ARTHUR HOLLANDS SHOW の記録。社会・文化・聖書・人生を貫くジーザスの真理を、アーサーホーランドが力強く宣べ伝えます。"
	image={socialImage}
	imageAlt="THE ARTHUR HOLLANDS SHOW 最新メッセージ サムネイル"
	imageWidth={1280}
	imageHeight={720}
>
	<article class="show-page">
		<header class="show-hero">
			<div class="hero-copy">
				<p class="broadcast-label">LIVE PROGRAM ARCHIVE</p>
				<h1>THE ARTHUR HOLLANDS SHOW</h1>
				<p class="hero-lead">
					毎週水曜14:00、生配信で語られてきたチャンネルの原点となる生配信番組の記録。<br />
					社会・文化・聖書・人生を貫くジーザスの真理を、アーサーホーランドが力強く宣べ伝えます。
				</p>
				<div class="hero-actions">
					<a href="#episodes">EPISODES</a>
					<a href={archiveData.playlist.url} target="_blank" rel="noopener noreferrer">YOUTUBE</a>
				</div>
			</div>
		</header>

		{pickupItems.length > 0 && (
			<section class="featured-broadcast" aria-labelledby="featured-broadcast-title">
				<div class="featured-thumb">
					<img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" alt="" loading="lazy" data-pickup-thumb />
				</div>
				<div class="featured-body">
					<p class="broadcast-label">ARCHIVE PICKUP</p>
					<h2 id="featured-broadcast-title" data-pickup-title>NOW SELECTING...</h2>
					<p class="pickup-meta" data-pickup-meta></p>
					<p data-pickup-excerpt></p>
					<div class="pickup-actions">
						<a href={archiveData.playlist.url} target="_blank" rel="noopener noreferrer" data-pickup-link>この回を見る</a>
						<button type="button" data-pickup-random>別の回を出す</button>
					</div>
				</div>
			</section>
		)}

		<section class="show-intro" aria-label="番組概要">
			<div class="intro-card primary">
				<p>PROGRAM</p>
				<h2>社会、文化、聖書、人生を貫いて語られた言葉。</h2>
				<span>
					約1時間から1時間20分の生配信として積み重ねられたアーカイブを、年ごとの流れと各回の映像でたどれます。
				</span>
			</div>
			<div class="intro-card">
				<p>ARCHIVE</p>
				<strong>{videos.length}</strong>
				<span>episodes</span>
			</div>
			<div class="intro-card">
				<p>VOLUME</p>
				<strong>{totalHours || '100+'}</strong>
				<span>hours</span>
			</div>
		</section>

		{paintingSeries && (
			<section class="painting-series" aria-labelledby="painting-title">
				<div class="painting-copy">
					<p class="broadcast-label">{paintingSeries.label}</p>
					<h2 id="painting-title">{paintingSeries.title}</h2>
					<p>{paintingSeries.description}</p>
					<div class="painting-actions">
						<a href={paintingSeries.url} target="_blank" rel="noopener noreferrer">シリーズを開く</a>
						<span>{paintingSeries.count} EPISODES</span>
					</div>
				</div>
				<div class="painting-episodes">
					{paintingSeries.videos.slice(0, 6).map((video) => (
						<a href={`https://youtu.be/${video.id}`} target="_blank" rel="noopener noreferrer">
							<img src={video.thumbnail || `https://i.ytimg.com/vi/${video.id}/hq720.jpg`} alt={`${video.title} サムネイル`} loading="lazy" />
							<strong>{video.title}</strong>
						</a>
					))}
				</div>
			</section>
		)}

		{relatedSeries.length > 0 && (
			<section class="series-section" aria-labelledby="series-title">
				<div class="series-heading">
					<p class="broadcast-label">SPECIAL SERIES</p>
					<h2 id="series-title">対談・講演・特別アーカイブ</h2>
				</div>
				<div class="series-grid">
					{relatedSeries.map((series) => {
						const firstVideo = series.videos[0];
						return (
							<a class="series-card" href={series.url} target="_blank" rel="noopener noreferrer">
								<span class="series-thumb">
									{firstVideo && (
										<img src={firstVideo.thumbnail || `https://i.ytimg.com/vi/${firstVideo.id}/hq720.jpg`} alt={`${series.title} サムネイル`} loading="lazy" />
									)}
								</span>
								<span class="series-body">
									<small>{series.label}</small>
									<strong>{series.title}</strong>
									<span>{series.description}</span>
									<em>{series.countLabel || `${series.count} EPISODES`}</em>
								</span>
							</a>
						);
					})}
				</div>
			</section>
		)}

		<section class="share-section" id="share" aria-labelledby="share-title">
			<h2 id="share-title">このページをシェアする</h2>
			<div class="share-grid" aria-label="SNS共有ボタン">
				<button class="share-card primary-share" type="button" data-share-native>
					<span>スマホで共有</span>
				</button>
				<a class="share-card line" href="https://line.me/R/msg/text/?THE%20ARTHUR%20HOLLANDS%20SHOW%0Ahttps%3A%2F%2Farthur-show.com%2Farthur-hollands-show%2F" data-share-line target="_blank" rel="noreferrer">
					<span>LINE</span>
				</a>
				<a class="share-card x" href="https://twitter.com/intent/tweet?text=THE%20ARTHUR%20HOLLANDS%20SHOW&url=https%3A%2F%2Farthur-show.com%2Farthur-hollands-show%2F" data-share-x target="_blank" rel="noreferrer">
					<span>X</span>
				</a>
				<a class="share-card facebook" href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Farthur-show.com%2Farthur-hollands-show%2F" data-share-facebook target="_blank" rel="noreferrer">
					<span>Facebook</span>
				</a>
				<button class="share-card instagram" type="button" data-copy-link>
					<span>Instagram</span>
				</button>
				<button class="share-card copy" type="button" data-copy-link>
					<span>リンクコピー</span>
					<small data-copy-status>URLをクリップボードへ</small>
				</button>
			</div>
		</section>

		<section class="episode-section" id="episodes" aria-labelledby="episodes-title">
			<div class="episode-heading">
				<div>
					<p class="broadcast-label">BROADCAST LIST</p>
					<h2 id="episodes-title">EPISODES</h2>
				</div>
				<label class="episode-search">
					<span>検索</span>
					<input type="search" placeholder="タイトルで探す" data-show-search />
				</label>
			</div>
			<div class="year-nav" aria-label="年別ジャンプ">
				<a href="#episodes" data-show-year="all">ALL <small>{videos.length}</small></a>
				{displayYears.map((year) => (
					<a href={`#year-${year}`} data-show-year={year}>{year}<small>{getYearNavCount(year)}</small></a>
				))}
			</div>

			<div class="episode-list" data-show-list>
				{displayYears.map((year) => {
					const yearVideos = videos.filter((video) => (video.year || 'ARCHIVE') === year);
					const showWalkAcrossArchive = year === walkAcrossUsa2014Archive.year;
					return (
						<section class="year-block" id={`year-${year}`} data-year-block={year}>
							<div class="year-title">
								<span>{year}</span>
								<strong>{getYearCountLabel(year)}</strong>
							</div>
							<div class="episode-grid">
								{showWalkAcrossArchive && (
									<a
										class="episode-card"
										href={walkAcrossUsa2014Archive.url}
										data-year={year}
										data-search={`${walkAcrossUsa2014Archive.title} ${walkAcrossUsa2014Archive.description} chad 2014 walk across usa`.toLowerCase()}
									>
										<span class="episode-thumb">
											<img src={walkAcrossUsa2014Archive.thumbnail} alt={`${walkAcrossUsa2014Archive.title} サムネイル`} loading="lazy" />
										</span>
										<span class="episode-body">
											<span class="episode-meta">2014 / {walkAcrossUsa2014Archive.count} VIDEOS / Chadさん制作</span>
											<strong>{walkAcrossUsa2014Archive.title}</strong>
											<small>{walkAcrossUsa2014Archive.description}</small>
											<em>特設アーカイブを見る</em>
										</span>
									</a>
								)}
								{yearVideos.map((video, index) => (
									<a
										class="episode-card"
										href={`https://youtu.be/${video.id}`}
										target="_blank"
										rel="noopener noreferrer"
										data-year={year}
										data-search={`${video.title} ${video.excerpt || ''}`.toLowerCase()}
									>
										<span class="episode-thumb">
											<img src={video.thumbnail || `https://i.ytimg.com/vi/${video.id}/hq720.jpg`} alt={`${video.title} サムネイル`} loading="lazy" />
										</span>
										<span class="episode-body">
											<span class="episode-meta">
												{String(index + 1).padStart(2, '0')}
												{formatDate(video.publishedAt) && ` / ${formatDate(video.publishedAt)}`}
												{formatDuration(video.duration) && ` / ${formatDuration(video.duration)}`}
											</span>
											<strong>{video.title}</strong>
											{video.excerpt && <small>{video.excerpt}</small>}
											{formatViews(video.viewCount) && <em>{formatViews(video.viewCount)} views</em>}
										</span>
									</a>
								))}
							</div>
						</section>
					);
				})}
			</div>
			<p class="no-results" data-show-no-results hidden>該当する映像がありません。</p>
		</section>
	</article>

	<script type="application/json" data-pickup-items set:html={JSON.stringify(pickupItems)}></script>
	<script is:inline>
		const pickupItems = JSON.parse(document.querySelector('[data-pickup-items]')?.textContent || '[]');
		const shareTitle = 'THE ARTHUR HOLLANDS SHOW';
		const shareText = 'THE ARTHUR HOLLANDS SHOWのメッセージアーカイブ。';
		const shareUrl = 'https://arthur-show.com/arthur-hollands-show/?share=20260602';
		const searchInput = document.querySelector('[data-show-search]');
		const episodeCards = Array.from(document.querySelectorAll('[data-show-list] .episode-card'));
		const yearButtons = Array.from(document.querySelectorAll('[data-show-year]'));
		const yearBlocks = Array.from(document.querySelectorAll('[data-year-block]'));
		const noResults = document.querySelector('[data-show-no-results]');
		let activeYear = 'all';
		let currentPickupIndex = -1;

		function updateShareLinks() {
			const encodedUrl = encodeURIComponent(shareUrl);
			const encodedText = encodeURIComponent(`${shareTitle}\n${shareText}`);
			const encodedLineText = encodeURIComponent(`${shareTitle}\n${shareText}\n${shareUrl}`);
			const line = document.querySelector('[data-share-line]');
			const x = document.querySelector('[data-share-x]');
			const facebook = document.querySelector('[data-share-facebook]');
			if (line) line.href = `https://line.me/R/msg/text/?${encodedLineText}`;
			if (x) x.href = `https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}`;
			if (facebook) facebook.href = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
		}

		async function copyShareLink() {
			const statusItems = document.querySelectorAll('[data-copy-status]');
			try {
				await navigator.clipboard.writeText(`${shareTitle}\n${shareText}\n${shareUrl}`);
				statusItems.forEach((item) => {
					item.textContent = 'コピーしました';
				});
				setTimeout(() => {
					statusItems.forEach((item) => {
						item.textContent = 'URLをクリップボードへ';
					});
				}, 1800);
			} catch {
				window.prompt('この内容をコピーしてください', `${shareTitle}\n${shareText}\n${shareUrl}`);
			}
		}

		async function sharePage() {
			if (navigator.share) {
				try {
					await navigator.share({ title: shareTitle, text: shareText, url: shareUrl });
					return;
				} catch (error) {
					if (error.name === 'AbortError') return;
				}
			}
			await copyShareLink();
		}

		function applyFilters() {
			const query = (searchInput?.value || '').trim().toLowerCase();
			let visible = 0;
			episodeCards.forEach((card) => {
				const yearOk = activeYear === 'all' || card.dataset.year === activeYear;
				const searchOk = !query || (card.dataset.search || '').includes(query);
				const show = yearOk && searchOk;
				card.hidden = !show;
				if (show) visible += 1;
			});
			yearBlocks.forEach((block) => {
				const cards = Array.from(block.querySelectorAll('.episode-card'));
				block.hidden = cards.every((card) => card.hidden);
			});
			if (noResults) noResults.hidden = visible !== 0;
		}

		function renderPickup(index) {
			const item = pickupItems[index];
			if (!item) return;
			const thumb = document.querySelector('[data-pickup-thumb]');
			const title = document.querySelector('[data-pickup-title]');
			const meta = document.querySelector('[data-pickup-meta]');
			const excerpt = document.querySelector('[data-pickup-excerpt]');
			const link = document.querySelector('[data-pickup-link]');
			if (thumb) {
				thumb.src = item.thumbnail;
				thumb.alt = `${item.title} サムネイル`;
			}
			if (title) title.textContent = item.title;
			if (meta) meta.textContent = item.meta || '';
			if (excerpt) excerpt.textContent = item.excerpt || '';
			if (link) link.href = item.url;
		}

		function showRandomPickup() {
			if (!pickupItems.length) return;
			let nextIndex = Math.floor(Math.random() * pickupItems.length);
			if (pickupItems.length > 1) {
				while (nextIndex === currentPickupIndex) {
					nextIndex = Math.floor(Math.random() * pickupItems.length);
				}
			}
			currentPickupIndex = nextIndex;
			renderPickup(currentPickupIndex);
		}

		yearButtons.forEach((button) => {
			button.addEventListener('click', (event) => {
				event.preventDefault();
				activeYear = button.dataset.showYear || 'all';
				yearButtons.forEach((item) => item.classList.toggle('active', item === button));
				applyFilters();
				document.querySelector('#episodes')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			});
		});
		searchInput?.addEventListener('input', applyFilters);
		document.querySelectorAll('[data-share-native]').forEach((button) => {
			button.addEventListener('click', sharePage);
		});
		document.querySelectorAll('[data-copy-link]').forEach((button) => {
			button.addEventListener('click', copyShareLink);
		});
		document.querySelector('[data-pickup-random]')?.addEventListener('click', showRandomPickup);
		showRandomPickup();
		yearButtons[0]?.classList.add('active');
		updateShareLinks();
	</script>
</Layout>

<style>
	.show-page {
		--show-bg: #11100e;
		--show-panel: #1b1916;
		--show-gold: #c5a059;
		--show-red: #b63b32;
		background: var(--show-bg);
		color: #f7f0e4;
		margin: -22px 0 -80px;
		padding: 0 20px 90px;
	}

	.show-hero,
	.show-intro,
	.painting-series,
	.series-section,
	.featured-broadcast,
	.share-section,
	.episode-section {
		max-width: 1180px;
		margin: 0 auto;
	}

	.show-hero {
		min-height: 48vh;
		display: grid;
		align-items: end;
		padding: 78px 0 30px;
	}

	.broadcast-label {
		color: var(--show-gold);
		font-family: var(--font-head);
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.18em;
	}

	.hero-copy h1 {
		margin-top: 10px;
		font-family: var(--font-head);
		font-size: clamp(3.55rem, 7vw, 7.2rem);
		font-weight: 900;
		letter-spacing: 0.01em;
		line-height: 0.86;
		overflow-wrap: anywhere;
	}

	.hero-lead {
		max-width: 820px;
		margin-top: 24px;
		color: rgba(247, 240, 228, 0.82);
		font-family: var(--font-serif);
		font-size: clamp(1.08rem, 2.1vw, 1.45rem);
		font-weight: 700;
		line-height: 1.8;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 28px;
	}

	.hero-actions a,
	.featured-body a,
	.featured-body button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0 18px;
		border: 1px solid rgba(197, 160, 89, 0.8);
		background: rgba(197, 160, 89, 0.12);
		color: #fff;
		font-family: var(--font-head);
		font-weight: 900;
		letter-spacing: 0.08em;
		cursor: pointer;
	}

	.hero-actions a:hover,
	.featured-body a:hover,
	.featured-body button:hover {
		background: var(--show-gold);
		color: #11100e;
	}

	.show-intro {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(170px, 0.45fr));
		gap: 14px;
		padding-top: 34px;
	}

	.intro-card {
		padding: 24px;
		background: rgba(255, 255, 255, 0.055);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.intro-card p {
		color: var(--show-gold);
		font-family: var(--font-head);
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.16em;
