---
import Layout from '../../layouts/Layout.astro';
import archive from '../../data/arthur-show-archive.json';

type ShowVideo = {
	id: string;
	title: string;
	description?: string;
	excerpt?: string;
	publishedAt?: string;
	year?: string;
	thumbnail?: string;
	duration?: string;
	viewCount?: string;
};

const archiveData = archive as {
	fetchedAt: string | null;
	playlist: { id: string; title: string; url: string };
	videos: ShowVideo[];
};

const videos = archiveData.videos || [];
const featuredVideo = videos[0];
const playlistEmbedUrl = `https://www.youtube.com/embed/videoseries?list=${archiveData.playlist.id}&rel=0`;
const years = Array.from(new Set(videos.map((video) => video.year || 'ARCHIVE'))).sort((a, b) => {
	if (a === 'ARCHIVE') return 1;
	if (b === 'ARCHIVE') return -1;
	return Number(b) - Number(a);
});
const yearCounts = new Map(years.map((year) => [year, videos.filter((video) => (video.year || 'ARCHIVE') === year).length]));
const totalHours = Math.round(videos.reduce((total, video) => {
	const match = String(video.duration || '').match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
	if (!match) return total;
	const hours = Number(match[1] || 0);
	const minutes = Number(match[2] || 0);
	const seconds = Number(match[3] || 0);
	return total + hours + minutes / 60 + seconds / 3600;
}, 0));

const formatDate = (value?: string) => {
	if (!value) return '';
	const date = new Date(value);
	if (Number.isNaN(date.valueOf())) return '';
	return new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date);
};
const formatDuration = (value?: string) => {
	const match = String(value || '').match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
	if (!match) return '';
	const hours = Number(match[1] || 0);
	const minutes = Number(match[2] || 0);
	const seconds = Number(match[3] || 0);
	if (hours) return `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
	return `${minutes}:${String(seconds).padStart(2, '0')}`;
};
const formatViews = (value?: string) => {
	const count = Number(value || 0);
	if (!count) return '';
	return new Intl.NumberFormat('ja-JP').format(count);
};
---

<Layout
	title="THE ARTHUR HOLLANDS SHOW"
	description="毎週水曜14:00から届けられてきた生配信番組 THE ARTHUR HOLLANDS SHOW のアーカイブ。社会、文化、聖書、人生を貫くメッセージを映像でたどるページです。"
>
	<article class="show-page">
		<header class="show-hero">
			<div class="hero-copy">
				<p class="broadcast-label">LIVE PROGRAM ARCHIVE</p>
				<h1>THE ARTHUR HOLLANDS SHOW</h1>
				<p class="hero-lead">毎週水曜14:00から届けられてきた、チャンネル名の原点となる生配信番組の記録。</p>
				<div class="hero-actions">
					<a href="#episodes">EPISODES</a>
					<a href={archiveData.playlist.url} target="_blank" rel="noopener noreferrer">YOUTUBE</a>
				</div>
			</div>
			<div class="hero-screen">
				<div class="screen-frame">
					<iframe
						src={playlistEmbedUrl}
						title="THE ARTHUR HOLLANDS SHOW playlist"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					></iframe>
				</div>
				<div class="screen-caption">
					<span>ON AIR ARCHIVE</span>
					<strong>{videos.length} EPISODES</strong>
				</div>
			</div>
		</header>

		<section class="show-intro" aria-label="番組概要">
			<div class="intro-card primary">
				<p>PROGRAM</p>
				<h2>社会、文化、聖書、人生を貫いて語られた言葉。</h2>
				<span>
					約1時間から1時間20分の生配信として積み重ねられたアーカイブを、年ごとの流れと各回の映像でたどれます。
				</span>
			</div>
			<div class="intro-card">
				<p>ARCHIVE</p>
				<strong>{videos.length}</strong>
				<span>episodes</span>
			</div>
			<div class="intro-card">
				<p>VOLUME</p>
				<strong>{totalHours || '100+'}</strong>
				<span>hours</span>
			</div>
		</section>

		{featuredVideo && (
			<section class="featured-broadcast" aria-labelledby="featured-broadcast-title">
				<div class="featured-thumb">
					<img src={featuredVideo.thumbnail || `https://i.ytimg.com/vi/${featuredVideo.id}/hq720.jpg`} alt={`${featuredVideo.title} サムネイル`} loading="lazy" />
				</div>
				<div class="featured-body">
					<p class="broadcast-label">LATEST IN PLAYLIST</p>
					<h2 id="featured-broadcast-title">{featuredVideo.title}</h2>
					{featuredVideo.excerpt && <p>{featuredVideo.excerpt}</p>}
					<a href={`https://youtu.be/${featuredVideo.id}`} target="_blank" rel="noopener noreferrer">この回を見る</a>
				</div>
			</section>
		)}

		<section class="share-section" id="share" aria-labelledby="share-title">
			<h2 id="share-title">このページをシェアする</h2>
			<div class="share-grid" aria-label="SNS共有ボタン">
				<button class="share-card primary-share" type="button" data-share-native>
					<span>スマホで共有</span>
				</button>
				<a class="share-card line" href="https://line.me/R/msg/text/?THE%20ARTHUR%20HOLLANDS%20SHOW%0Ahttps%3A%2F%2Farthur-show.com%2Farthur-hollands-show%2F" data-share-line target="_blank" rel="noreferrer">
					<span>LINE</span>
				</a>
				<a class="share-card x" href="https://twitter.com/intent/tweet?text=THE%20ARTHUR%20HOLLANDS%20SHOW&url=https%3A%2F%2Farthur-show.com%2Farthur-hollands-show%2F" data-share-x target="_blank" rel="noreferrer">
					<span>X</span>
				</a>
				<a class="share-card facebook" href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Farthur-show.com%2Farthur-hollands-show%2F" data-share-facebook target="_blank" rel="noreferrer">
					<span>Facebook</span>
				</a>
				<button class="share-card instagram" type="button" data-copy-link>
					<span>Instagram</span>
				</button>
				<button class="share-card copy" type="button" data-copy-link>
					<span>リンクコピー</span>
					<small data-copy-status>URLをクリップボードへ</small>
				</button>
			</div>
		</section>

		<section class="episode-section" id="episodes" aria-labelledby="episodes-title">
			<div class="episode-heading">
				<div>
					<p class="broadcast-label">BROADCAST LIST</p>
					<h2 id="episodes-title">EPISODES</h2>
				</div>
				<label class="episode-search">
					<span>検索</span>
					<input type="search" placeholder="タイトルで探す" data-show-search />
				</label>
			</div>
			<div class="year-nav" aria-label="年別ジャンプ">
				<a href="#episodes" data-show-year="all">ALL <small>{videos.length}</small></a>
				{years.map((year) => (
					<a href={`#year-${year}`} data-show-year={year}>{year}<small>{yearCounts.get(year)}</small></a>
				))}
			</div>

			<div class="episode-list" data-show-list>
				{years.map((year) => (
					<section class="year-block" id={`year-${year}`} data-year-block={year}>
						<div class="year-title">
							<span>{year}</span>
							<strong>{yearCounts.get(year)} EPISODES</strong>
						</div>
						<div class="episode-grid">
							{videos
								.filter((video) => (video.year || 'ARCHIVE') === year)
								.map((video, index) => (
									<a
										class="episode-card"
										href={`https://youtu.be/${video.id}`}
										target="_blank"
										rel="noopener noreferrer"
										data-year={year}
										data-search={`${video.title} ${video.excerpt || ''}`.toLowerCase()}
									>
										<span class="episode-thumb">
											<img src={video.thumbnail || `https://i.ytimg.com/vi/${video.id}/hq720.jpg`} alt={`${video.title} サムネイル`} loading="lazy" />
										</span>
										<span class="episode-body">
											<span class="episode-meta">
												{String(index + 1).padStart(2, '0')}
												{formatDate(video.publishedAt) && ` / ${formatDate(video.publishedAt)}`}
												{formatDuration(video.duration) && ` / ${formatDuration(video.duration)}`}
											</span>
											<strong>{video.title}</strong>
											{video.excerpt && <small>{video.excerpt}</small>}
											{formatViews(video.viewCount) && <em>{formatViews(video.viewCount)} views</em>}
										</span>
									</a>
								))}
						</div>
					</section>
				))}
			</div>
			<p class="no-results" data-show-no-results hidden>該当する映像がありません。</p>
		</section>
	</article>

	<script is:inline>
		const shareTitle = 'THE ARTHUR HOLLANDS SHOW | アーサーホーランド公式YouTubeチャンネル THE ARTHUR HOLLANDS SHOW';
		const shareText = '毎週水曜14:00から届けられてきた生配信番組のアーカイブ。';
		const shareUrl = 'https://arthur-show.com/arthur-hollands-show/';
		const searchInput = document.querySelector('[data-show-search]');
		const episodeCards = Array.from(document.querySelectorAll('[data-show-list] .episode-card'));
		const yearButtons = Array.from(document.querySelectorAll('[data-show-year]'));
		const yearBlocks = Array.from(document.querySelectorAll('[data-year-block]'));
		const noResults = document.querySelector('[data-show-no-results]');
		let activeYear = 'all';

		function updateShareLinks() {
			const encodedUrl = encodeURIComponent(shareUrl);
			const encodedText = encodeURIComponent(`${shareTitle}\n${shareText}`);
			const encodedLineText = encodeURIComponent(`${shareTitle}\n${shareText}\n${shareUrl}`);
			const line = document.querySelector('[data-share-line]');
			const x = document.querySelector('[data-share-x]');
			const facebook = document.querySelector('[data-share-facebook]');
			if (line) line.href = `https://line.me/R/msg/text/?${encodedLineText}`;
			if (x) x.href = `https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}`;
			if (facebook) facebook.href = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
		}

		async function copyShareLink() {
			const statusItems = document.querySelectorAll('[data-copy-status]');
			try {
				await navigator.clipboard.writeText(`${shareTitle}\n${shareText}\n${shareUrl}`);
				statusItems.forEach((item) => {
					item.textContent = 'コピーしました';
				});
				setTimeout(() => {
					statusItems.forEach((item) => {
						item.textContent = 'URLをクリップボードへ';
					});
				}, 1800);
			} catch {
				window.prompt('この内容をコピーしてください', `${shareTitle}\n${shareText}\n${shareUrl}`);
			}
		}

		async function sharePage() {
			if (navigator.share) {
				try {
					await navigator.share({ title: shareTitle, text: shareText, url: shareUrl });
					return;
				} catch (error) {
					if (error.name === 'AbortError') return;
				}
			}
			await copyShareLink();
		}

		function applyFilters() {
			const query = (searchInput?.value || '').trim().toLowerCase();
			let visible = 0;
			episodeCards.forEach((card) => {
				const yearOk = activeYear === 'all' || card.dataset.year === activeYear;
				const searchOk = !query || (card.dataset.search || '').includes(query);
				const show = yearOk && searchOk;
				card.hidden = !show;
				if (show) visible += 1;
			});
			yearBlocks.forEach((block) => {
				const cards = Array.from(block.querySelectorAll('.episode-card'));
				block.hidden = cards.every((card) => card.hidden);
			});
			if (noResults) noResults.hidden = visible !== 0;
		}

		yearButtons.forEach((button) => {
			button.addEventListener('click', (event) => {
				event.preventDefault();
				activeYear = button.dataset.showYear || 'all';
				yearButtons.forEach((item) => item.classList.toggle('active', item === button));
				applyFilters();
				document.querySelector('#episodes')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			});
		});
		searchInput?.addEventListener('input', applyFilters);
		document.querySelectorAll('[data-share-native]').forEach((button) => {
			button.addEventListener('click', sharePage);
		});
		document.querySelectorAll('[data-copy-link]').forEach((button) => {
			button.addEventListener('click', copyShareLink);
		});
		yearButtons[0]?.classList.add('active');
		updateShareLinks();
	</script>
</Layout>

<style>
	.show-page {
		--show-bg: #11100e;
		--show-panel: #1b1916;
		--show-gold: #c5a059;
		--show-red: #b63b32;
		background: var(--show-bg);
		color: #f7f0e4;
		margin: -22px 0 -80px;
		padding: 0 20px 90px;
	}

	.show-hero,
	.show-intro,
	.featured-broadcast,
	.share-section,
	.episode-section {
		max-width: 1180px;
		margin: 0 auto;
	}

	.show-hero {
		min-height: 70vh;
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
		gap: 40px;
		align-items: center;
		padding: 82px 0 54px;
		border-bottom: 1px solid rgba(197, 160, 89, 0.28);
	}

	.broadcast-label {
		color: var(--show-gold);
		font-family: var(--font-head);
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.18em;
	}

	.hero-copy h1 {
		margin-top: 10px;
		font-family: var(--font-head);
		font-size: clamp(3.55rem, 7vw, 7.2rem);
		font-weight: 900;
		letter-spacing: 0.01em;
		line-height: 0.86;
		overflow-wrap: anywhere;
	}

	.hero-lead {
		max-width: 620px;
		margin-top: 24px;
		color: rgba(247, 240, 228, 0.82);
		font-family: var(--font-serif);
		font-size: clamp(1.08rem, 2.1vw, 1.45rem);
		font-weight: 700;
		line-height: 1.8;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 28px;
	}

	.hero-actions a,
	.featured-body a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0 18px;
		border: 1px solid rgba(197, 160, 89, 0.8);
		background: rgba(197, 160, 89, 0.12);
		color: #fff;
		font-family: var(--font-head);
		font-weight: 900;
		letter-spacing: 0.08em;
	}

	.hero-actions a:hover,
	.featured-body a:hover {
		background: var(--show-gold);
		color: #11100e;
	}

	.hero-screen {
		position: relative;
		padding: 16px;
		background: linear-gradient(145deg, #2b2925, #0a0a09);
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: 0 28px 80px rgba(0, 0, 0, 0.4);
	}

	.hero-screen::before {
		content: "";
		position: absolute;
		top: 14px;
		left: 18px;
		width: 10px;
		height: 10px;
		background: var(--show-red);
		border-radius: 50%;
		box-shadow: 18px 0 0 rgba(197, 160, 89, 0.9), 36px 0 0 rgba(255, 255, 255, 0.35);
	}

	.screen-frame {
		aspect-ratio: 16 / 9;
		margin-top: 22px;
		background: #000;
		border: 1px solid rgba(197, 160, 89, 0.34);
	}

	.screen-frame iframe {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}

	.screen-caption {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-top: 14px;
		color: rgba(247, 240, 228, 0.72);
		font-family: var(--font-head);
		font-size: 0.82rem;
		font-weight: 900;
		letter-spacing: 0.12em;
	}

	.screen-caption strong {
		color: #fff;
	}

	.show-intro {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(170px, 0.45fr));
		gap: 14px;
		padding-top: 34px;
	}

	.intro-card {
		padding: 24px;
		background: rgba(255, 255, 255, 0.055);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.intro-card p {
		color: var(--show-gold);
		font-family: var(--font-head);
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.16em;
	}

	.intro-card h2 {
		margin-top: 8px;
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 3vw, 2rem);
		line-height: 1.45;
	}

	.intro-card strong {
		display: block;
		margin-top: 8px;
		font-family: var(--font-head);
		font-size: clamp(3rem, 7vw, 5.4rem);
		line-height: 0.9;
	}

	.intro-card span {
		display: block;
		margin-top: 10px;
		color: rgba(247, 240, 228, 0.72);
	}

	.featured-broadcast {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 0.75fr);
		gap: 24px;
		align-items: stretch;
		margin-top: 44px;
		background: #f7f0e4;
		color: #11100e;
	}

	.featured-thumb {
		min-height: 280px;
		background: #000;
		overflow: hidden;
	}

	.featured-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.featured-body {
		padding: 28px 28px 28px 0;
		align-self: center;
	}

	.featured-body h2 {
		margin-top: 8px;
		font-size: clamp(1.4rem, 3.2vw, 2.3rem);
		line-height: 1.35;
	}

	.featured-body p:not(.broadcast-label) {
		margin-top: 14px;
		color: rgba(17, 16, 14, 0.74);
	}

	.featured-body a {
		margin-top: 20px;
		color: #11100e;
	}

	.share-section {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		margin-top: 28px;
		padding: 14px 0;
		border-top: 1px solid rgba(255, 255, 255, 0.14);
		border-bottom: 1px solid rgba(255, 255, 255, 0.14);
	}

	.share-section h2 {
		flex: 0 0 auto;
		color: rgba(247, 240, 228, 0.72);
		font-size: 0.86rem;
		font-weight: 900;
	}

	.share-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 8px;
	}

	.share-card {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 36px;
		padding: 0 12px;
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.14);
		font: inherit;
		font-size: 0.82rem;
		font-weight: 900;
		cursor: pointer;
	}

	.share-card small {
		display: none;
	}

	.share-card:hover {
		border-color: rgba(197, 160, 89, 0.74);
		background: rgba(197, 160, 89, 0.16);
	}

	.episode-section {
		padding-top: 58px;
	}

	.episode-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 18px;
		padding-bottom: 16px;
		border-bottom: 3px solid rgba(247, 240, 228, 0.86);
	}

	.episode-heading h2 {
		margin-top: 6px;
		font-family: var(--font-head);
		font-size: clamp(2.5rem, 7vw, 5.2rem);
		line-height: 0.9;
	}

	.episode-search {
		display: grid;
		gap: 6px;
		min-width: min(320px, 100%);
		color: rgba(247, 240, 228, 0.72);
		font-size: 0.78rem;
		font-weight: 900;
	}

	.episode-search input {
		width: 100%;
		min-height: 42px;
		padding: 0 12px;
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.18);
		font: inherit;
	}

	.year-nav {
		position: sticky;
		top: 142px;
		z-index: 8;
		display: flex;
		gap: 8px;
		margin: 0 -20px 30px;
		padding: 12px 20px;
		overflow-x: auto;
		background: rgba(17, 16, 14, 0.92);
		backdrop-filter: blur(12px);
		scrollbar-width: none;
	}

	.year-nav::-webkit-scrollbar {
		display: none;
	}

	.year-nav a {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		gap: 7px;
		min-height: 34px;
		padding: 0 14px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		color: rgba(247, 240, 228, 0.74);
		font-family: var(--font-head);
		font-weight: 900;
	}

	.year-nav a.active,
	.year-nav a:hover {
		color: #fff;
		border-color: rgba(197, 160, 89, 0.72);
		background: rgba(197, 160, 89, 0.14);
	}

	.year-nav small {
		color: var(--show-gold);
	}

	.year-block {
		margin-top: 38px;
		scroll-margin-top: 190px;
	}

	.year-title {
