<div class="site-save" data-site-save hidden>
	<button class="site-save-button" type="button" data-site-save-open aria-haspopup="dialog">
		<img src="/favicon-32x32.png" alt="" width="24" height="24" aria-hidden="true" />
		<span>スマホに保存</span>
	</button>
</div>

<div class="site-save-dialog" role="dialog" aria-modal="true" aria-labelledby="site-save-title" data-site-save-dialog hidden>
	<button class="site-save-backdrop" type="button" data-site-save-close aria-label="閉じる"></button>
	<div class="site-save-panel" tabindex="-1" data-site-save-panel>
		<button class="site-save-close" type="button" data-site-save-close aria-label="閉じる">×</button>
		<img class="site-save-icon" src="/apple-touch-icon.png" alt="" width="64" height="64" aria-hidden="true" />
		<p class="site-save-kicker">OFFICIAL SITE</p>
		<h2 id="site-save-title">公式サイトをスマホに保存</h2>
		<p class="site-save-copy">ホーム画面に置くと、次回からすぐ開けます。</p>

		<div class="site-save-steps site-save-steps-ios">
			<p class="site-save-device">iPhone / Safari</p>
			<ol>
				<li>共有ボタンを開く</li>
				<li>「ホーム画面に追加」を選ぶ</li>
				<li>右上の「追加」を押す</li>
			</ol>
		</div>

		<div class="site-save-steps site-save-steps-android">
			<p class="site-save-device">Android / Chrome</p>
			<ol>
				<li>メニューを開く</li>
				<li>「ホーム画面に追加」または「アプリをインストール」を選ぶ</li>
				<li>画面の案内に沿って追加する</li>
			</ol>
		</div>
	</div>
</div>

<script is:inline>
	(() => {
		const root = document.querySelector('[data-site-save]');
		const openButton = document.querySelector('[data-site-save-open]');
		const dialog = document.querySelector('[data-site-save-dialog]');
		const panel = document.querySelector('[data-site-save-panel]');
		const closeButtons = document.querySelectorAll('[data-site-save-close]');
		if (!root || !openButton || !dialog) return;

		const mobileQuery = window.matchMedia('(max-width: 820px)');
		const isStandalone = () =>
			window.matchMedia('(display-mode: standalone)').matches ||
			window.navigator.standalone === true;
		const syncVisibility = () => {
			root.hidden = !mobileQuery.matches || isStandalone();
		};

		let deferredInstallPrompt = null;
		const userAgent = window.navigator.userAgent.toLowerCase();
		const isIOS =
			/iphone|ipad|ipod/.test(userAgent) ||
			(window.navigator.platform === 'MacIntel' && window.navigator.maxTouchPoints > 1);
		const isAndroid = /android/.test(userAgent);
		dialog.setAttribute('data-platform', isIOS ? 'ios' : isAndroid ? 'android' : 'other');

		window.addEventListener('beforeinstallprompt', (event) => {
			event.preventDefault();
			deferredInstallPrompt = event;
			root.setAttribute('data-install-ready', 'true');
		});

		window.addEventListener('appinstalled', () => {
			deferredInstallPrompt = null;
			root.hidden = true;
			closeDialog(false);
		});

		function openDialog() {
			dialog.hidden = false;
			document.body.classList.add('site-save-open');
			requestAnimationFrame(() => panel?.focus());
		}

		function closeDialog(restoreFocus = true) {
			dialog.hidden = true;
			document.body.classList.remove('site-save-open');
			if (restoreFocus) openButton.focus();
		}

		openButton.addEventListener('click', async () => {
			if (deferredInstallPrompt) {
				const installPrompt = deferredInstallPrompt;
				deferredInstallPrompt = null;
				root.removeAttribute('data-install-ready');
				const promptResult = await installPrompt.prompt().catch(() => null);
				const choice =
					promptResult ||
					(installPrompt.userChoice ? await installPrompt.userChoice.catch(() => null) : null);
				if (choice?.outcome === 'accepted') {
					root.hidden = true;
					return;
				}
			}
			openDialog();
		});

		closeButtons.forEach((button) => {
			button.addEventListener('click', () => closeDialog());
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !dialog.hidden) closeDialog();
		});

		mobileQuery.addEventListener?.('change', syncVisibility);
		syncVisibility();
	})();
</script>

<style>
