	}
	.site-save-dialog[data-platform="ios"] .site-save-steps-ios,
	.site-save-dialog[data-platform="android"] .site-save-steps-android,
	.site-save-dialog[data-platform="other"] .site-save-steps {
		display: block;
	}
	.site-save-device {
