	}
	.site-save-panel {
		position: relative;
		width: min(100%, 420px);
		margin: 0 auto;
		padding: 26px 20px 22px;
		color: #111;
		background: #fff;
		border: 1px solid rgba(197, 160, 89, 0.56);
		border-radius: 8px;
		box-shadow: 0 22px 52px rgba(0, 0, 0, 0.34);
		outline: 0;
	}
	.site-save-close {
		position: absolute;
		top: 10px;
		right: 10px;
		display: grid;
		place-items: center;
		width: 34px;
