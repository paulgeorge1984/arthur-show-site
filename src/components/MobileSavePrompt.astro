		font-weight: 900;
		line-height: 1.2;
	}
	.site-save-steps ol {
		display: grid;
		gap: 7px;
		padding-left: 1.25rem;
		color: #333;
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1.5;
	}
	:global(body.site-save-open) {
		overflow: hidden;
	}
	@media (min-width: 821px) {
		.site-save,
		.site-save-dialog {
			display: none !important;
		}
	}
</style>
