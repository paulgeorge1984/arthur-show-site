---
const { calendar = false } = Astro.props;
---
<section class:list={{ "nashi-calendar": calendar }} id="nashi-fes-20260919" aria-labelledby="nashi-fes-title">
  <div class="nashi-card">
    <div class="nashi-grid">
      <div class="nashi-poster">
        <a class="nashi-poster-link" href="/assets/nashi-fes-20260919.jpg" target="_blank" rel="noopener noreferrer">
          <img src="/assets/nashi-fes-20260919.jpg" width="905" height="1280" alt="第27回 梨フェス ～梨狩り＆BBQ～ ポスター" loading="lazy" decoding="async" />
        </a>
        <p class="nashi-poster-note">ポスターをクリックで原寸表示</p>
      </div>
      <div class="nashi-body">
        <p class="nashi-badge">新潟・燕市 秋の収穫祭</p>
        <h2 class="nashi-title" id="nashi-fes-title">第27回 梨フェス ～梨狩り＆BBQ～</h2>
        <p class="nashi-lead">梨の実りの季節に、畑で食べ、笑い、歌う一日を。梨狩りとBBQを囲んで、どなたも温かくお迎えします。</p>
        <dl class="nashi-meta">
          <div class="nashi-meta-row">
            <dt>日時</dt>
            <dd><time datetime="2026-09-19T10:30">2026年9月19日（土）10:30〜15:00</time></dd>
          </div>
          <div class="nashi-meta-row">
            <dt>会場</dt>
            <dd>小杉農園 新潟県燕市下児ノ木37</dd>
          </div>
          <div class="nashi-meta-row">
            <dt>出演</dt>
            <dd>Message アーサー・ホーランド ／ Music Samuell Soung（サムエル・ソング）</dd>
          </div>
        </dl>
        <div class="nashi-block">
          <h3 class="nashi-h3">参加費</h3>
          <ul class="nashi-fee">
            <li><span>大人</span><strong>2,500円</strong></li>
            <li><span>中・高校生</span><strong>1,000円</strong></li>
            <li><span>小学生</span><strong>500円</strong></li>
          </ul>
        </div>
        <div class="nashi-block">
          <h3 class="nashi-h3">お楽しみ</h3>
          <p class="nashi-text">新米コシヒカリのおにぎり・豚汁・キッチンカー3台、梨食べ放題。自由参加の歌・ダンス・楽器（参加者募集中）。畑の恵みと音楽でにぎやかに過ごしましょう。</p>
        </div>
      </div>
    </div>
  </div>
<style>
#nashi-fes-20260919{box-sizing:border-box;max-width:1020px;width:100%;margin:0 auto;padding:20px 16px;font-family:"Hiragino Kaku Gothic ProN","Hiragino Sans",Meiryo,"Noto Sans JP",sans-serif;line-height:1.75;color:#f2efe6}
#nashi-fes-20260919 *,#nashi-fes-20260919 *::before,#nashi-fes-20260919 *::after{box-sizing:border-box;min-width:0;max-width:100%}
#nashi-fes-20260919 .nashi-card{background:#191919;border:1px solid #51452c;border-radius:0;overflow:hidden;box-shadow:0 18px 50px rgba(0,0,0,.35),inset 0 0 0 1px rgba(197,160,89,.08)}
#nashi-fes-20260919 .nashi-grid{display:grid;grid-template-columns:360px minmax(0,1fr);align-items:stretch}
#nashi-fes-20260919 .nashi-poster{background:#111111;padding:22px 20px 16px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:10px}
#nashi-fes-20260919 .nashi-poster-link{display:block;width:100%;line-height:0;border-radius:0;overflow:hidden;border:1px solid rgba(255,255,255,.28);background:#111111;text-decoration:none}
#nashi-fes-20260919 .nashi-poster-link img{display:block;width:100%;height:auto;aspect-ratio:905/1280;object-fit:contain;background:#111111}
#nashi-fes-20260919 .nashi-poster-note{margin:0;font-size:.78rem;color:#c9c3b5;opacity:.9;text-align:center;overflow-wrap:anywhere}
#nashi-fes-20260919 .nashi-body{padding:28px 28px 26px;background:linear-gradient(180deg,#20201e 0%,#191919 60%,#151515 100%)}
#nashi-fes-20260919 .nashi-badge{display:inline-block;margin:0 0 10px;padding:.25em .9em;font-size:.78rem;letter-spacing:.12em;border-radius:0;background:#26231c;color:#e8c780;border:1px solid #51452c}
#nashi-fes-20260919 .nashi-title{margin:0 0 10px;font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:clamp(1.4rem,2.4vw + 1rem,2rem);line-height:1.4;color:#e8c780;overflow-wrap:anywhere;word-break:break-word}
#nashi-fes-20260919 .nashi-lead{margin:0 0 16px;font-size:.96rem;color:#d7d2c7;overflow-wrap:anywhere}
#nashi-fes-20260919 .nashi-meta{margin:0 0 16px;padding:14px 16px;background:rgba(255,255,255,.04);border:1px solid #51452c;border-radius:0;display:grid;gap:8px}
#nashi-fes-20260919 .nashi-meta-row{display:grid;grid-template-columns:3.2em minmax(0,1fr);gap:10px;margin:0}
#nashi-fes-20260919 .nashi-meta dt{font-weight:700;font-size:.82rem;color:#c5a059;white-space:nowrap}
#nashi-fes-20260919 .nashi-meta dd{margin:0;font-size:.92rem;overflow-wrap:anywhere;word-break:break-word}
#nashi-fes-20260919 .nashi-block{margin:0 0 14px;padding-top:12px;border-top:1px dashed #51452c}
#nashi-fes-20260919 .nashi-h3{margin:0 0 8px;font-size:.9rem;letter-spacing:.14em;color:#c5a059}
#nashi-fes-20260919 .nashi-h3::before{content:"◆ ";color:#c5a059;font-size:.8em}
#nashi-fes-20260919 .nashi-fee{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
#nashi-fes-20260919 .nashi-fee li{display:flex;align-items:baseline;gap:8px;padding:6px 12px;background:#242424;border:1px solid #51452c;border-radius:0;font-size:.88rem;overflow-wrap:anywhere}
#nashi-fes-20260919 .nashi-fee strong{font-size:1rem;color:#e8c780}
#nashi-fes-20260919 .nashi-text{margin:0;font-size:.92rem;color:#d7d2c7;overflow-wrap:anywhere;word-break:break-word}
@media (max-width:860px){
#nashi-fes-20260919 .nashi-grid{grid-template-columns:minmax(0,1fr)}
#nashi-fes-20260919 .nashi-poster{padding:16px 16px 12px}
#nashi-fes-20260919 .nashi-poster-link{max-width:440px;margin:0 auto}
#nashi-fes-20260919 .nashi-body{padding:20px 18px 18px}
#nashi-fes-20260919 .nashi-meta-row{grid-template-columns:2.8em minmax(0,1fr)}
}
#nashi-fes-20260919.nashi-calendar{max-width:1120px;padding:0 20px 34px}
@media (max-width:640px){#nashi-fes-20260919.nashi-calendar{max-width:100%;padding-left:14px;padding-right:14px}}
</style>
</section>