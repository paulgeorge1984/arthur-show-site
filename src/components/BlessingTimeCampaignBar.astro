---
const eventPath = '/blessing-time-osaka2026/';
const isEventPage = Astro.url.pathname === eventPath;
---

{!isEventPage && (
	<aside class="blessing-global-push" aria-label="今週末の特別イベント" data-blessing-campaign-window>
		<a
			class="blessing-global-push-link"
			href={eventPath}
			data-blessing-campaign-link
			data-campaign-placement="sitewide"
		>
			<span class="blessing-global-push-urgent">今週土曜</span>
			<span class="blessing-global-push-copy">
				<strong>7/18 BLESSING TIME in OSAKA</strong>
				<small>15:00・大阪 OCCホール｜入場無料・予約不要</small>
			</span>
			<span class="blessing-global-push-action">詳細・地図を見る <span aria-hidden="true">→</span></span>
		</a>
	</aside>
)}

<script is:inline>
	(() => {
		const campaignEnd = new Date('2026-07-19T00:00:00+09:00').getTime();
		const active = Date.now() < campaignEnd;
		document.documentElement.classList.toggle('blessing-campaign-visible', active);

		function sendCampaignEvent(eventName, placement) {
			if (typeof window.gtag !== 'function') return;
			window.gtag('event', eventName, {
				campaign_name: 'blessing_time_osaka_2026',
				campaign_placement: placement,
			});
		}

		function initializeBlessingCampaign() {
			const campaignWindows = document.querySelectorAll('[data-blessing-campaign-window]');
			campaignWindows.forEach((element) => {
				element.hidden = !active;
			});

			const hasFixedCampaign = active && document.querySelector('.blessing-global-push');
			document.body.classList.toggle('blessing-campaign-active', Boolean(hasFixedCampaign));
			if (!active) return;

			const links = Array.from(document.querySelectorAll('[data-blessing-campaign-link]'));
			const viewedPlacements = new Set();
			links.forEach((link) => {
				const placement = link.dataset.campaignPlacement || 'unknown';
				if (!viewedPlacements.has(placement)) {
					viewedPlacements.add(placement);
					sendCampaignEvent('blessing_time_campaign_view', placement);
				}
				link.addEventListener('click', () => {
					sendCampaignEvent('blessing_time_campaign_click', placement);
				});
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initializeBlessingCampaign, { once: true });
		} else {
			initializeBlessingCampaign();
		}
	})();
</script>

<style>
	:global(html:not(.blessing-campaign-visible) [data-blessing-campaign-window]) {
		display: none !important;
	}

	.blessing-global-push[hidden] {
		display: none !important;
	}

	:global([data-blessing-campaign-window][hidden]) {
		display: none !important;
	}

	.blessing-global-push {
		position: relative;
		z-index: 88;
		width: min(1180px, calc(100% - 28px));
		margin: -10px auto 22px;
		color: #fff;
		background: linear-gradient(105deg, #8b1f16, #ce3b27 42%, #142f43 100%);
		border: 1px solid rgba(255, 255, 255, 0.34);
		border-left: 6px solid #f4d36f;
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.24);
	}

	.blessing-global-push-link {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 16px;
		min-height: 58px;
		padding: 8px 12px 8px 10px;
		color: inherit;
		text-decoration: none;
	}

	.blessing-global-push-link:hover,
	.blessing-global-push-link:focus-visible {
		background: rgba(255, 255, 255, 0.1);
		outline: 3px solid #f4d36f;
		outline-offset: 2px;
	}

	.blessing-global-push-urgent {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 34px;
		padding: 0 10px;
		color: #161006;
		background: #f4d36f;
		font: 900 0.78rem/1 var(--font-sans, 'Noto Sans JP', sans-serif);
		white-space: nowrap;
	}

	.blessing-global-push-copy {
		display: flex;
		align-items: baseline;
		gap: 12px;
		min-width: 0;
	}

	.blessing-global-push-copy strong {
		font: 900 clamp(1rem, 2.1vw, 1.35rem)/1.15 var(--font-head, 'Oswald', sans-serif);
		letter-spacing: 0.01em;
	}

	.blessing-global-push-copy small {
		color: rgba(255, 255, 255, 0.88);
		font: 900 0.78rem/1.35 var(--font-sans, 'Noto Sans JP', sans-serif);
	}

	.blessing-global-push-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 38px;
		padding: 0 14px;
		color: #111;
		background: #fff;
		font: 900 0.8rem/1 var(--font-sans, 'Noto Sans JP', sans-serif);
		white-space: nowrap;
	}

	:global(.global-quick-nav a.blessing-nav-item),
	:global(.global-section-nav a.blessing-nav-item) {
		color: #111;
		background: #f4d36f;
		border-color: rgba(255, 255, 255, 0.78);
		border-bottom-color: #fff;
		font-family: var(--font-sans, 'Noto Sans JP', sans-serif);
		font-weight: 900;
	}

	:global(.global-quick-nav a.blessing-nav-item:hover),
	:global(.global-quick-nav a.blessing-nav-item.active),
	:global(.global-section-nav a.blessing-nav-item:hover),
	:global(.global-section-nav a.blessing-nav-item.active) {
		color: #fff;
		background: #b42e1f;
		border-color: #f4d36f;
	}

	@media (max-width: 820px) {
		.blessing-global-push {
			position: fixed;
			inset: auto 0 0;
			z-index: 165;
			width: 100%;
			margin: 0;
			border: 0;
			border-top: 3px solid #f4d36f;
			box-shadow: 0 -10px 28px rgba(0, 0, 0, 0.34);
		}

		.blessing-global-push-link {
			grid-template-columns: auto minmax(0, 1fr) auto;
			gap: 8px;
			min-height: 68px;
			padding: 7px 9px max(7px, env(safe-area-inset-bottom));
		}

		.blessing-global-push-urgent {
			min-height: 30px;
			padding: 0 7px;
			font-size: 0.68rem;
		}

		.blessing-global-push-copy {
			display: grid;
			gap: 2px;
		}

		.blessing-global-push-copy strong {
			overflow: hidden;
			font-size: clamp(0.86rem, 3.6vw, 1rem);
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.blessing-global-push-copy small {
			overflow: hidden;
			font-size: 0.67rem;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.blessing-global-push-action {
			min-height: 42px;
			padding: 0 10px;
			font-size: 0.72rem;
		}

		.blessing-global-push-action span {
			display: none;
		}

		:global(body.blessing-campaign-active) {
			padding-bottom: calc(72px + env(safe-area-inset-bottom));
		}

		:global(body.blessing-campaign-active .site-save) {
			bottom: calc(82px + env(safe-area-inset-bottom)) !important;
		}
	}

	@media (max-width: 430px) {
		.blessing-global-push-action {
			max-width: 74px;
			padding: 0 7px;
			line-height: 1.2;
			text-align: center;
			white-space: normal;
		}
	}
</style>
