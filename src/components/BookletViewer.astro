---
import wordOfGodBooklet from '../data/word-of-god-booklet.json';
import dailyVerseVideos from '../data/daily-verse-videos.json';

const bibleBooks = [
	'創世記', '出エジプト記', 'レビ記', '民数記', '申命記', 'ヨシュア記', '士師記', 'ルツ記',
	'サムエル記 第一', 'サムエル記 第二', '列王記 第一', '列王記 第二', '歴代誌 第一', '歴代誌 第二',
	'エズラ記', 'ネヘミヤ記', 'エステル記', 'ヨブ記', '詩篇', '箴言', '伝道者の書', '雅歌',
	'イザヤ書', 'エレミヤ書', '哀歌', 'エゼキエル書', 'ダニエル書', 'ホセア書', 'ヨエル書', 'アモス書',
	'オバデヤ書', 'ヨナ書', 'ミカ書', 'ナホム書', 'ハバクク書', 'ゼパニヤ書', 'ハガイ書', 'ゼカリヤ書', 'マラキ書',
	'マタイの福音書', 'マルコの福音書', 'ルカの福音書', 'ヨハネの福音書', '使徒の働き',
	'ローマ人への手紙', 'コリント人への手紙 第一', 'コリント人への手紙 第二', 'ガラテヤ人への手紙',
	'エペソ人への手紙', 'ピリピ人への手紙', 'コロサイ人への手紙', 'テサロニケ人への手紙 第一',
	'テサロニケ人への手紙 第二', 'テモテへの手紙 第一', 'テモテへの手紙 第二', 'テトスへの手紙',
	'ピレモンへの手紙', 'ヘブル人への手紙', 'ヤコブの手紙', 'ペテロの手紙 第一', 'ペテロの手紙 第二',
	'ヨハネの手紙 第一', 'ヨハネの手紙 第二', 'ヨハネの手紙 第三', 'ユダの手紙', 'ヨハネの黙示録',
];

const bookletBookAliases: Record<string, string[]> = {
	'サムエル記 第一': ['サムエル記 第一', 'サムエル記上', 'サムエル記 上'],
	'サムエル記 第二': ['サムエル記 第二', 'サムエル記下', 'サムエル記 下'],
	'列王記 第一': ['列王記 第一', '列王記上', '列王記 上'],
	'列王記 第二': ['列王記 第二', '列王記下', '列王記 下'],
	'歴代誌 第一': ['歴代誌 第一', '歴代志上', '歴代誌上', '歴代誌 上'],
	'歴代誌 第二': ['歴代誌 第二', '歴代志下', '歴代誌下', '歴代誌 下'],
	'マタイの福音書': ['マタイの福音書', 'マタイによる福音書', 'マタイ福音書'],
	'マルコの福音書': ['マルコの福音書', 'マルコによる福音書', 'マルコ福音書'],
	'ルカの福音書': ['ルカの福音書', 'ルカによる福音書', 'ルカ福音書'],
	'ヨハネの福音書': ['ヨハネの福音書', 'ヨハネによる福音書', 'ヨハネ福音書'],
	'使徒の働き': ['使徒の働き', '使徒行伝', '使徒言行録'],
	'コリント人への手紙 第一': ['コリント人への手紙 第一', 'コリント人への第一の手紙', '第一コリント人への手紙', '第一コリント', 'コリント前書'],
	'コリント人への手紙 第二': ['コリント人への手紙 第二', 'コリント人への第二の手紙', '第二コリント人への手紙', '第二コリント', 'コリント後書'],
	'テサロニケ人への手紙 第一': ['テサロニケ人への手紙 第一', '第一テサロニケ人への手紙', 'テサロニケ前書'],
	'テサロニケ人への手紙 第二': ['テサロニケ人への手紙 第二', '第二テサロニケ人への手紙', 'テサロニケ後書'],
	'テモテへの手紙 第一': ['テモテへの手紙 第一', '第一テモテへの手紙', 'テモテ前書'],
	'テモテへの手紙 第二': ['テモテへの手紙 第二', '第二テモテへの手紙', 'テモテ後書'],
	'ペテロの手紙 第一': ['ペテロの手紙 第一', '第一ペテロの手紙', 'ペテロ前書'],
	'ペテロの手紙 第二': ['ペテロの手紙 第二', '第二ペテロの手紙', 'ペテロ後書'],
	'ヨハネの手紙 第一': ['ヨハネの手紙 第一', 'ヨハネの第一の手紙', '第一ヨハネの手紙', 'ヨハネ第一の手紙', 'ヨハネ第一書'],
	'ヨハネの手紙 第二': ['ヨハネの手紙 第二', 'ヨハネの第二の手紙', '第二ヨハネの手紙', 'ヨハネ第二の手紙', 'ヨハネ第二書'],
	'ヨハネの手紙 第三': ['ヨハネの手紙 第三', 'ヨハネの第三の手紙', '第三ヨハネの手紙', 'ヨハネ第三の手紙', 'ヨハネ第三書'],
};

const normalizeBookletText = (value = '') => value.replace(/[　\s]/g, '');
const bookletPages = wordOfGodBooklet.pages;
const bookletPageCount = bookletPages.length;
const dailyVerseVideosByPage = dailyVerseVideos.videosByPage || {};
const linkedDailyVideoCount = Object.values(dailyVerseVideosByPage).reduce((total, videos) => total + (Array.isArray(videos) ? videos.length : 0), 0);
const bookletBookIndex = bibleBooks.map((book) => {
	const aliases = (bookletBookAliases[book] || [book]).map(normalizeBookletText);
	const page = bookletPages.find((item) => {
		const corpus = normalizeBookletText(`${item.label || ''} ${(item.refs || []).join(' ')} ${item.text || ''}`);
		return aliases.some((alias) => corpus.includes(alias));
	});
	return { book, page: page?.page };
});
const oldBookletBooks = bookletBookIndex.slice(0, 39).filter((item) => item.page);
const newBookletBooks = bookletBookIndex.slice(39).filter((item) => item.page);
---

<section class="booklet-viewer" id="word-of-god-booklet" aria-labelledby="booklet-title">
	<div class="booklet-heading">
		<div>
			<p class="section-kicker">厳選 1000 VERSES</p>
			<h1 id="booklet-title">THE WORD OF GOD</h1>
			<p class="booklet-lead">2021年から2025年までのアーサー先生が集会やメッセージで映像の中で引用してきた聖句集。聖句の学びにお役立てください。</p>
		</div>
		<figure class="booklet-cover-card" aria-label="THE WORD OF GOD 表紙">
			<img src={bookletPages[0]?.image} alt="THE WORD OF GOD 表紙" loading="eager" />
			<figcaption>
				<span>{bookletPageCount} pages</span>
				<strong>VIEWER</strong>
			</figcaption>
		</figure>
	</div>
	<div class="booklet-controls">
		<label class="booklet-search">
			<span>冊子内検索</span>
			<input type="search" placeholder="聖句・言葉・巻名で検索" data-booklet-search />
			<small data-booklet-search-status>聖句や言葉を入れると該当ページへ移動します。</small>
		</label>
		<div class="booklet-pager" aria-label="冊子ページ送り">
			<button type="button" data-booklet-prev>PREV</button>
			<span data-booklet-page-label>1 / {bookletPageCount}</span>
			<button type="button" data-booklet-next>NEXT</button>
		</div>
	</div>
	<div class="booklet-shell">
		<aside class="booklet-book-nav" aria-label="聖書巻別索引">
			<div class="booklet-testament-tabs" role="tablist" aria-label="旧約・新約切り替え">
				<button type="button" role="tab" aria-selected="false" data-booklet-testament-tab="old">旧約聖書</button>
				<button type="button" class="active" role="tab" aria-selected="true" data-booklet-testament-tab="new">新約聖書</button>
			</div>
			<div class="booklet-book-group" data-booklet-testament-group="old" hidden>
				<h2>OLD TESTAMENT</h2>
				<div class="booklet-book-grid">
					{oldBookletBooks.map((item) => (
						<button type="button" data-booklet-book-page={item.page} title={`P.${item.page}へ移動`}>
							{item.book}
						</button>
					))}
				</div>
			</div>
			<div class="booklet-book-group" data-booklet-testament-group="new">
				<h2>NEW TESTAMENT</h2>
				<div class="booklet-book-grid">
					{newBookletBooks.map((item) => (
						<button type="button" data-booklet-book-page={item.page} title={`P.${item.page}へ移動`}>
							{item.book}
						</button>
					))}
				</div>
			</div>
		</aside>
		<article class="booklet-page" aria-live="polite">
			<div class="booklet-page-meta">
				<span data-booklet-page-number>P.1</span>
				<small>THE WORD OF GOD 1000 VERSES COLLECTION</small>
			</div>
			<div class="booklet-page-frame">
				<button class="booklet-turn booklet-turn-prev" type="button" aria-label="前のページ" data-booklet-prev-zone>PREV</button>
				<img
					src={bookletPages[0]?.image}
					alt="THE WORD OF GOD 1000 VERSES COLLECTION P.1"
					loading="eager"
					data-booklet-image
				/>
				<button class="booklet-turn booklet-turn-next" type="button" aria-label="次のページ" data-booklet-next-zone>NEXT</button>
			</div>
		</article>
	</div>
	<section class="booklet-related" aria-labelledby="booklet-related-title">
		<div class="booklet-related-heading">
			<div>
				<p class="section-kicker">THE DAILY WITH ARTHUR HOLLANDS</p>
				<h2 id="booklet-related-title">この聖句に関連するデイリーメッセージ</h2>
			</div>
			<p data-booklet-related-status>{linkedDailyVideoCount} videos linked</p>
		</div>
		<div class="booklet-related-grid" data-booklet-related-list></div>
		<p class="booklet-related-empty" data-booklet-related-empty>この聖句を解説した動画がここに表示されます。</p>
	</section>
</section>

<script type="application/json" data-booklet-pages set:html={JSON.stringify(bookletPages)}></script>
<script type="application/json" data-booklet-related-videos set:html={JSON.stringify(dailyVerseVideosByPage)}></script>
<script is:inline>
	const bookletPages = JSON.parse(document.querySelector('[data-booklet-pages]')?.textContent || '[]');
	const bookletRelatedVideos = JSON.parse(document.querySelector('[data-booklet-related-videos]')?.textContent || '{}');
	const bookletSearch = document.querySelector('[data-booklet-search]');
	const bookletImage = document.querySelector('[data-booklet-image]');
	const bookletSearchStatus = document.querySelector('[data-booklet-search-status]');
	const bookletPageLabel = document.querySelector('[data-booklet-page-label]');
	const bookletPageNumber = document.querySelector('[data-booklet-page-number]');
	const bookletPrev = document.querySelector('[data-booklet-prev]');
	const bookletNext = document.querySelector('[data-booklet-next]');
	const bookletPrevZone = document.querySelector('[data-booklet-prev-zone]');
	const bookletNextZone = document.querySelector('[data-booklet-next-zone]');
	const bookletFrame = document.querySelector('.booklet-page-frame');
	const bookletBookButtons = Array.from(document.querySelectorAll('[data-booklet-book-page]'));
	const bookletTestamentTabs = Array.from(document.querySelectorAll('[data-booklet-testament-tab]'));
	const bookletTestamentGroups = Array.from(document.querySelectorAll('[data-booklet-testament-group]'));
	const bookletRelatedList = document.querySelector('[data-booklet-related-list]');
	const bookletRelatedEmpty = document.querySelector('[data-booklet-related-empty]');
	const bookletRelatedStatus = document.querySelector('[data-booklet-related-status]');
	let currentBookletPage = 1;
	let bookletTouchStartX = 0;
	let bookletTouchStartY = 0;

	function normalizeBookletQuery(value) {
		return String(value || '').toLowerCase().replace(/\s+/g, '');
	}

	function pageMatchesQuery(page, normalizedQuery) {
		if (!normalizedQuery) return true;
		return normalizeBookletQuery(`${page.text || ''} ${(page.refs || []).join(' ')} ${page.label || ''}`).includes(normalizedQuery);
	}

	function setBookletTestament(testament) {
		bookletTestamentTabs.forEach((button) => {
			const isActive = button.dataset.bookletTestamentTab === testament;
			button.classList.toggle('active', isActive);
			button.setAttribute('aria-selected', String(isActive));
		});
		bookletTestamentGroups.forEach((group) => {
			group.hidden = group.dataset.bookletTestamentGroup !== testament;
		});
	}

	function syncBookletTestament(pageNumber) {
		const activeButton = bookletBookButtons
			.filter((button) => Number(button.dataset.bookletBookPage) <= pageNumber)
			.at(-1);
		const activeGroup = activeButton?.closest('[data-booklet-testament-group]')?.dataset.bookletTestamentGroup;
		if (activeGroup) setBookletTestament(activeGroup);
	}

	function formatBookletDuration(value) {
		const match = String(value || '').match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
		if (!match) return '';
		const hours = Number(match[1] || 0);
		const minutes = Number(match[2] || 0);
		const seconds = Number(match[3] || 0);
		if (hours) return `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
		return `${minutes}:${String(seconds).padStart(2, '0')}`;
	}

	function renderRelatedVideos(pageNumber) {
		const videos = bookletRelatedVideos[String(pageNumber)] || [];
		if (bookletRelatedStatus) {
			bookletRelatedStatus.textContent = videos.length ? `P.${pageNumber} / ${videos.length} videos` : `P.${pageNumber}`;
		}
		if (bookletRelatedEmpty) bookletRelatedEmpty.hidden = videos.length > 0;
		if (!bookletRelatedList) return;
		bookletRelatedList.innerHTML = '';
		videos.slice(0, 6).forEach((video) => {
			const card = document.createElement('a');
			card.className = 'booklet-related-card';
			card.href = video.url;
			card.target = '_blank';
			card.rel = 'noopener noreferrer';
			const thumb = document.createElement('span');
			thumb.className = 'booklet-related-thumb';
			const image = document.createElement('img');
			image.src = video.thumbnail;
			image.alt = '';
			image.loading = 'lazy';
			thumb.appendChild(image);
			const body = document.createElement('span');
			body.className = 'booklet-related-body';
			const meta = document.createElement('small');
			meta.textContent = `${video.confidence === 'exact' ? 'TITLE MATCH' : 'QUOTE MATCH'}${formatBookletDuration(video.duration) ? ` / ${formatBookletDuration(video.duration)}` : ''}`;
			const title = document.createElement('strong');
			title.textContent = video.title;
			const quote = document.createElement('em');
			quote.textContent = video.quote || 'THE DAILY with ARTHUR HOLLANDS';
			body.append(meta, title, quote);
			card.append(thumb, body);
			bookletRelatedList.appendChild(card);
		});
	}

	function renderBookletPage(pageNumber, query = '') {
		const page = bookletPages.find((item) => item.page === pageNumber) || bookletPages[0];
		if (!page) return;
		currentBookletPage = page.page;
		syncBookletTestament(page.page);
		if (bookletImage) {
			bookletImage.src = page.image;
			bookletImage.alt = `${page.label || 'THE WORD OF GOD'} P.${page.page}`;
			bookletImage.loading = page.page <= 2 ? 'eager' : 'lazy';
		}
		if (bookletPageLabel) bookletPageLabel.textContent = `${page.page} / ${bookletPages.length}`;
		if (bookletPageNumber) bookletPageNumber.textContent = `P.${page.page}`;
		if (bookletPrev) bookletPrev.disabled = page.page <= 1;
		if (bookletNext) bookletNext.disabled = page.page >= bookletPages.length;
		if (bookletPrevZone) bookletPrevZone.disabled = page.page <= 1;
		if (bookletNextZone) bookletNextZone.disabled = page.page >= bookletPages.length;
		const currentBookButton = bookletBookButtons
			.filter((button) => Number(button.dataset.bookletBookPage) <= page.page)
			.at(-1);
		bookletBookButtons.forEach((button) => {
			button.classList.toggle('active', button === currentBookButton);
		});
		renderRelatedVideos(page.page);
	}

	function turnBookletPage(direction) {
		const nextPage = Math.min(bookletPages.length, Math.max(1, currentBookletPage + direction));
		if (nextPage !== currentBookletPage) renderBookletPage(nextPage, bookletSearch?.value.trim() || '');
	}

	bookletSearch?.addEventListener('input', () => {
		const query = bookletSearch.value.trim();
		const firstMatch = query
			? bookletPages.find((page) => pageMatchesQuery(page, normalizeBookletQuery(query)))
			: bookletPages[0];
		if (firstMatch) {
			renderBookletPage(firstMatch.page, query);
			if (bookletSearchStatus) bookletSearchStatus.textContent = query ? `P.${firstMatch.page}へ移動しました。` : '聖句や言葉を入れると該当ページへ移動します。';
		} else if (bookletSearchStatus) {
			bookletSearchStatus.textContent = '該当するページがありません。';
		}
	});
	bookletPrev?.addEventListener('click', () => turnBookletPage(-1));
	bookletNext?.addEventListener('click', () => turnBookletPage(1));
	bookletPrevZone?.addEventListener('click', () => turnBookletPage(-1));
	bookletNextZone?.addEventListener('click', () => turnBookletPage(1));
	bookletFrame?.addEventListener('touchstart', (event) => {
		const touch = event.touches[0];
		bookletTouchStartX = touch.clientX;
		bookletTouchStartY = touch.clientY;
	}, { passive: true });
	bookletFrame?.addEventListener('touchend', (event) => {
		const touch = event.changedTouches[0];
		const deltaX = touch.clientX - bookletTouchStartX;
		const deltaY = touch.clientY - bookletTouchStartY;
		if (Math.abs(deltaX) > 58 && Math.abs(deltaX) > Math.abs(deltaY) * 1.35) {
			turnBookletPage(deltaX < 0 ? 1 : -1);
		}
	}, { passive: true });
	document.addEventListener('keydown', (event) => {
		if (!document.querySelector('#word-of-god-booklet')?.matches(':hover')) return;
		if (event.key === 'ArrowLeft') turnBookletPage(-1);
		if (event.key === 'ArrowRight') turnBookletPage(1);
	});
	bookletTestamentTabs.forEach((button) => {
		button.addEventListener('click', () => setBookletTestament(button.dataset.bookletTestamentTab || 'old'));
	});
	bookletBookButtons.forEach((button) => {
		button.addEventListener('click', () => renderBookletPage(Number(button.dataset.bookletBookPage), bookletSearch?.value.trim() || ''));
	});
	setBookletTestament('new');
	const initialBookletPage = Number(new URLSearchParams(window.location.search).get('page') || 1);
	renderBookletPage(Number.isFinite(initialBookletPage) ? initialBookletPage : 1, '');
</script>

<style>
	.booklet-viewer {
		position: relative;
		z-index: 1;
		overflow: hidden;
		padding: 26px;
		background:
			radial-gradient(circle at 80% 4%, rgba(197, 160, 89, 0.2), transparent 34%),
			linear-gradient(110deg, rgba(197, 160, 89, 0.12) 0 1px, transparent 1px 17px),
			linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.015)),
			#080808;
		border: 1px solid rgba(197, 160, 89, 0.64);
		border-left: 8px solid #c5a059;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 32px 68px rgba(0, 0, 0, 0.38);
	}

	.booklet-viewer::before {
		content: "";
		position: absolute;
		top: 36px;
		right: -70px;
		width: min(54vw, 640px);
		height: 28px;
		background: linear-gradient(90deg, transparent 0 9%, #c5a059 9% 12%, #f7f2df 12% 82%, #7d6b42 82% 100%);
		clip-path: polygon(0 42%, 86% 42%, 100% 50%, 86% 58%, 0 58%);
		opacity: 0.58;
		pointer-events: none;
	}

	.booklet-heading {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
		margin-bottom: 20px;
		padding-bottom: 22px;
		border-bottom: 3px solid rgba(197, 160, 89, 0.72);
	}

	.section-kicker {
		color: #c5a059;
		font-family: 'Oswald', sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.booklet-heading h1 {
		color: #fff;
		font-family: 'Oswald', sans-serif;
		font-size: clamp(2.3rem, 6vw, 4.3rem);
		font-weight: 900;
		line-height: 0.95;
		text-shadow: 3px 3px 0 #000, 6px 6px 0 rgba(197, 160, 89, 0.34);
	}

	.booklet-lead {
		max-width: 700px;
		margin-top: 10px;
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.95rem;
		font-weight: 800;
		line-height: 1.8;
	}

	.booklet-cover-card {
		flex: 0 0 auto;
		width: min(24vw, 220px);
		margin: 0;
		padding: 10px;
		background: #111;
		border: 1px solid rgba(197, 160, 89, 0.58);
		box-shadow: 10px 10px 0 rgba(197, 160, 89, 0.2);
	}

	.booklet-cover-card img {
		display: block;
		width: 100%;
		aspect-ratio: 0.72;
		object-fit: cover;
		object-position: center top;
		background: #fff;
	}

	.booklet-cover-card figcaption {
		display: flex;
		justify-content: space-between;
		gap: 10px;
		padding-top: 8px;
		color: #c5a059;
		font-family: 'Oswald', sans-serif;
		font-size: 0.82rem;
		font-weight: 900;
		letter-spacing: 0.08em;
	}

	.booklet-controls {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 12px;
		margin-bottom: 18px;
		padding: 14px;
		background: rgba(0, 0, 0, 0.34);
		border: 1px solid rgba(197, 160, 89, 0.28);
	}

	.booklet-search {
		display: grid;
		gap: 7px;
	}

	.booklet-search span {
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.78rem;
		font-weight: 900;
