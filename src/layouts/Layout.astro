---
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;

// URLとタイトルを定義
const siteTitle = "THE ARTHUR HOLLANDS SHOW";
const pageTitle = `${title} | ${siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, "https://arthur-show.com");
const socialImageURL = new URL("/og-image.jpg", canonicalURL); // サムネイル画像（あれば）
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
	if (href === '/') return currentPath === '/';
	return currentPath.startsWith(href);
};
const navItems = [
	{ href: "/#messages", label: "Arthur Hollands' Message", active: currentPath === "/" },
	{ href: "/arthur-hollands-show/", label: "THE ARTHUR HOLLANDS SHOW", active: isCurrent("/arthur-hollands-show/") },
	{ href: "/friday-night/", label: "FRIDAY NIGHT", active: isCurrent("/friday-night/") },
	{ href: "/walk-across/", label: "WALK ACROSS", active: isCurrent("/walk-across/") },
	{ href: "/walk-across-awaji2026/", label: "WALK ACROSS AWAJI 2026", active: isCurrent("/walk-across-awaji2026/") },
	{ href: "/walk-across-goto2026/", label: "GOTO ISLANDS 2026", active: isCurrent("/walk-across-goto2026/") },
	{ href: "/message-jukebox/", label: "BIBLE JUKEBOX", active: isCurrent("/message-jukebox/") },
	{ href: "/swords-of-words/", label: "THE SWORDS OF WORDS", active: isCurrent("/swords-of-words/") },
	{ href: "/1000-verses/", label: "厳選 1000 VERSES", active: isCurrent("/1000-verses/") },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description || "You are Loved. Walk the talk. Talk the walk."} />
		<meta name="viewport" content="width=device-width" />
		<meta name="format-detection" content="telephone=no">
		
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{pageTitle}</title>
		
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description || "Arthur Hollands Archive"} />
		<meta property="og:type" content="article" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:image" content={socialImageURL} />
		
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700;900&family=Oswald:wght@400;700&family=Shippori+Mincho:wght@500;700;800&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet">
	</head>
	<body>
		<header class="site-header">
			<div class="header-inner">
				<a href="/" class="logo">
					<span class="logo-main">THE ARTHUR HOLLANDS SHOW</span>
					<span class="logo-sub">You are Loved</span>
				</a>
			</div>
		</header>
		<div class="global-nav-shell" data-global-nav-shell>
			<nav class="global-quick-nav" aria-label="サイト内主要メニューショートカット">
				{navItems.map((item) => (
					<a href={item.href} class:list={{ active: item.active }}>{item.label}</a>
				))}
			</nav>
			<button class="global-menu-toggle" type="button" aria-expanded="false" aria-controls="global-section-nav" data-global-menu-toggle>
				<span class="menu-lines" aria-hidden="true">
					<i></i>
					<i></i>
					<i></i>
				</span>
				<strong>SITE MENU</strong>
			</button>
			<nav class="global-section-nav" id="global-section-nav" aria-label="サイト内主要メニュー" data-global-section-nav>
				{navItems.map((item) => (
					<a href={item.href} class:list={{ active: item.active }}>{item.label}</a>
				))}
			</nav>
		</div>

		<main>
			<slot />
		</main>

		<SiteFooter />
		<script is:inline>
			const globalMenuToggle = document.querySelector('[data-global-menu-toggle]');
			const globalNavShell = document.querySelector('[data-global-nav-shell]');
			const globalNav = document.querySelector('[data-global-section-nav]');
			function setGlobalMenu(open) {
				if (!globalMenuToggle || !globalNavShell || !globalNav) return;
				globalNavShell.classList.toggle('is-open', open);
				globalMenuToggle.setAttribute('aria-expanded', String(open));
			}
			globalMenuToggle?.addEventListener('click', () => {
				setGlobalMenu(!globalNavShell?.classList.contains('is-open'));
			});
			globalNav?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => setGlobalMenu(false));
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') setGlobalMenu(false);
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--color-black: #0a0a0a; --color-white: #ffffff; --color-gold: #c5a059;
		--font-head: 'Oswald', sans-serif; --font-serif: 'Shippori Mincho', serif;
		--font-sans: 'Noto Sans JP', sans-serif; --font-cursive: 'Great Vibes', cursive;
		--container-width: 900px;
	}
	*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
	html { font-size: 16px; scroll-behavior: smooth; }
	body { background-color: var(--color-white); color: var(--color-black); font-family: var(--font-sans); line-height: 1.8; display: flex; flex-direction: column; min-height: 100vh; }
	main { flex: 1; } a { color: inherit; text-decoration: none; transition: 0.2s; }
	.msg-tags { display: none !important; }
	
	.site-header { background: var(--color-black); color: var(--color-white); padding: 20px 0; position: sticky; top: 0; z-index: 100; border-bottom: 4px solid var(--color-gold); }
	.header-inner { max-width: var(--container-width); margin: 0 auto; padding: 0 20px; display: flex; align-items: center; justify-content: center; gap: 18px; }
	.logo { min-width: 0; text-align: center; display: flex; flex-direction: column; align-items: center; }
	.logo-main { font-family: var(--font-head); font-size: clamp(1.1rem, 6vw, 1.5rem); font-weight: 700; letter-spacing: 0.05em; line-height: 1; }
	.logo-sub { font-family: var(--font-cursive); font-size: 1.15rem; color: var(--color-gold); letter-spacing: 0.04em; margin-top: 5px; line-height: 1; }
	@media (max-width: 720px) { .header-inner { justify-content: center; } .logo-main { font-size: clamp(1rem, 6.4vw, 1.35rem); } }
	@media (max-width: 420px) { .logo-main { font-size: 0.98rem; } }

	.global-nav-shell {
		position: sticky;
		top: 85px;
		z-index: 90;
		width: 100%;
		margin: 0 0 22px;
		background: rgba(10, 10, 10, 0.96);
		border-bottom: 1px solid rgba(197, 160, 89, 0.72);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
		backdrop-filter: blur(12px);
	}
	.global-menu-toggle {
		display: none;
	}
	.global-quick-nav {
		display: none;
	}
	.global-section-nav {
		display: flex;
		justify-content: center;
		gap: 4px;
		width: 100%;
		padding: 10px 20px;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.global-section-nav::-webkit-scrollbar {
		display: none;
	}
	.global-quick-nav a,
	.global-section-nav a {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		min-height: 34px;
		padding: 0 14px;
		color: rgba(255, 255, 255, 0.78);
		border: 1px solid transparent;
		border-bottom: 2px solid transparent;
		font-family: var(--font-head);
		font-size: 0.82rem;
		font-weight: 900;
		letter-spacing: 0.04em;
		line-height: 1;
		text-align: center;
		white-space: nowrap;
	}
	.global-quick-nav a:hover,
	.global-quick-nav a.active,
	.global-section-nav a:hover,
	.global-section-nav a.active {
		color: #fff;
		border-color: rgba(197, 160, 89, 0.24);
		border-bottom-color: var(--color-gold);
		background: rgba(255, 255, 255, 0.06);
	}
	@media (max-width: 980px) {
		.global-nav-shell {
			position: sticky;
			top: 86px;
			margin: 0 0 18px;
			padding: 10px 14px;
		}
		.global-quick-nav {
			display: flex;
			gap: 4px;
			margin: 0 -4px 10px;
			padding: 0 4px 10px;
			overflow-x: auto;
			scrollbar-width: none;
			border-bottom: 1px solid rgba(197, 160, 89, 0.2);
		}
		.global-quick-nav::-webkit-scrollbar {
			display: none;
		}
		.global-quick-nav a {
			min-height: 34px;
			padding: 0 12px;
			background: rgba(255, 255, 255, 0.045);
			border-color: rgba(255, 255, 255, 0.06);
			font-size: 0.78rem;
		}
		.global-menu-toggle {
			display: inline-flex;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
			width: 100%;
			min-height: 42px;
			padding: 0 2px;
			color: #fff;
			background: transparent;
			border: 0;
			border-top: 1px solid rgba(197, 160, 89, 0.22);
			border-bottom: 1px solid rgba(197, 160, 89, 0.22);
			font: inherit;
			cursor: pointer;
		}
		.global-menu-toggle .menu-lines {
			position: relative;
			display: grid;
			gap: 6px;
			width: 34px;
			padding: 2px 0;
		}
		.global-menu-toggle .menu-lines i {
			display: block;
			width: 34px;
			height: 2px;
			background: linear-gradient(90deg, var(--color-gold), rgba(255, 255, 255, 0.78));
			transform-origin: center;
			transition: transform 0.18s ease, opacity 0.18s ease;
		}
		.global-nav-shell.is-open .global-menu-toggle .menu-lines i:nth-child(1) {
			transform: translateY(8px) rotate(36deg);
		}
		.global-nav-shell.is-open .global-menu-toggle .menu-lines i:nth-child(2) {
			opacity: 0;
		}
		.global-nav-shell.is-open .global-menu-toggle .menu-lines i:nth-child(3) {
			transform: translateY(-8px) rotate(-36deg);
		}
		.global-menu-toggle strong {
			font-family: var(--font-head);
			font-size: 0.86rem;
			font-weight: 900;
			letter-spacing: 0.18em;
			color: rgba(255, 255, 255, 0.86);
			white-space: nowrap;
		}
		.global-section-nav {
			display: none;
			grid-template-columns: 1fr;
			gap: 1px;
			margin-top: 10px;
			padding: 0;
			overflow: visible;
			background: rgba(255, 255, 255, 0.08);
		}
		.global-nav-shell.is-open .global-section-nav {
			display: grid;
		}
		.global-section-nav a {
			justify-content: flex-start;
			width: 100%;
			min-height: 42px;
			padding: 0 14px;
			background: rgba(10, 10, 10, 0.96);
			font-size: 0.86rem;
		}
	}

	.site-footer { background: var(--color-black); color: var(--color-white); padding: 60px 0 30px; margin-top: 80px; }
	.container { max-width: var(--container-width); margin: 0 auto; padding: 0 20px; }
	.footer-brand { text-align: center; margin-bottom: 60px; }
	.footer-logo { font-family: var(--font-head); font-size: 1.8rem; margin-bottom: 10px; }
	.footer-desc { font-family: var(--font-cursive); color: var(--color-gold); font-style: normal; font-size: 2.5rem; line-height: 1; font-weight: normal; }
	@media (max-width: 768px) { .footer-desc { font-size: 2rem; } }
	.footer-grid { display: grid; gap: 50px; }
	@media(min-width: 768px) { .footer-grid { grid-template-columns: 1.5fr 1fr; gap: 60px; } }
	.footer-col h5 { color: var(--color-gold); font-family: var(--font-head); margin-bottom: 25px; letter-spacing: 0.1em; font-size: 1.1rem; border-bottom: 1px solid #333; padding-bottom: 10px; }
	.prog-block { margin-bottom: 40px; }
	.prog-title { font-weight: bold; font-size: 1rem; margin-bottom: 5px; color: #fff; }
	.prog-time { display: inline-block; background: #333; color: #ccc; font-size: 0.75rem; padding: 2px 8px; border-radius: 4px; margin-bottom: 10px; }
	.prog-text { font-size: 0.9rem; color: #ccc; line-height: 1.8; }
	.social-block { margin-bottom: 40px; }
	.yt-btn { display: flex; align-items: center; justify-content: center; gap: 10px; background: transparent; border: 1px solid #fff; color: #fff; padding: 15px; text-align: center; font-weight: bold; transition: 0.3s; font-family: var(--font-head); letter-spacing: 0.05em; }
	.yt-btn:hover { background: var(--color-gold); border-color: var(--color-gold); color: #000; }
	.yt-icon { font-size: 1.2rem; }
	.bank-card { background: #1a1a1a; padding: 20px; border-radius: 6px; margin-bottom: 15px; border-left: 3px solid #333; text-align: left; }
	.bank-label { font-size: 0.75rem; color: #888; margin-bottom: 8px; font-weight: bold; display: block; }
	.bank-details { font-family: 'Noto Sans JP', sans-serif; color: #ddd; font-size: 0.95rem; line-height: 1.6; font-weight: 500; }
	.bank-row { display: block; width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.copyright { text-align: center; margin-top: 60px; padding-top: 20px; border-top: 1px solid #333; color: #666; font-size: 0.75rem; }
</style>
