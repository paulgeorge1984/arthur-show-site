---
import SiteFooter from '../components/SiteFooter.astro';
import LanguageMenu from '../components/LanguageMenu.astro';
import MobileSavePrompt from '../components/MobileSavePrompt.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import BlessingTimeCampaignBar from '../components/BlessingTimeCampaignBar.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	imageType?: string;
	ogType?: string;
	noindex?: boolean;
	canonicalPath?: string;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
	hideChrome?: boolean;
	appendSiteTitle?: boolean;
}

const {
	title,
	description,
	image = "/og-image.jpg",
	imageAlt,
	imageWidth = 1200,
	imageHeight = 675,
	imageType = "image/jpeg",
	ogType = "article",
	noindex = false,
	canonicalPath,
	structuredData,
	hideChrome = false,
	appendSiteTitle = true,
} = Astro.props;

// URLとタイトルを定義
const siteTitle = "THE ARTHUR HOLLANDS SHOW";
const appTitle = "Arthur Calendar";
const siteUrl = "https://arthur-show.com";
const pageTitle = !appendSiteTitle || title.includes(siteTitle) ? title : `${title} | ${siteTitle}`;
const fallbackDescription = "アーサーホーランド（アーサー・ホーランド / Arthur Hollands）のTHE ARTHUR HOLLANDS SHOW、THE DAILY、WALK ACROSS、イベント情報、聖書メッセージをまとめた動画アーカイブです。";
const metaDescription = description || fallbackDescription;
const canonicalURL = new URL(canonicalPath || Astro.url.pathname, siteUrl).href;
const socialImageURL = new URL(image, siteUrl).href;
const socialImageAlt = imageAlt || pageTitle;
const robotsContent = noindex
	? "noindex,nofollow,noarchive"
	: "index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1";
const baseStructuredData = [
	{
		"@context": "https://schema.org",
		"@type": "Person",
		"@id": `${siteUrl}/#arthur-hollands`,
		name: "アーサーホーランド",
		alternateName: ["アーサー・ホーランド", "Arthur Hollands", "不良牧師"],
		description:
			"アーサーホーランド（アーサー・ホーランド / Arthur Hollands）は、THE ARTHUR HOLLANDS SHOW、THE DAILY with ARTHUR HOLLANDS、WALK ACROSSで聖書、人生、愛、希望を語るメッセンジャーです。",
		url: siteUrl,
		image: `${siteUrl}/og-image.jpg`,
		mainEntityOfPage: { "@id": `${siteUrl}/#website` },
		jobTitle: "メッセンジャー",
		knowsAbout: [
			"聖書メッセージ",
			"THE ARTHUR HOLLANDS SHOW",
			"THE DAILY with ARTHUR HOLLANDS",
			"WALK ACROSS",
			"You are Loved",
		],
		subjectOf: [
			{ "@id": `${siteUrl}/#website` },
			{ "@id": `${siteUrl}/#collection` },
		],
		sameAs: [
			"https://www.youtube.com/@arthurs-show",
			"https://www.arthurhollands.com/",
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"@id": `${siteUrl}/#website`,
		url: siteUrl,
		name: siteTitle,
		alternateName: [
			"アーサーホーランド公式動画アーカイブ",
			"アーサーホーランド動画アーカイブ",
			"アーサー・ホーランド公式動画アーカイブ",
			"Arthur Hollands Show Archive",
		],
		inLanguage: "ja-JP",
		description: fallbackDescription,
		publisher: { "@id": `${siteUrl}/#arthur-hollands` },
	},
];
const structuredDataList = [
	...baseStructuredData,
	...(Array.isArray(structuredData)
		? structuredData
		: structuredData
			? [structuredData]
			: []),
];
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
	if (href === '/') return currentPath === '/';
	return currentPath.startsWith(href);
};
const navItems = [
	{ href: "/blessing-time-osaka2026/", label: "今週土曜 7.18｜大阪・入場無料", active: isCurrent("/blessing-time-osaka2026/"), featured: true },
	{ href: "/#messages", label: "Arthur Hollands' Message", active: currentPath === "/" },
	{ href: "/walk-across-goto2026/", label: "GOTO ISLANDS 2026", active: isCurrent("/walk-across-goto2026/") },
	{ href: "/walk-across-sado2026/", label: "佐渡島十字架行進 2026", active: isCurrent("/walk-across-sado2026/") },
	{ href: "/the-lords-angels/", label: "The Lord's Angels", active: isCurrent("/the-lords-angels/") },
	{ href: "/diviner/", label: "DIVINER", active: isCurrent("/diviner/") },
	{ href: "/arthur-hollands-show/", label: "THE ARTHUR HOLLANDS SHOW", active: isCurrent("/arthur-hollands-show/") },
	{ href: "/friday-night/", label: "FRIDAY NIGHT", active: isCurrent("/friday-night/") },
	{ href: "/walk-across/", label: "WALK ACROSS", active: isCurrent("/walk-across/") },
	{ href: "/walk-across-awaji2026/", label: "WALK ACROSS AWAJI 2026", active: isCurrent("/walk-across-awaji2026/") },
	{ href: "/message-jukebox/", label: "BIBLE JUKEBOX", active: isCurrent("/message-jukebox/") },
	{ href: "/swords-of-words/", label: "THE SWORDS OF WORDS", active: isCurrent("/swords-of-words/") },
	{ href: "/1000-verses/", label: "厳選 1000 VERSES", active: isCurrent("/1000-verses/") },
	{ href: "/calendar/", label: "CALENDAR", active: isCurrent("/calendar/") },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription} />
		<meta name="keywords" content="アーサーホーランド, アーサー・ホーランド, Arthur Hollands, 不良牧師, THE ARTHUR HOLLANDS SHOW, THE DAILY with ARTHUR HOLLANDS, WALK ACROSS, WALK ACROSS GOTO ISLANDS 2026, 五島列島十字架行進2026, You are Loved, 聖書メッセージ" />
		<meta name="author" content="THE ARTHUR HOLLANDS SHOW" />
		<meta name="robots" content={robotsContent} />
		<meta name="googlebot" content={robotsContent} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="format-detection" content="telephone=no">
		<meta name="theme-color" content="#0a0a0a" />
		
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=20260613" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=20260613" />
		<link rel="shortcut icon" href="/favicon.ico?v=20260613" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260613" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="application-name" content={appTitle} />
		<meta name="apple-mobile-web-app-title" content={appTitle} />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<link rel="canonical" href={canonicalURL} />
		<title>{pageTitle}</title>
		
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:secure_url" content={socialImageURL} />
		<meta property="og:image:type" content={imageType} />
		<meta property="og:image:width" content={String(imageWidth)} />
		<meta property="og:image:height" content={String(imageHeight)} />
		<meta property="og:image:alt" content={socialImageAlt} />
		
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content={socialImageAlt} />
		<GoogleAnalytics />
		{structuredDataList.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700;900&family=Oswald:wght@400;700&family=Shippori+Mincho:wght@500;700;800&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet">
	</head>
	<body>
		{!hideChrome && (
			<>
				<header class="site-header">
					<div class="header-inner">
						<a href="/" class="logo">
							<span class="logo-main">THE ARTHUR HOLLANDS SHOW</span>
							<span class="logo-sub">You are Loved</span>
						</a>
						<LanguageMenu />
					</div>
				</header>
				<div class="global-nav-shell" data-global-nav-shell>
					<nav class="global-quick-nav" aria-label="サイト内主要メニューショートカット">
						{navItems.map((item) => (
							<a
								href={item.href}
								class:list={{ active: item.active, 'blessing-nav-item': item.featured }}
								data-blessing-campaign-link={item.featured}
								data-blessing-campaign-window={item.featured}
								data-campaign-placement={item.featured ? 'nav' : undefined}
							>
								{item.label}
							</a>
						))}
					</nav>
					<button class="global-menu-toggle" type="button" aria-expanded="false" aria-controls="global-section-nav" data-global-menu-toggle>
						<span class="menu-lines" aria-hidden="true">
							<i></i>
							<i></i>
							<i></i>
						</span>
						<strong>SITE MENU</strong>
					</button>
					<nav class="global-section-nav" id="global-section-nav" aria-label="サイト内主要メニュー" data-global-section-nav>
						{navItems.map((item) => (
							<a
								href={item.href}
								class:list={{ active: item.active, 'blessing-nav-item': item.featured }}
								data-blessing-campaign-link={item.featured}
								data-blessing-campaign-window={item.featured}
								data-campaign-placement={item.featured ? 'nav' : undefined}
							>
								{item.label}
							</a>
						))}
					</nav>
				</div>
				<BlessingTimeCampaignBar />
			</>
		)}

		<main>
			<slot />
		</main>

		{!hideChrome && <SiteFooter />}
		{!hideChrome && <MobileSavePrompt />}
		<script is:inline>
			const globalMenuToggle = document.querySelector('[data-global-menu-toggle]');
			const globalNavShell = document.querySelector('[data-global-nav-shell]');
			const globalNav = document.querySelector('[data-global-section-nav]');
			function setGlobalMenu(open) {
				if (!globalMenuToggle || !globalNavShell || !globalNav) return;
				globalNavShell.classList.toggle('is-open', open);
				globalMenuToggle.setAttribute('aria-expanded', String(open));
			}
			globalMenuToggle?.addEventListener('click', () => {
				setGlobalMenu(!globalNavShell?.classList.contains('is-open'));
			});
			globalNav?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => setGlobalMenu(false));
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') setGlobalMenu(false);
			});
		</script>
		<script is:inline>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(() => undefined);
				});
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--color-black: #0a0a0a; --color-white: #ffffff; --color-gold: #c5a059;
		--font-head: 'Oswald', sans-serif; --font-serif: 'Shippori Mincho', serif;
		--font-sans: 'Noto Sans JP', sans-serif; --font-cursive: 'Great Vibes', cursive;
		--container-width: 900px;
	}
	*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
	html { width: 100%; max-width: 100%; overflow-x: hidden; font-size: 16px; scroll-behavior: smooth; }
	body { position: relative; width: 100%; max-width: 100%; margin: 0 !important; overflow-x: hidden; background-color: var(--color-white); color: var(--color-black); font-family: var(--font-sans); line-height: 1.8; display: flex; flex-direction: column; min-height: 100vh; }
	main { flex: 1; min-width: 0; } a { color: inherit; text-decoration: none; transition: 0.2s; }
	img, svg, video, canvas, iframe { max-width: 100%; }
	header, main, footer, section, article, aside, nav, div { min-width: 0; }
	.msg-tags { display: none !important; }
	html.translated-ltr,
	html.translated-rtl {
		margin-top: 0 !important;
	}
	body.translated-ltr,
	body.translated-rtl {
		margin-top: 0 !important;
		top: 0 !important;
	}
	iframe#gt-nvframe,
	iframe.goog-te-banner-frame,
	iframe.skiptranslate,
	body > .skiptranslate,
	#goog-gt-tt,
	.goog-te-balloon-frame,
	.VIpgJd-ZVi9od-ORHb-OEVmcd {
		display: none !important;
		visibility: hidden !important;
		width: 0 !important;
		height: 0 !important;
		opacity: 0 !important;
		pointer-events: none !important;
	}
	.goog-text-highlight {
		background: transparent !important;
		box-shadow: none !important;
	}
	
	.site-header { background: var(--color-black); color: var(--color-white); padding: 20px 0; position: sticky; top: 0; z-index: 100; border-bottom: 4px solid var(--color-gold); }
	.header-inner { width: 100%; max-width: none; margin: 0 auto; padding: 0 clamp(18px, 4vw, 44px); display: grid; grid-template-columns: minmax(72px, 1fr) auto minmax(72px, 1fr); align-items: center; gap: 18px; }
	.logo { min-width: 0; text-align: center; display: flex; flex-direction: column; align-items: center; }
	.logo-main { font-family: var(--font-head); font-size: clamp(1.1rem, 6vw, 1.5rem); font-weight: 700; letter-spacing: 0.05em; line-height: 1; }
	.logo-sub { font-family: var(--font-cursive); font-size: 1.15rem; color: var(--color-gold); letter-spacing: 0.04em; margin-top: 5px; line-height: 1; }
	.translate-menu {
		position: relative;
		justify-self: end;
		width: 62px;
	}
	.translate-menu summary {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 62px;
		min-height: 42px;
		color: #fff;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(197, 160, 89, 0.56);
		font-family: var(--font-head);
		line-height: 1;
		text-align: center;
		list-style: none;
		cursor: pointer;
	}
	.translate-menu summary::-webkit-details-marker {
		display: none;
	}
	.translate-menu summary span {
		color: var(--color-gold);
		font-size: 0.9rem;
		font-weight: 900;
		letter-spacing: 0.04em;
	}
	.translate-menu summary small {
		margin-top: 4px;
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.62rem;
		font-weight: 900;
		letter-spacing: 0.02em;
	}
	.translate-menu summary:hover,
	.translate-menu[open] summary {
		background: var(--color-gold);
		color: #000;
	}
	.translate-menu summary:hover span,
	.translate-menu summary:hover small,
	.translate-menu[open] summary span,
	.translate-menu[open] summary small {
		color: #000;
	}
	.translate-list {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		z-index: 130;
		display: grid;
		grid-template-columns: repeat(2, minmax(128px, 1fr));
		width: min(360px, calc(100vw - 24px));
		max-height: min(70vh, 520px);
		overflow: auto;
		padding: 8px;
		background: rgba(10, 10, 10, 0.98);
		border: 1px solid rgba(197, 160, 89, 0.62);
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.24);
	}
	.translate-list a {
		display: flex;
		align-items: center;
		min-height: 34px;
		padding: 0 10px;
		color: rgba(255, 255, 255, 0.88);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		font-size: 0.82rem;
		font-weight: 900;
		line-height: 1.2;
		white-space: nowrap;
	}
	.translate-list a:hover {
		color: #000;
		background: var(--color-gold);
	}
	@media (max-width: 720px) { .header-inner { grid-template-columns: 56px minmax(0, 1fr) 56px; padding: 0 20px; gap: 8px; } .logo-main { font-size: clamp(1rem, 6.4vw, 1.35rem); } .translate-menu, .translate-menu summary { width: 52px; } .translate-menu summary { min-height: 38px; } .translate-menu summary span { font-size: 0.78rem; } .translate-menu summary small { display: none; } .translate-list { grid-template-columns: 1fr; width: min(230px, calc(100vw - 20px)); } }
	@media (max-width: 420px) { .logo-main { font-size: 0.9rem; } .logo-sub { font-size: 1rem; } }

	.global-nav-shell {
		position: sticky;
		top: 85px;
		z-index: 90;
		width: 100%;
		margin: 0 0 22px;
		background: rgba(10, 10, 10, 0.96);
		border-bottom: 1px solid rgba(197, 160, 89, 0.72);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
		backdrop-filter: blur(12px);
	}
	.global-menu-toggle {
		display: none;
	}
	.global-quick-nav {
		display: none;
	}
	.global-section-nav {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 4px 6px;
		width: 100%;
		max-width: 1240px;
		margin: 0 auto;
		padding: 10px clamp(14px, 2vw, 22px);
		overflow: visible;
	}
	.global-section-nav::-webkit-scrollbar {
		display: none;
	}
	.global-quick-nav a,
	.global-section-nav a {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		min-height: 32px;
		padding: 0 clamp(8px, 0.8vw, 12px);
		color: rgba(255, 255, 255, 0.78);
		border: 1px solid transparent;
		border-bottom: 2px solid transparent;
		font-family: var(--font-head);
		font-size: clamp(0.72rem, 0.8vw, 0.8rem);
		font-weight: 900;
		letter-spacing: 0.02em;
		line-height: 1;
		text-align: center;
		white-space: nowrap;
	}
	.global-quick-nav a:hover,
	.global-quick-nav a.active,
	.global-section-nav a:hover,
	.global-section-nav a.active {
		color: #fff;
		border-color: rgba(197, 160, 89, 0.24);
		border-bottom-color: var(--color-gold);
		background: rgba(255, 255, 255, 0.06);
	}
	@media (max-width: 980px) {
		.global-nav-shell {
			position: sticky;
			top: 86px;
			margin: 0 0 18px;
			padding: 10px 14px;
		}
		.global-quick-nav {
			display: flex;
			gap: 4px;
			margin: 0 -4px 10px;
			padding: 0 4px 10px;
			overflow-x: auto;
			scrollbar-width: none;
			border-bottom: 1px solid rgba(197, 160, 89, 0.2);
		}
		.global-quick-nav::-webkit-scrollbar {
			display: none;
		}
		.global-quick-nav a {
			min-height: 34px;
			padding: 0 12px;
			background: rgba(255, 255, 255, 0.045);
			border-color: rgba(255, 255, 255, 0.06);
			font-size: 0.78rem;
		}
		.global-menu-toggle {
			display: inline-flex;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
			width: 100%;
			min-height: 42px;
			padding: 0 2px;
			color: #fff;
			background: transparent;
			border: 0;
			border-top: 1px solid rgba(197, 160, 89, 0.22);
			border-bottom: 1px solid rgba(197, 160, 89, 0.22);
			font: inherit;
			cursor: pointer;
		}
		.global-menu-toggle .menu-lines {
			position: relative;
			display: grid;
			gap: 6px;
			width: 34px;
			padding: 2px 0;
		}
		.global-menu-toggle .menu-lines i {
			display: block;
			width: 34px;
			height: 2px;
			background: linear-gradient(90deg, var(--color-gold), rgba(255, 255, 255, 0.78));
			transform-origin: center;
			transition: transform 0.18s ease, opacity 0.18s ease;
		}
		.global-nav-shell.is-open .global-menu-toggle .menu-lines i:nth-child(1) {
			transform: translateY(8px) rotate(36deg);
		}
		.global-nav-shell.is-open .global-menu-toggle .menu-lines i:nth-child(2) {
			opacity: 0;
		}
		.global-nav-shell.is-open .global-menu-toggle .menu-lines i:nth-child(3) {
			transform: translateY(-8px) rotate(-36deg);
		}
		.global-menu-toggle strong {
			font-family: var(--font-head);
			font-size: 0.86rem;
			font-weight: 900;
			letter-spacing: 0.18em;
			color: rgba(255, 255, 255, 0.86);
			white-space: nowrap;
		}
		.global-section-nav {
			display: none;
			grid-template-columns: 1fr;
			gap: 1px;
			margin-top: 10px;
			padding: 0;
			overflow: visible;
			background: rgba(255, 255, 255, 0.08);
		}
		.global-nav-shell.is-open .global-section-nav {
			display: grid;
		}
		.global-section-nav a {
			justify-content: flex-start;
			width: 100%;
			min-height: 42px;
			padding: 0 14px;
			background: rgba(10, 10, 10, 0.96);
			font-size: 0.86rem;
		}
	}

	.site-footer { background: var(--color-black); color: var(--color-white); padding: 60px 0 30px; margin-top: 80px; }
	.container { max-width: var(--container-width); margin: 0 auto; padding: 0 20px; }
	.footer-brand { text-align: center; margin-bottom: 60px; }
